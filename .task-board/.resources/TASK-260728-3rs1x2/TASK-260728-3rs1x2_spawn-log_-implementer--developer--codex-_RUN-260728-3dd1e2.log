    68	final class SystemTunnelProcess: TunnelProcessHandle, @unchecked Sendable {
    69	  private let process = Process()
    70	  private let eventQueue = DispatchQueue(label: "works.relux.proxy.ssh-process-events")
    71	  private var errorPipe: Pipe?
    72	
    73	  var isRunning: Bool {
