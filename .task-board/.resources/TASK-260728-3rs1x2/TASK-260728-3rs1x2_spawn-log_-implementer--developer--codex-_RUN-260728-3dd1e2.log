    76	
    77	  @MainActor
    78	  func run(
    79	    executableURL: URL,
    80	    arguments: [String],
    81	    stderrHandler: @escaping @MainActor (String) -> Void,
    82	    terminationHandler: @escaping @MainActor (Int32) -> Void
    83	  ) throws {
    84	    let pipe = Pipe()
    85	
    86	    process.executableURL = executableURL
    87	    process.arguments = arguments
    88	    process.standardInput = FileHandle.nullDevice
    89	    process.standardOutput = FileHandle.nullDevice
    90	    process.standardError = pipe
    91	    errorPipe = pipe
    92	
    93	    pipe.fileHandleForReading.readabilityHandler = { [eventQueue] handle in
    94	      let data = handle.availableData
    95	      guard !data.isEmpty, let text = String(data: data, encoding: .utf8) else {
    96	        return
    97	      }
    98	      eventQueue.async {
    99	        Task { @MainActor in
   100	          stderrHandler(text)
   101	        }
   102	      }
   103	    }
   104	
   105	    process.terminationHandler = { [eventQueue, weak pipe] terminatedProcess in
   106	      eventQueue.async {
   107	        pipe?.fileHandleForReading.readabilityHandler = nil
   108	        let remainingData = pipe?.fileHandleForReading.readDataToEndOfFile() ?? Data()
   109	        let remainingText = String(data: remainingData, encoding: .utf8)
   110	
   111	        Task { @MainActor in
   112	          if let remainingText, !remainingText.isEmpty {
   113	            stderrHandler(remainingText)
   114	          }
   115	          terminationHandler(terminatedProcess.terminationStatus)
   116	        }
   117	      }
   118	    }
   119	
   120	    try process.run()
   121	  }
   122	
   123	  @MainActor
   124	  func terminate() {
   125	    guard process.isRunning else {
   126	      return
   127	    }
   128	    process.terminate()
   129	  }
   130	
   131	  @MainActor
   132	  func forceTerminate() {
   133	    guard process.isRunning, process.processIdentifier > 0 else {
   134	      return
   135	    }
   136	    kill(process.processIdentifier, SIGKILL)
   137	  }
   138	
   139	  @MainActor
   140	  func invalidateCallbacks() {
   141	    errorPipe?.fileHandleForReading.readabilityHandler = nil
   142	    process.terminationHandler = nil
   143	    errorPipe = nil
   144	  }
   145	}
   146	
   147	struct SystemLocalPortProbe: LocalPortProbing {
   148	  func isAvailable(_ port: Int) -> Bool {
   149	    withSocket(for: port) { descriptor, address in
   150	      var address = address
   151	      return withUnsafePointer(to: &address) { pointer in
   152	        pointer.withMemoryRebound(to: sockaddr.self, capacity: 1) { socketAddress in
   153	          Darwin.bind(
   154	            descriptor,
   155	            socketAddress,
   156	            socklen_t(MemoryLayout<sockaddr_in>.size)
   157	          ) == 0
   158	        }
   159	      }
   160	    }
   161	  }
   162	
   163	  func canConnect(_ port: Int) -> Bool {
   164	    withSocket(for: port) { descriptor, address in
   165	      var address = address
   166	      return withUnsafePointer(to: &address) { pointer in
   167	        pointer.withMemoryRebound(to: sockaddr.self, capacity: 1) { socketAddress in
   168	          Darwin.connect(
   169	            descriptor,
   170	            socketAddress,
   171	            socklen_t(MemoryLayout<sockaddr_in>.size)
   172	          ) == 0
   173	        }
   174	      }
   175	    }
   176	  }
   177	
   178	  private func withSocket(
   179	    for port: Int,
   180	    operation: (Int32, sockaddr_in) -> Bool
   181	  ) -> Bool {
   182	    let descriptor = socket(AF_INET, SOCK_STREAM, 0)
   183	    guard descriptor >= 0 else {
   184	      return false
   185	    }
   186	    defer { close(descriptor) }
   187	
   188	    var address = sockaddr_in()
   189	    address.sin_len = UInt8(MemoryLayout<sockaddr_in>.size)
   190	    address.sin_family = sa_family_t(AF_INET)
   191	    address.sin_port = in_port_t(UInt16(port).bigEndian)
   192	    address.sin_addr = in_addr(s_addr: inet_addr("127.0.0.1"))
   193	    return operation(descriptor, address)
   194	  }
   195	}
   196	
   197	final class PollingTunnelReadinessMonitor: TunnelReadinessMonitoring, @unchecked Sendable {
   198	  private let portProbe: LocalPortProbing
   199	  private let attempts: Int
   200	  private let interval: TimeInterval
   201	  private let queue: DispatchQueue
   202	
   203	  init(
   204	    portProbe: LocalPortProbing,
   205	    attempts: Int = 100,
   206	    interval: TimeInterval = 0.2,
   207	    queue: DispatchQueue = .global(qos: .utility)
   208	  ) {
   209	    self.portProbe = portProbe
   210	    self.attempts = attempts
   211	    self.interval = interval
   212	    self.queue = queue
   213	  }
   214	
   215	  @MainActor
   216	  func monitor(
   217	    process: TunnelProcessHandle,
   218	    port: Int,
   219	    completion: @escaping @MainActor (TunnelReadinessResult) -> Void
   220	  ) -> TunnelCancellation {
   221	    let cancellation = LockedTunnelCancellation()
   222	
   223	    queue.async { [attempts, interval, portProbe] in
   224	      for _ in 0..<attempts {
   225	        guard !cancellation.isCancelled else {
   226	          return
   227	        }
   228	        Thread.sleep(forTimeInterval: interval)
   229	        guard !cancellation.isCancelled, process.isRunning else {
   230	          return
   231	        }
   232	        if portProbe.canConnect(port) {
   233	          Task { @MainActor in
   234	            guard !cancellation.isCancelled else {
   235	              return
   236	            }
   237	            completion(.ready)
   238	          }
   239	          return
   240	        }
   241	      }
   242	
   243	      guard !cancellation.isCancelled, process.isRunning else {
   244	        return
   245	      }
   246	      Task { @MainActor in
   247	        guard !cancellation.isCancelled else {
   248	          return
   249	        }
   250	        completion(.timedOut)
   251	      }
   252	    }
   253	
   254	    return cancellation
   255	  }
   256	}
   257	
   258	struct DispatchTunnelScheduler: TunnelScheduling {
   259	  private let queue: DispatchQueue
   260	
   261	  init(queue: DispatchQueue = .global(qos: .utility)) {
   262	    self.queue = queue
   263	  }
   264	
   265	  @MainActor
   266	  func schedule(
   267	    after delay: TimeInterval,
   268	    action: @escaping @MainActor () -> Void
   269	  ) -> TunnelCancellation {
   270	    let workItem = DispatchWorkItem {
   271	      Task { @MainActor in
   272	        action()
   273	      }
   274	    }
   275	    queue.asyncAfter(deadline: .now() + delay, execute: workItem)
   276	    return WorkItemTunnelCancellation(workItem: workItem)
   277	  }
   278	}
   279	
   280	private final class LockedTunnelCancellation: TunnelCancellation, @unchecked Sendable {
   281	  private let lock = NSLock()
   282	  private var cancelled = false
   283	
   284	  var isCancelled: Bool {
   285	    lock.withLock { cancelled }
   286	  }
   287	
   288	  func cancel() {
   289	    lock.withLock {
   290	      cancelled = true
   291	    }
   292	  }
   293	}
   294	
   295	private final class WorkItemTunnelCancellation: TunnelCancellation, @unchecked Sendable {
   296	  private let workItem: DispatchWorkItem
   297	
   298	  init(workItem: DispatchWorkItem) {
   299	    self.workItem = workItem
   300	  }
   301	
   302	  func cancel() {
   303	    workItem.cancel()
   304	  }
   305	}

