     1	import Foundation
     2	
     3	enum SSHCommandBuilder {
     4	  static let executableURL = URL(fileURLWithPath: "/usr/bin/ssh")
     5	
     6	  static func arguments(for configuration: TunnelConfiguration) throws -> [String] {
     7	    if let error = configuration.validationError {
     8	      throw SSHCommandError.invalidConfiguration(error)
     9	    }
    10	
    11	    var arguments = [
    12	      "-N",
    13	      "-C",
    14	      "-D", configuration.localEndpoint,
    15	      "-o", "ExitOnForwardFailure=yes",
    16	      "-o", "ServerAliveInterval=30",
    17	      "-o", "ServerAliveCountMax=3",
    18	      "-o", "ConnectTimeout=15",
    19	      "-o", "BatchMode=yes",
    20	      "-o", "LogLevel=ERROR",
    21	    ]
    22	    if !configuration.normalizedAccount.isEmpty {
    23	      arguments.append(contentsOf: ["-l", configuration.normalizedAccount])
    24	    }
    25	    arguments.append(configuration.sshDestination)
    26	    return arguments
    27	  }
    28	}
    29	
    30	enum SSHCommandError: LocalizedError, Equatable {
    31	  case invalidConfiguration(String)
    32	
    33	  var errorDescription: String? {
    34	    switch self {
    35	    case .invalidConfiguration(let message):
    36	      return message
    37	    }
    38	  }
    39	}

