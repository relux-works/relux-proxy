   137	@MainActor
   138	@Observable
   139	final class TunnelController {
   140	  static let shared = TunnelController()
   141	
   142	  private static let maximumDiagnosticLength = 4_000
   143	  private static let stopGracePeriod: TimeInterval = 2
   144	
   145	  private(set) var profiles: [TunnelProfile]
   146	  let persistenceError: String?
   147	  let migrationDiagnostic: String?
   148	
   149	  @ObservationIgnored private let store: TunnelProfileStore
   150	  @ObservationIgnored private let processFactory: TunnelProcessFactory
   151	  @ObservationIgnored private let portProbe: LocalPortProbing
   152	  @ObservationIgnored private let readinessMonitor: TunnelReadinessMonitoring
   153	  @ObservationIgnored private let scheduler: TunnelScheduling
   154	  @ObservationIgnored private var sessions: [UUID: TunnelSession]
   155	  @ObservationIgnored private var isShuttingDown = false
   156	  @ObservationIgnored private var shutdownCompletions: [@MainActor () -> Void] = []
   157	
   158	  init(
   159	    store: TunnelProfileStore = TunnelProfileStore(),
   160	    processFactory: TunnelProcessFactory = SystemTunnelProcessFactory(),
   161	    portProbe: LocalPortProbing = SystemLocalPortProbe(),
   162	    readinessMonitor: TunnelReadinessMonitoring? = nil,
   163	    scheduler: TunnelScheduling = DispatchTunnelScheduler()
   164	  ) {
   165	    self.store = store
   166	    self.processFactory = processFactory
   167	    self.portProbe = portProbe
   168	    self.readinessMonitor =
   169	      readinessMonitor
   170	      ?? PollingTunnelReadinessMonitor(portProbe: portProbe)
   171	    self.scheduler = scheduler
   172	    profiles = store.profiles
   173	    persistenceError = store.blockingError
   174	    migrationDiagnostic = store.migrationDiagnostic
   175	    sessions = Dictionary(
   176	      uniqueKeysWithValues: store.profiles.map { profile in
   177	        (profile.id, TunnelSession(profileID: profile.id))
   178	      }
   179	    )
   180	  }
   181	
   182	  var aggregateStatus: TunnelAggregateStatus {
   183	    TunnelAggregateStatus.summarize(
   184	      profiles.compactMap { sessions[$0.id]?.status }
   185	    )
   186	  }
   187	
   188	  func session(for profileID: UUID) -> TunnelSession? {
   189	    sessions[profileID]
   190	  }
   191	
   192	  @discardableResult
   193	  func addProfile(host: String, account: String, localPort: Int) throws -> TunnelProfile {
   194	    let profile = try store.addProfile(host: host, account: account, localPort: localPort)
   195	    profiles = store.profiles
   196	    sessions[profile.id] = TunnelSession(profileID: profile.id)
   197	    return profile
   198	  }
   199	
   200	  @discardableResult
   201	  func updateProfile(_ profile: TunnelProfile) throws -> TunnelProfile {
   202	    try requireInactiveProfile(profile.id)
   203	    let updatedProfile = try store.updateProfile(profile)
   204	    profiles = store.profiles
   205	    return updatedProfile
   206	  }
   207	
   208	  func removeProfile(id: UUID) throws {
   209	    try requireInactiveProfile(id)
   210	    try store.removeProfile(id: id)
   211	    profiles = store.profiles
   212	    sessions.removeValue(forKey: id)
   213	  }
   214	
   215	  func connect(profileID: UUID) {
   216	    guard !isShuttingDown,
   217	      let profile = profiles.first(where: { $0.id == profileID }),
   218	      let session = sessions[profileID],
   219	      !session.isActive
   220	    else {
   221	      return
   222	    }
   223	
   224	    let configuration = profile.configuration
   225	    beginConnectionAttempt(session, configuration: configuration)
   226	    let generation = session.generation
   227	
   228	    do {
   229	      let arguments = try SSHCommandBuilder.arguments(for: configuration)
   230	
   231	      if sessions.values.contains(where: { otherSession in
   232	        otherSession.id != profileID
   233	          && otherSession.isActive
   234	          && otherSession.configurationSnapshot?.localPort == configuration.localPort
   235	      }) {
   236	        throw TunnelLaunchError.portReserved(configuration.localEndpoint)
   237	      }
   238	
   239	      guard portProbe.isAvailable(configuration.localPort) else {
   240	        throw TunnelLaunchError.localPortInUse(configuration.localEndpoint)
   241	      }
   242	
   243	      let process = processFactory.makeProcess()
   244	      session.process = process
   245	      try process.run(
   246	        executableURL: SSHCommandBuilder.executableURL,
   247	        arguments: arguments,
   248	        stderrHandler: { [weak self, weak process] text in
   249	          guard let process else {
   250	            return
   251	          }
   252	          self?.handleStderr(
   253	            text,
   254	            profileID: profileID,
   255	            generation: generation,
   256	            process: process
   257	          )
   258	        },
   259	        terminationHandler: { [weak self, weak process] exitStatus in
   260	          guard let process else {
   261	            return
   262	          }
   263	          self?.handleTermination(
   264	            exitStatus: exitStatus,
   265	            profileID: profileID,
   266	            generation: generation,
   267	            process: process
   268	          )
   269	        }
   270	      )
   271	
   272	      guard
   273	        currentSession(
   274	          profileID: profileID,
   275	          generation: generation,
   276	          process: process
   277	        ) != nil, process.isRunning
   278	      else {
   279	        return
   280	      }
   281	
   282	      session.readiness = readinessMonitor.monitor(
   283	        process: process,
   284	        port: configuration.localPort
   285	      ) { [weak self, weak process] result in
   286	        guard let process else {
   287	          return
   288	        }
   289	        self?.handleReadiness(
   290	          result,
   291	          profileID: profileID,
   292	          generation: generation,
   293	          process: process
   294	        )
   295	      }
   296	    } catch {
   297	      guard let current = sessions[profileID], current.generation == generation else {
   298	        return
   299	      }
   300	      recordStartFailure(error, in: current)
   301	    }
   302	  }
   303	
   304	  func disconnect(profileID: UUID) {
   305	    guard let session = sessions[profileID],
   306	      session.isActive,
   307	      session.status != .disconnecting,
   308	      !session.isCleaningUpFailedProcess
   309	    else {
   310	      return
   311	    }
   312	    guard let process = session.process else {
   313	      clearRuntime(session)
   314	      session.diagnostic = ""
   315	      session.status = .disconnected
   316	      finishShutdownIfPossible()
   317	      return
   318	    }
   319	
   320	    session.requestedStop = true
   321	    session.status = .disconnecting
   322	    session.readiness?.cancel()
   323	    session.readiness = nil
   324	    process.terminate()
   325	    scheduleForcedStop(
   326	      for: session,
   327	      process: process,
   328	      generation: session.generation
   329	    )
   330	  }
   331	
   332	  func shutdown(completion: @escaping @MainActor () -> Void = {}) {
   333	    shutdownCompletions.append(completion)
   334	    isShuttingDown = true
   335	
   336	    let activeProfileIDs = sessions.values
   337	      .filter(\.isActive)
   338	      .map(\.id)
   339	    for profileID in activeProfileIDs {
   340	      disconnect(profileID: profileID)
   341	    }
   342	    finishShutdownIfPossible()
   343	  }
   344	
   345	  private func requireInactiveProfile(_ profileID: UUID) throws {
   346	    guard profiles.contains(where: { $0.id == profileID }) else {
   347	      throw TunnelProfileError.profileNotFound(profileID)
   348	    }
   349	    if sessions[profileID]?.preventsProfileChanges == true {
   350	      throw TunnelProfileError.activeProfile(profileID)
   351	    }
   352	  }
   353	
   354	  private func beginConnectionAttempt(
   355	    _ session: TunnelSession,
   356	    configuration: TunnelConfiguration
   357	  ) {
   358	    session.generation &+= 1
   359	    session.status = .connecting
   360	    session.diagnostic = ""
   361	    session.isActive = true
   362	    session.configurationSnapshot = configuration
   363	    session.requestedStop = false
   364	    session.readiness?.cancel()
   365	    session.readiness = nil
   366	    session.forceStopAction?.cancel()
   367	    session.forceStopAction = nil
   368	    session.process?.invalidateCallbacks()
   369	    session.process = nil
   370	  }
   371	
   372	  private func handleStderr(
   373	    _ text: String,
   374	    profileID: UUID,
   375	    generation: UInt64,
   376	    process: TunnelProcessHandle
   377	  ) {
   378	    guard
   379	      let session = currentSession(
   380	        profileID: profileID,
   381	        generation: generation,
   382	        process: process
   383	      )
   384	    else {
   385	      return
   386	    }
   387	    appendDiagnostic(text, to: session)
   388	  }
   389	
   390	  private func handleReadiness(
   391	    _ result: TunnelReadinessResult,
   392	    profileID: UUID,
   393	    generation: UInt64,
   394	    process: TunnelProcessHandle
   395	  ) {
   396	    guard
   397	      let session = currentSession(
   398	        profileID: profileID,
   399	        generation: generation,
   400	        process: process
   401	      ), session.status == .connecting, !session.requestedStop, process.isRunning
   402	    else {
   403	      return
   404	    }
   405	
   406	    session.readiness?.cancel()
   407	    session.readiness = nil
   408	
   409	    switch result {
   410	    case .ready:
   411	      session.status = .connected
   412	    case .timedOut:
   413	      let endpoint = session.configurationSnapshot?.localEndpoint ?? "the local SOCKS endpoint"
   414	      let message = "Timed out waiting for \(endpoint) to accept connections."
   415	      appendDiagnostic(message, to: session)
   416	      session.status = .failed(message)
   417	      process.terminate()
   418	      scheduleForcedStop(for: session, process: process, generation: generation)
   419	    }
   420	  }
   421	
   422	  private func handleTermination(
   423	    exitStatus: Int32,
   424	    profileID: UUID,
   425	    generation: UInt64,
   426	    process: TunnelProcessHandle
   427	  ) {
   428	    guard
   429	      let session = currentSession(
   430	        profileID: profileID,
   431	        generation: generation,
   432	        process: process
   433	      )
   434	    else {
   435	      return
   436	    }
   437	
   438	    let stoppedByUser = session.requestedStop
   439	    let fallback = "SSH exited with status \(exitStatus)."
   440	    let summary = lastNonEmptyDiagnosticLine(in: session.diagnostic) ?? fallback
   441	    clearRuntime(session)
   442	
   443	    if stoppedByUser {
   444	      session.diagnostic = ""
   445	      session.status = .disconnected
   446	    } else {
   447	      if session.diagnostic.trimmingCharacters(in: .whitespacesAndNewlines).isEmpty {
   448	        session.diagnostic = fallback
   449	      }
   450	      session.status = .failed(summary)
   451	    }
   452	    finishShutdownIfPossible()
   453	  }
   454	
   455	  private func recordStartFailure(_ error: Error, in session: TunnelSession) {
   456	    let message = (error as? LocalizedError)?.errorDescription ?? error.localizedDescription
   457	    clearRuntime(session)
   458	    appendDiagnostic(message, to: session)
   459	    session.status = .failed(message)
   460	    finishShutdownIfPossible()
   461	  }
   462	
   463	  private func scheduleForcedStop(
   464	    for session: TunnelSession,
   465	    process: TunnelProcessHandle,
   466	    generation: UInt64
   467	  ) {
   468	    session.forceStopAction?.cancel()
   469	    session.forceStopAction = scheduler.schedule(after: Self.stopGracePeriod) {
   470	      guard
   471	        let current = self.currentSession(
   472	          profileID: session.id,
   473	          generation: generation,
   474	          process: process
   475	        ), current.isActive, process.isRunning
   476	      else {
   477	        return
   478	      }
   479	      process.forceTerminate()
   480	    }
   481	  }
   482	
   483	  private func currentSession(
   484	    profileID: UUID,
   485	    generation: UInt64,
   486	    process: TunnelProcessHandle
   487	  ) -> TunnelSession? {
   488	    guard let session = sessions[profileID],
   489	      session.generation == generation,
   490	      session.process === process
   491	    else {
   492	      return nil
   493	    }
   494	    return session
   495	  }
   496	
   497	  private func clearRuntime(_ session: TunnelSession) {
   498	    session.readiness?.cancel()
   499	    session.readiness = nil
   500	    session.forceStopAction?.cancel()
   501	    session.forceStopAction = nil
   502	    session.process?.invalidateCallbacks()
   503	    session.process = nil
   504	    session.configurationSnapshot = nil
   505	    session.requestedStop = false
   506	    session.isActive = false
   507	  }
   508	
   509	  private func appendDiagnostic(_ text: String, to session: TunnelSession) {
   510	    session.diagnostic += text
   511	    if session.diagnostic.count > Self.maximumDiagnosticLength {
   512	      session.diagnostic = String(
   513	        session.diagnostic.suffix(Self.maximumDiagnosticLength)
   514	      )
   515	    }
   516	  }
   517	
   518	  private func lastNonEmptyDiagnosticLine(in diagnostic: String) -> String? {
   519	    diagnostic
   520	      .split(whereSeparator: \Character.isNewline)
   521	      .map { line in
   522	        String(line).trimmingCharacters(in: .whitespacesAndNewlines)
   523	      }
   524	      .last(where: { !$0.isEmpty })
   525	  }
   526	
   527	  private func finishShutdownIfPossible() {
   528	    guard isShuttingDown, !sessions.values.contains(where: \.isActive) else {
   529	      return
   530	    }
   531	
   532	    let completions = shutdownCompletions
   533	    shutdownCompletions.removeAll()
   534	    for completion in completions {
   535	      completion()
   536	    }
   537	  }
   538	}
   539	
   540	private enum TunnelLaunchError: LocalizedError {
   541	  case portReserved(String)
   542	  case localPortInUse(String)
   543	
   544	  var errorDescription: String? {
   545	    switch self {
   546	    case .portReserved(let endpoint):
   547	      "Local endpoint \(endpoint) is already reserved by another Relux Proxy profile."
   548	    case .localPortInUse(let endpoint):
   549	      "Local endpoint \(endpoint) is already in use. Stop its owner or choose a different port."
   550	    }
   551	  }
   552	}

