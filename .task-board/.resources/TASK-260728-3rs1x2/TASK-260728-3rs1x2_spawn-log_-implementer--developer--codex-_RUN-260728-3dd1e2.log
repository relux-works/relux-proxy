     1	import Foundation
     2	
     3	struct TunnelConfiguration: Equatable {
     4	  let host: String
     5	  let account: String
     6	  let localPort: Int
     7	
     8	  var normalizedHost: String {
     9	    host.trimmingCharacters(in: .whitespacesAndNewlines)
    10	  }
    11	
    12	  var normalizedAccount: String {
    13	    account.trimmingCharacters(in: .whitespacesAndNewlines)
    14	  }
    15	
    16	  var target: String {
    17	    normalizedAccount.isEmpty
    18	      ? normalizedHost
    19	      : "\(normalizedAccount)@\(normalizedHost)"
    20	  }
    21	
    22	  var sshDestination: String {
    23	    normalizedHost
    24	  }
    25	
    26	  var localEndpoint: String {
    27	    "127.0.0.1:\(localPort)"
    28	  }
    29	
    30	  var validationError: String? {
    31	    if normalizedHost.isEmpty {
    32	      return "Enter an SSH host or an alias from ~/.ssh/config."
    33	    }
    34	    if normalizedHost.contains(where: \Character.isWhitespace) {
    35	      return "The SSH host cannot contain whitespace."
    36	    }
    37	    if normalizedHost.hasPrefix("-") {
    38	      return "The SSH host cannot begin with -."
    39	    }
    40	    if normalizedAccount.contains(where: \Character.isWhitespace)
    41	      || normalizedAccount.contains("@")
    42	    {
    43	      return "The SSH account must not contain whitespace or @."
    44	    }
    45	    if !(1...65_535).contains(localPort) {
    46	      return "The local port must be between 1 and 65535."
    47	    }
    48	    return nil
    49	  }
    50	}

