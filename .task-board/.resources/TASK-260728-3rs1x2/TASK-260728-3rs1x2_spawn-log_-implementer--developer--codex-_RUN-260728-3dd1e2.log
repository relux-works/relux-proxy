   541	private final class FakeReadinessMonitor: TunnelReadinessMonitoring, @unchecked Sendable {
   542	  struct Observation {
   543	    let process: TunnelProcessHandle
   544	    let port: Int
   545	    let completion: @MainActor (TunnelReadinessResult) -> Void
   546	    let cancellation: FakeCancellation
   547	  }
