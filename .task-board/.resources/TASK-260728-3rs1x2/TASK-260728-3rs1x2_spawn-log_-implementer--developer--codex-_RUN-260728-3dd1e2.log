     4	enum TunnelStatus: Equatable, Sendable {
     5	  case disconnected
     6	  case connecting
     7	  case connected
     8	  case disconnecting
     9	  case failed(String)
    10	
    11	  var title: String {
    12	    switch self {
    13	    case .disconnected: "Disconnected"
    14	    case .connecting: "Connecting…"
    15	    case .connected: "Connected"
    16	    case .disconnecting: "Disconnecting…"
    17	    case .failed: "Connection failed"
    18	    }
    19	  }
    20	
    21	  var symbolName: String {
    22	    switch self {
    23	    case .disconnected: "network.slash"
    24	    case .connecting, .disconnecting: "ellipsis.circle"
    25	    case .connected: "network"
    26	    case .failed: "exclamationmark.triangle"
    27	    }
    28	  }
    29	
    30	  var isTransitioning: Bool {
    31	    self == .connecting || self == .disconnecting
    32	  }
    33	
    34	  var failureMessage: String? {
    35	    guard case .failed(let message) = self else {
    36	      return nil
    37	    }
    38	    return message
    39	  }
    40	}
    41	
    42	struct TunnelAggregateStatus: Equatable {
    43	  let title: String
    44	  let symbolName: String
    45	
    46	  static func summarize(_ statuses: [TunnelStatus]) -> TunnelAggregateStatus {
    47	    let failedCount = statuses.count { status in
    48	      if case .failed = status {
    49	        return true
    50	      }
    51	      return false
    52	    }
    53	    let connectedCount = statuses.count { $0 == .connected }
    54	    let connectingCount = statuses.count { $0 == .connecting }
    55	    let disconnectingCount = statuses.count { $0 == .disconnecting }
    56	
    57	    if failedCount > 0 {
    58	      var parts: [String] = []
    59	      if connectedCount > 0 {
    60	        parts.append("\(connectedCount) connected")
    61	      }
    62	      if connectingCount > 0 {
    63	        parts.append("\(connectingCount) connecting")
    64	      }
    65	      if disconnectingCount > 0 {
    66	        parts.append("\(disconnectingCount) disconnecting")
    67	      }
    68	      parts.append(failedCount == 1 ? "1 failed" : "\(failedCount) failed")
    69	      return TunnelAggregateStatus(
    70	        title: parts.joined(separator: ", "),
    71	        symbolName: "exclamationmark.triangle"
    72	      )
    73	    }
    74	    if connectedCount > 0 {
    75	      var parts = [
    76	        connectedCount == 1
    77	          ? "1 tunnel connected"
    78	          : "\(connectedCount) tunnels connected"
    79	      ]
    80	      if connectingCount > 0 {
    81	        parts.append("\(connectingCount) connecting")
    82	      }
    83	      if disconnectingCount > 0 {
    84	        parts.append("\(disconnectingCount) disconnecting")
    85	      }
    86	      return TunnelAggregateStatus(
    87	        title: parts.joined(separator: ", "),
    88	        symbolName: "network"
    89	      )
    90	    }
    91	    if connectingCount > 0 {
    92	      let title =
    93	        connectingCount == 1
    94	        ? "1 tunnel connecting"
    95	        : "\(connectingCount) tunnels connecting"
    96	      return TunnelAggregateStatus(title: title, symbolName: "ellipsis.circle")
    97	    }
    98	    if disconnectingCount > 0 {
    99	      let title =
   100	        disconnectingCount == 1
   101	        ? "1 tunnel disconnecting"
   102	        : "\(disconnectingCount) tunnels disconnecting"
   103	      return TunnelAggregateStatus(title: title, symbolName: "ellipsis.circle")
   104	    }
   105	    return TunnelAggregateStatus(title: "No tunnels connected", symbolName: "network.slash")
   106	  }
   107	}
