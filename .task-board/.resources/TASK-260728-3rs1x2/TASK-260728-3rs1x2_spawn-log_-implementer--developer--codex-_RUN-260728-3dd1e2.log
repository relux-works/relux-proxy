   111	final class TunnelSession: Identifiable {
   112	  let id: UUID
   113	  fileprivate(set) var status: TunnelStatus = .disconnected
   114	  fileprivate(set) var diagnostic = ""
   115	  fileprivate(set) var isActive = false
   116	
   117	  @ObservationIgnored fileprivate var generation: UInt64 = 0
   118	  @ObservationIgnored fileprivate var process: TunnelProcessHandle?
   119	  @ObservationIgnored fileprivate var readiness: TunnelCancellation?
   120	  @ObservationIgnored fileprivate var forceStopAction: TunnelCancellation?
   121	  @ObservationIgnored fileprivate var configurationSnapshot: TunnelConfiguration?
   122	  @ObservationIgnored fileprivate var requestedStop = false
   123	
   124	  init(profileID: UUID) {
   125	    id = profileID
   126	  }
   127	
   128	  var preventsProfileChanges: Bool {
   129	    isActive
   130	  }
   131	
