   551	  func monitor(
   552	    process: TunnelProcessHandle,
   553	    port: Int,
   554	    completion: @escaping @MainActor (TunnelReadinessResult) -> Void
   555	  ) -> TunnelCancellation {
   556	    let cancellation = FakeCancellation()
   557	    observations.append(
   558	      Observation(
   559	        process: process,
   560	        port: port,
   561	        completion: completion,
   562	        cancellation: cancellation
   563	      )
   564	    )
