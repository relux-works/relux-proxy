   488	private final class FakeTunnelProcess: TunnelProcessHandle, @unchecked Sendable {
   489	  nonisolated(unsafe) private(set) var isRunning = false
   490	
   491	  @MainActor private(set) var executableURL: URL?
   492	  @MainActor private(set) var arguments: [String] = []
   493	  @MainActor private(set) var terminateCallCount = 0
   494	  @MainActor private(set) var forceTerminateCallCount = 0
   495	  @MainActor private(set) var invalidateCallCount = 0
   496	  @MainActor private var stderrHandlers: [@MainActor (String) -> Void] = []
   497	  @MainActor private var terminationHandlers: [@MainActor (Int32) -> Void] = []
   498	
   499	  @MainActor
   500	  func run(
   501	    executableURL: URL,
   502	    arguments: [String],
   503	    stderrHandler: @escaping @MainActor (String) -> Void,
   504	    terminationHandler: @escaping @MainActor (Int32) -> Void
   505	  ) throws {
   506	    self.executableURL = executableURL
   507	    self.arguments = arguments
   508	    stderrHandlers.append(stderrHandler)
   509	    terminationHandlers.append(terminationHandler)
   510	    isRunning = true
   511	  }
   512	
   513	  @MainActor
   514	  func terminate() {
   515	    terminateCallCount += 1
   516	  }
   517	
   518	  @MainActor
   519	  func forceTerminate() {
   520	    forceTerminateCallCount += 1
   521	  }
   522	
   523	  @MainActor
   524	  func invalidateCallbacks() {
   525	    invalidateCallCount += 1
   526	  }
   527	
   528	  @MainActor
   529	  func emitStderr(_ text: String, launch: Int = 0) {
   530	    stderrHandlers[launch](text)
   531	  }
   532	
   533	  @MainActor
   534	  func emitTermination(status: Int32, launch: Int = 0) {
   535	    isRunning = false
   536	    terminationHandlers[launch](status)
   537	  }
   538	}
