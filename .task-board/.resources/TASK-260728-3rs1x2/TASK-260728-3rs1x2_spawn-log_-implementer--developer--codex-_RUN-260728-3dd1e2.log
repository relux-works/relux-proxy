+      encoding: .utf8
+    )
+  }
+
+  private func normalizedWhitespace(_ text: String) -> String {
+    text.replacingOccurrences(
+      of: "\\s+",
+      with: " ",
+      options: .regularExpression
+    )
+  }
+}
