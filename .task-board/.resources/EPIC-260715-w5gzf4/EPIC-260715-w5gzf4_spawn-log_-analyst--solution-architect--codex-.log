/bin/zsh -lc "task-board m 'create(type=task, parent=STORY-260715-19mjyn, name=record-relay-release-input-and-reproducibility-contract, description=\"Define the authoritative source, dependency, toolchain, target, naming, normalization, reproducibility, manifest, SBOM, notice, scan, provenance, and exception rules for release relay assets.\"); create(type=task, parent=STORY-260715-19mjyn, name=pin-relay-release-build-environments-and-inputs, description=\"Turn the approved relay contract into immutable build inputs for every target, including source revisions, dependency locks, compiler and linker toolchains, SDK or sysroot identity, and hermetic fetch behavior.\"); create(type=task, parent=STORY-260715-19mjyn, name=build-four-relay-release-assets, description=\"Produce release-mode relux-relay executables for Linux x86_64, Linux arm64, macOS x86_64, and macOS arm64 from the pinned build environments with unique deterministic names and metadata.\"); create(type=task, parent=STORY-260715-19mjyn, name=verify-independent-relay-build-reproducibility, description=\"Rebuild every relay asset in two isolated environments, compare the bytes and intermediate metadata, and fail release on any unexplained difference.\"); create(type=task, parent=STORY-260715-19mjyn, name=generate-release-relay-manifest-and-checksums, description=\"Generate the canonical manifest and checksum files that bind every reproducible relay asset to protocol, platform, architecture, byte size, hash, build identity, source, dependencies, and toolchain inputs.\"); create(type=task, parent=STORY-260715-19mjyn, name=enforce-apple-bundle-relay-selection-and-integrity, description=\"Integrate the canonical relay manifest with generated Apple target resources so only declared assets are bundled and every copied byte is verified before archive signing.\"); create(type=task, parent=STORY-260715-19mjyn, name=generate-relay-dependency-sbom, description=\"Produce and validate a release SBOM for relux-relay and every compiled or bundled dependency, with source, version, checksum, license, supplier, relationship, and target coverage.\"); create(type=task, parent=STORY-260715-19mjyn, name=assemble-third-party-notices-and-license-evidence, description=\"Create the human-readable notice bundle and machine-checkable mapping for HEV, hev-task-system, hev-socks5-core, lwIP, the selected SSH engine, relay dependencies, and every other shipped third-party component.\"); create(type=task, parent=STORY-260715-19mjyn, name=enforce-relay-license-vulnerability-and-secret-policy, description=\"Scan exact relay source inputs, dependencies, SBOMs, notices, and release binaries against approved license, vulnerability, secret, hardening, and exception policies.\"); create(type=task, parent=STORY-260715-19mjyn, name=execute-relay-release-asset-validation-matrix, description=\"Validate the exact reproducible relay bytes across all target environments using protocol, hostile-input, stdio-boundary, resource, identity, self-hash, startup, and clean-exit checks.\"); create(type=task, parent=STORY-260715-19mjyn, name=produce-relay-provenance-and-release-staging-bundle, description=\"Assemble immutable relay assets, manifests, checksums, SBOMs, notices, scan results, conformance evidence, and provenance attestations into the exact input bundle consumed by Apple release workflows.\"); create(type=task, parent=STORY-260715-19mjyn, name=document-relay-update-rollback-and-incident-runbook, description=\"Create an operator runbook for updating relay inputs, rotating toolchains, regenerating evidence, promoting compatible assets, rolling back safely, revoking compromised material, and responding to vulnerabilities or provenance failures.\"); create(type=task, parent=STORY-260715-19mjyn, name=audit-relay-source-to-bundle-compliance-traceability, description=\"Perform an independent release-readiness audit that traces every staged and Apple-bundled relay byte back to approved source and toolchains and reconciles manifests, SBOMs, notices, scans, tests, and provenance.\")'" in /Users/iv/Developer/relux-proxy
