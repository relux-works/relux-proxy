   106	      }
   107	    } catch {
   108	      setBlockingError(
   109	        "Saved tunnel profiles could not be loaded: \(error.localizedDescription) "
   110	          + "The existing value was preserved; reset it explicitly before continuing."
   111	      )
   112	    }
   113	  }
   114	
   115	  private func initializeEmptyStore() {
   116	    do {
   117	      try writePayload([])
   118	      profiles = []
   119	    } catch {
   120	      setBlockingError(
   121	        "An empty tunnel profile store could not be created: \(error.localizedDescription)")
   122	    }
   123	  }
   124	
   125	  private func migrateLegacySettings() {
   126	    do {
   127	      let profile = TunnelProfile(
   128	        id: makeUUID(),
   129	        host: try legacyString(forKey: Self.legacyHostKey, defaultValue: Self.defaultHost),
   130	        account: try legacyString(
   131	          forKey: Self.legacyAccountKey,
   132	          defaultValue: Self.defaultAccount
   133	        ),
   134	        localPort: try legacyPort()
   135	      )
   136	      let normalizedProfiles = try TunnelProfileValidator.normalize([profile])
   137	      try writePayload(normalizedProfiles)
   138	      profiles = normalizedProfiles
   139	      defaults.set(true, forKey: Self.migrationCompleteKey)
   140	    } catch {
   141	      do {
   142	        try writePayload([])
   143	        profiles = []
   144	        migrationDiagnostic = Self.bounded(
   145	          "Legacy tunnel settings were not migrated: \(error.localizedDescription) "
   146	            + "Create a new profile manually."
   147	        )
   148	        defaults.set(true, forKey: Self.migrationCompleteKey)
   149	      } catch {
   150	        setBlockingError(
   151	          "Legacy tunnel settings could not be migrated and an empty profile store "
   152	            + "could not be created: \(error.localizedDescription)"
   153	        )
   154	      }
   155	    }
   156	  }
   157	
   158	  private func legacyString(forKey key: String, defaultValue: String) throws -> String {
   159	    guard let value = defaults.object(forKey: key) else {
   160	      return defaultValue
   161	    }
   162	    guard let string = value as? String else {
   163	      throw LegacyMigrationError.incompatibleType(key)
   164	    }
   165	    return string
   166	  }
   167	
   168	  private func legacyPort() throws -> Int {
   169	    guard let value = defaults.object(forKey: Self.legacyPortKey) else {
   170	      return Self.defaultPort
   171	    }
   172	    guard let port = value as? Int else {
   173	      throw LegacyMigrationError.incompatibleType(Self.legacyPortKey)
   174	    }
   175	    return port
   176	  }
   177	
   178	  private func persist(_ candidate: [TunnelProfile]) throws {
   179	    let normalized = try TunnelProfileValidator.normalize(candidate)
   180	    try writePayload(normalized)
   181	    profiles = normalized
   182	  }
   183	
   184	  private func writePayload(_ profiles: [TunnelProfile]) throws {
   185	    let data = try encoder.encode(TunnelProfilePayload(profiles: profiles))
   186	    defaults.set(data, forKey: Self.profilesKey)
   187	  }
   188	
   189	  private func requireWritableStore() throws {
   190	    if let blockingError {
   191	      throw TunnelProfileError.persistenceUnavailable(blockingError)
   192	    }
   193	  }
   194	
   195	  private func requireProfile(id: UUID) throws -> TunnelProfile {
   196	    guard let profile = profiles.first(where: { $0.id == id }) else {
   197	      throw TunnelProfileError.profileNotFound(id)
   198	    }
   199	    return profile
   200	  }
   201	
   202	  private var migrationIsComplete: Bool {
   203	    (defaults.object(forKey: Self.migrationCompleteKey) as? Bool) == true
   204	  }
   205	
   206	  private func setBlockingError(_ message: String) {
   207	    profiles = []
   208	    blockingError = Self.bounded(message)
   209	  }
   210	
   211	  private static func bounded(_ message: String) -> String {
   212	    guard message.count > maximumDiagnosticLength else {
   213	      return message
   214	    }
   215	    return String(message.suffix(maximumDiagnosticLength))
   216	  }
   217	}
