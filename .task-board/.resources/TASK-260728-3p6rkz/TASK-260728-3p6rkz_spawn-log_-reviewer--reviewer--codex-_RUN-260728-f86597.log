   262	@MainActor
   263	private final class ControllerFixture {
   264	  let suiteName: String
   265	  let defaults: UserDefaults
   266	  let processFactory = FakeTunnelProcessFactory()
   267	  let portProbe = FakeLocalPortProbe()
   268	  let readinessMonitor = FakeReadinessMonitor()
   269	  let scheduler = FakeTunnelScheduler()
   270	  let controller: TunnelController
   271	  let profiles: [TunnelProfile]
   272	
   273	  init(profiles specifications: [(host: String, port: Int)]) throws {
   274	    suiteName = "TunnelControllerTests.\(UUID().uuidString)"
   275	    defaults = UserDefaults(suiteName: suiteName)!
   276	    defaults.removePersistentDomain(forName: suiteName)
   277	    defaults.set(true, forKey: TunnelProfileStore.migrationCompleteKey)
   278	
   279	    let store = TunnelProfileStore(defaults: defaults)
   280	    var profiles: [TunnelProfile] = []
   281	    for specification in specifications {
   282	      profiles.append(
   283	        try store.addProfile(
   284	          host: specification.host,
   285	          account: "",
   286	          localPort: specification.port
   287	        )
   288	      )
   289	    }
   290	    self.profiles = profiles
   291	    controller = TunnelController(
   292	      store: store,
   293	      processFactory: processFactory,
   294	      portProbe: portProbe,
   295	      readinessMonitor: readinessMonitor,
   296	      scheduler: scheduler
   297	    )
   298	  }
   299	
   300	  func cleanup() {
