     6	@Suite
     7	struct LocalPortProbeTests {
     8	  @Test
     9	  func detectsAListenerAlreadyBoundToIPv4Loopback() throws {
    10	    let descriptor = socket(AF_INET, SOCK_STREAM, 0)
    11	    #expect(descriptor >= 0)
    12	    defer { close(descriptor) }
    13	
    14	    var address = sockaddr_in()
    15	    address.sin_len = UInt8(MemoryLayout<sockaddr_in>.size)
    16	    address.sin_family = sa_family_t(AF_INET)
    17	    address.sin_port = 0
    18	    address.sin_addr = in_addr(s_addr: inet_addr("127.0.0.1"))
    19	
    20	    let bindResult = withUnsafePointer(to: &address) { pointer in
    21	      pointer.withMemoryRebound(to: sockaddr.self, capacity: 1) { socketAddress in
    22	        Darwin.bind(
    23	          descriptor,
    24	          socketAddress,
    25	          socklen_t(MemoryLayout<sockaddr_in>.size)
    26	        )
    27	      }
    28	    }
    29	    #expect(bindResult == 0)
    30	    #expect(listen(descriptor, 1) == 0)
    31	
    32	    var boundAddress = sockaddr_in()
    33	    var boundLength = socklen_t(MemoryLayout<sockaddr_in>.size)
    34	    let nameResult = withUnsafeMutablePointer(to: &boundAddress) { pointer in
    35	      pointer.withMemoryRebound(to: sockaddr.self, capacity: 1) { socketAddress in
    36	        getsockname(descriptor, socketAddress, &boundLength)
    37	      }
    38	    }
    39	    #expect(nameResult == 0)
    40	    let port = Int(UInt16(bigEndian: boundAddress.sin_port))
    41	    let probe = SystemLocalPortProbe()
    42	
    43	    #expect(port > 0)
    44	    #expect(!probe.isAvailable(port))
    45	    #expect(probe.canConnect(port))
    46	  }
    47	}

