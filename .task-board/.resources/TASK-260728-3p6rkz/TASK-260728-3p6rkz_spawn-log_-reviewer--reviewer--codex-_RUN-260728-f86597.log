   349	  private func beginConnectionAttempt(
   350	    _ session: TunnelSession,
   351	    configuration: TunnelConfiguration
   352	  ) {
   353	    session.generation &+= 1
   354	    session.status = .connecting
   355	    session.diagnostic = ""
   356	    session.isActive = true
   357	    session.configurationSnapshot = configuration
   358	    session.requestedStop = false
   359	    session.readiness?.cancel()
   360	    session.readiness = nil
   361	    session.forceStopAction?.cancel()
   362	    session.forceStopAction = nil
   363	    session.process?.invalidateCallbacks()
   364	    session.process = nil
   365	  }
   366	
   367	  private func handleStderr(
   368	    _ text: String,
   369	    profileID: UUID,
   370	    generation: UInt64,
   371	    process: TunnelProcessHandle
   372	  ) {
   373	    guard
   374	      let session = currentSession(
   375	        profileID: profileID,
   376	        generation: generation,
   377	        process: process
   378	      )
   379	    else {
   380	      return
   381	    }
   382	    appendDiagnostic(text, to: session)
   383	  }
   384	
   385	  private func handleReadiness(
   386	    _ result: TunnelReadinessResult,
   387	    profileID: UUID,
   388	    generation: UInt64,
   389	    process: TunnelProcessHandle
   390	  ) {
   391	    guard
   392	      let session = currentSession(
   393	        profileID: profileID,
   394	        generation: generation,
   395	        process: process
   396	      ), session.status == .connecting, !session.requestedStop, process.isRunning
   397	    else {
   398	      return
   399	    }
   400	
   401	    session.readiness?.cancel()
   402	    session.readiness = nil
   403	
   404	    switch result {
   405	    case .ready:
   406	      session.status = .connected
   407	    case .timedOut:
   408	      let endpoint = session.configurationSnapshot?.localEndpoint ?? "the local SOCKS endpoint"
   409	      let message = "Timed out waiting for \(endpoint) to accept connections."
   410	      appendDiagnostic(message, to: session)
   411	      session.status = .failed(message)
   412	      process.terminate()
   413	      scheduleForcedStop(for: session, process: process, generation: generation)
   414	    }
   415	  }
   416	
   417	  private func handleTermination(
   418	    exitStatus: Int32,
   419	    profileID: UUID,
   420	    generation: UInt64,
   421	    process: TunnelProcessHandle
   422	  ) {
   423	    guard
   424	      let session = currentSession(
   425	        profileID: profileID,
   426	        generation: generation,
   427	        process: process
   428	      )
   429	    else {
   430	      return
   431	    }
   432	
   433	    let stoppedByUser = session.requestedStop
   434	    let fallback = "SSH exited with status \(exitStatus)."
   435	    let summary = lastNonEmptyDiagnosticLine(in: session.diagnostic) ?? fallback
   436	    clearRuntime(session)
   437	
   438	    if stoppedByUser {
   439	      session.diagnostic = ""
   440	      session.status = .disconnected
   441	    } else {
   442	      if session.diagnostic.trimmingCharacters(in: .whitespacesAndNewlines).isEmpty {
   443	        session.diagnostic = fallback
   444	      }
   445	      session.status = .failed(summary)
   446	    }
   447	    finishShutdownIfPossible()
   448	  }
   449	
   450	  private func recordStartFailure(_ error: Error, in session: TunnelSession) {
   451	    let message = (error as? LocalizedError)?.errorDescription ?? error.localizedDescription
   452	    clearRuntime(session)
   453	    appendDiagnostic(message, to: session)
   454	    session.status = .failed(message)
   455	    finishShutdownIfPossible()
   456	  }
   457	
   458	  private func scheduleForcedStop(
   459	    for session: TunnelSession,
   460	    process: TunnelProcessHandle,
   461	    generation: UInt64
   462	  ) {
   463	    session.forceStopAction?.cancel()
   464	    session.forceStopAction = scheduler.schedule(after: Self.stopGracePeriod) {
   465	      guard
   466	        let current = self.currentSession(
   467	          profileID: session.id,
   468	          generation: generation,
   469	          process: process
   470	        ), current.isActive, process.isRunning
   471	      else {
   472	        return
   473	      }
   474	      process.forceTerminate()
   475	    }
   476	  }
   477	
   478	  private func currentSession(
   479	    profileID: UUID,
   480	    generation: UInt64,
   481	    process: TunnelProcessHandle
   482	  ) -> TunnelSession? {
   483	    guard let session = sessions[profileID],
   484	      session.generation == generation,
   485	      session.process === process
   486	    else {
   487	      return nil
   488	    }
   489	    return session
   490	  }
   491	
   492	  private func clearRuntime(_ session: TunnelSession) {
   493	    session.readiness?.cancel()
   494	    session.readiness = nil
   495	    session.forceStopAction?.cancel()
   496	    session.forceStopAction = nil
   497	    session.process?.invalidateCallbacks()
   498	    session.process = nil
   499	    session.configurationSnapshot = nil
   500	    session.requestedStop = false
   501	    session.isActive = false
   502	  }
   503	
   504	  private func appendDiagnostic(_ text: String, to session: TunnelSession) {
   505	    session.diagnostic += text
   506	    if session.diagnostic.count > Self.maximumDiagnosticLength {
   507	      session.diagnostic = String(
   508	        session.diagnostic.suffix(Self.maximumDiagnosticLength)
   509	      )
   510	    }
   511	  }
   512	
   513	  private func lastNonEmptyDiagnosticLine(in diagnostic: String) -> String? {
   514	    diagnostic
   515	      .split(whereSeparator: \Character.isNewline)
   516	      .map { line in
   517	        String(line).trimmingCharacters(in: .whitespacesAndNewlines)
   518	      }
   519	      .last(where: { !$0.isEmpty })
   520	  }
   521	
   522	  private func finishShutdownIfPossible() {
   523	    guard isShuttingDown, !sessions.values.contains(where: \.isActive) else {
   524	      return
   525	    }
   526	
   527	    let completions = shutdownCompletions
   528	    shutdownCompletions.removeAll()
   529	    for completion in completions {
   530	      completion()
   531	    }
   532	  }
   533	}
   534	
   535	private enum TunnelLaunchError: LocalizedError {
   536	  case portReserved(String)
   537	  case localPortInUse(String)
   538	
   539	  var errorDescription: String? {
   540	    switch self {
   541	    case .portReserved(let endpoint):
   542	      "Local endpoint \(endpoint) is already reserved by another Relux Proxy profile."
   543	    case .localPortInUse(let endpoint):
   544	      "Local endpoint \(endpoint) is already in use. Stop its owner or choose a different port."
   545	    }
   546	  }
   547	}

