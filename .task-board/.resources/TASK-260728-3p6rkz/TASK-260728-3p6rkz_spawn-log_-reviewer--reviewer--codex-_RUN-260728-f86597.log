   305	private final class FakeLocalPortProbe: LocalPortProbing, @unchecked Sendable {
   306	  private let lock = NSLock()
   307	  private var unavailablePorts = Set<Int>()
   308	
   309	  func setUnavailable(_ ports: Set<Int>) {
   310	    lock.withLock {
   311	      unavailablePorts = ports
   312	    }
   313	  }
   314	
   315	  func isAvailable(_ port: Int) -> Bool {
   316	    lock.withLock {
   317	      !unavailablePorts.contains(port)
   318	    }
   319	  }
   320	
   321	  func canConnect(_ port: Int) -> Bool {
   322	    false
   323	  }
   324	}
   325	
   326	@MainActor
   327	private final class FakeTunnelProcessFactory: TunnelProcessFactory, @unchecked Sendable {
   328	  private(set) var processes: [FakeTunnelProcess] = []
   329	
   330	  func makeProcess() -> TunnelProcessHandle {
   331	    let process = FakeTunnelProcess()
   332	    processes.append(process)
   333	    return process
   334	  }
   335	}
   336	
   337	private final class FakeTunnelProcess: TunnelProcessHandle, @unchecked Sendable {
   338	  nonisolated(unsafe) private(set) var isRunning = false
   339	
   340	  @MainActor private(set) var executableURL: URL?
   341	  @MainActor private(set) var arguments: [String] = []
   342	  @MainActor private(set) var terminateCallCount = 0
   343	  @MainActor private(set) var forceTerminateCallCount = 0
   344	  @MainActor private(set) var invalidateCallCount = 0
   345	  @MainActor private var stderrHandlers: [@MainActor (String) -> Void] = []
   346	  @MainActor private var terminationHandlers: [@MainActor (Int32) -> Void] = []
   347	
   348	  @MainActor
   349	  func run(
   350	    executableURL: URL,
   351	    arguments: [String],
   352	    stderrHandler: @escaping @MainActor (String) -> Void,
   353	    terminationHandler: @escaping @MainActor (Int32) -> Void
   354	  ) throws {
   355	    self.executableURL = executableURL
   356	    self.arguments = arguments
   357	    stderrHandlers.append(stderrHandler)
   358	    terminationHandlers.append(terminationHandler)
   359	    isRunning = true
   360	  }
   361	
   362	  @MainActor
   363	  func terminate() {
   364	    terminateCallCount += 1
   365	  }
   366	
   367	  @MainActor
   368	  func forceTerminate() {
   369	    forceTerminateCallCount += 1
   370	  }
   371	
   372	  @MainActor
   373	  func invalidateCallbacks() {
   374	    invalidateCallCount += 1
   375	  }
   376	
   377	  @MainActor
   378	  func emitStderr(_ text: String, launch: Int = 0) {
   379	    stderrHandlers[launch](text)
   380	  }
   381	
   382	  @MainActor
   383	  func emitTermination(status: Int32, launch: Int = 0) {
   384	    isRunning = false
   385	    terminationHandlers[launch](status)
   386	  }
   387	}
   388	
   389	@MainActor
   390	private final class FakeReadinessMonitor: TunnelReadinessMonitoring, @unchecked Sendable {
   391	  struct Observation {
   392	    let process: TunnelProcessHandle
   393	    let port: Int
   394	    let completion: @MainActor (TunnelReadinessResult) -> Void
   395	    let cancellation: FakeCancellation
   396	  }
   397	
   398	  private(set) var observations: [Observation] = []
   399	
   400	  func monitor(
   401	    process: TunnelProcessHandle,
   402	    port: Int,
   403	    completion: @escaping @MainActor (TunnelReadinessResult) -> Void
   404	  ) -> TunnelCancellation {
   405	    let cancellation = FakeCancellation()
   406	    observations.append(
   407	      Observation(
   408	        process: process,
   409	        port: port,
   410	        completion: completion,
   411	        cancellation: cancellation
   412	      )
   413	    )
   414	    return cancellation
   415	  }
   416	
   417	  func send(_ result: TunnelReadinessResult, observation index: Int) {
   418	    observations[index].completion(result)
   419	  }
   420	}
   421	
   422	@MainActor
   423	private final class FakeTunnelScheduler: TunnelScheduling, @unchecked Sendable {
   424	  struct ScheduledAction {
   425	    let delay: TimeInterval
   426	    let action: @MainActor () -> Void
   427	    let cancellation: FakeCancellation
   428	  }
   429	
   430	  private(set) var actions: [ScheduledAction] = []
   431	
   432	  func schedule(
   433	    after delay: TimeInterval,
   434	    action: @escaping @MainActor () -> Void
   435	  ) -> TunnelCancellation {
   436	    let cancellation = FakeCancellation()
   437	    actions.append(
   438	      ScheduledAction(delay: delay, action: action, cancellation: cancellation)
   439	    )
   440	    return cancellation
   441	  }
   442	
   443	  func run(action index: Int) {
   444	    let scheduledAction = actions[index]
   445	    guard !scheduledAction.cancellation.isCancelled else {
   446	      return
   447	    }
   448	    scheduledAction.action()
   449	  }
   450	}
   451	
   452	private final class FakeCancellation: TunnelCancellation, @unchecked Sendable {
   453	  nonisolated(unsafe) private(set) var isCancelled = false
   454	
   455	  func cancel() {
   456	    isCancelled = true
   457	  }
   458	}

