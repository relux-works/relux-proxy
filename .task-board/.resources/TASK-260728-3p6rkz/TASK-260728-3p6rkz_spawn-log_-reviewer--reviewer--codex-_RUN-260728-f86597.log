   337	          TextField("1080", text: $localPortText)
   338	            .textFieldStyle(.roundedBorder)
   339	            .accessibilityLabel("Local SOCKS port")
   340	        }
   341	      }
   342	
   343	      Text("Leave Account empty to use OpenSSH configuration or its normal login-user default.")
   344	        .font(.caption)
   345	        .foregroundStyle(.secondary)
   346	
   347	      if let validationMessage {
   348	        MessageBanner(text: validationMessage, color: .red)
   349	      }
   350	
   351	      HStack {
   352	        Spacer()
   353	        Button("Cancel", role: .cancel) {
   354	          dismiss()
   355	        }
   356	        Button("Save") {
   357	          save()
   358	        }
   359	        .buttonStyle(.borderedProminent)
   360	        .keyboardShortcut(.defaultAction)
   361	      }
   362	    }
   363	    .padding(20)
   364	    .frame(width: 430)
   365	  }
   366	
   367	  private func save() {
   368	    guard let localPort = Int(localPortText) else {
   369	      validationMessage = "The local port must be a whole number between 1 and 65535."
   370	      return
   371	    }
   372	
   373	    do {
   374	      if let existingProfile = route.profile {
   375	        try controller.updateProfile(
   376	          TunnelProfile(
   377	            id: existingProfile.id,
   378	            host: host,
   379	            account: account,
   380	            localPort: localPort
   381	          )
   382	        )
   383	      } else {
   384	        try controller.addProfile(host: host, account: account, localPort: localPort)
   385	      }
   386	      dismiss()
   387	    } catch {
   388	      validationMessage = error.userFacingMessage
   389	    }
   390	  }
   391	}
