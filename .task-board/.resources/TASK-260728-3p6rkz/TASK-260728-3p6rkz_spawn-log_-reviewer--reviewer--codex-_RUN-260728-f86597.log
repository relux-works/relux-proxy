   327	            .accessibilityLabel("SSH host or OpenSSH alias")
   328	        }
   329	        GridRow {
   330	          Text("Account")
   331	          TextField("Optional account override", text: $account)
   332	            .textFieldStyle(.roundedBorder)
   333	            .accessibilityLabel("Optional SSH account override")
   334	        }
   335	        GridRow {
