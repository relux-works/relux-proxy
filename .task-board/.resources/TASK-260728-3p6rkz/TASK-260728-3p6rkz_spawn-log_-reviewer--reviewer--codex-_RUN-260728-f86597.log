    85	      loadExistingPayload(data)
    86	      return
    87	    }
    88	
    89	    if migrationIsComplete {
    90	      initializeEmptyStore()
    91	    } else {
    92	      migrateLegacySettings()
    93	    }
    94	  }
    95	
    96	  private func loadExistingPayload(_ data: Data) {
    97	    do {
    98	      let payload = try decoder.decode(TunnelProfilePayload.self, from: data)
