+
+    @Test
+    func deletedProfilesAreNotResurrectedFromLegacyKeys() throws {
+        let defaults = makeDefaults()
+        defer { clear(defaults) }
+
+        defaults.set("legacy-host", forKey: TunnelProfileStore.legacyHostKey)
