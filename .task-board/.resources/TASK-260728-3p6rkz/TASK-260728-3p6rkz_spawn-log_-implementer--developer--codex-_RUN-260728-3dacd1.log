diff --git a/Tests/ReluxProxyTests/TunnelControllerTests.swift b/Tests/ReluxProxyTests/TunnelControllerTests.swift
new file mode 100644
index 0000000000000000000000000000000000000000..2399e93b286b7ef0e083af1757ac89d16c682a6f
