diff --git a/Tests/ReluxProxyTests/TunnelControllerTests.swift b/Tests/ReluxProxyTests/TunnelControllerTests.swift
new file mode 100644
index 0000000000000000000000000000000000000000..0ebdda1622266ca768bfa6b2797737233ab3e782
--- /dev/null
+++ b/Tests/ReluxProxyTests/TunnelControllerTests.swift
@@ -0,0 +1,454 @@
+import Foundation
+import Testing
+@testable import ReluxProxy
+
+@MainActor
+@Suite
+struct TunnelControllerTests {
+    @Test
+    func aggregateStatusSummarizesZeroSomeAndFailedConnections() {
+        #expect(
+            TunnelAggregateStatus.summarize([]) ==
+                TunnelAggregateStatus(title: "No tunnels connected", symbolName: "network.slash")
+        )
+        #expect(
