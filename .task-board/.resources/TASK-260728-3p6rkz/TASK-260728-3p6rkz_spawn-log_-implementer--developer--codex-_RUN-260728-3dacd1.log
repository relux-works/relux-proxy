+private enum ProfileEditorRoute: Identifiable {
+    case add
+    case edit(TunnelProfile)
+
+    var id: String {
+        switch self {
+        case .add: "add"
+        case let .edit(profile): "edit-\(profile.id.uuidString)"
+        }
+    }
+
+    var profile: TunnelProfile? {
+        guard case let .edit(profile) = self else {
+            return nil
+        }
+        return profile
+    }
+}
