+
+    @Test
+    func readinessTimeoutAndCleanupRemainIsolated() throws {
+        let fixture = try ControllerFixture(
+            profiles: [
+                ("healthy", 4_080),
+                ("timeout", 4_081),
+            ]
+        )
+        defer { fixture.cleanup() }
