diff --git a/Sources/ReluxProxy/TunnelProfile.swift b/Sources/ReluxProxy/TunnelProfile.swift
new file mode 100644
index 0000000000000000000000000000000000000000..d5df77b7655124ad0a1802f6e3f462a7e7ba64c0
--- /dev/null
+++ b/Sources/ReluxProxy/TunnelProfile.swift
@@ -0,0 +1,91 @@
+import Foundation
+
+struct TunnelProfile: Codable, Identifiable, Equatable, Sendable {
+    let id: UUID
+    var host: String
+    var account: String
+    var localPort: Int
+
+    var configuration: TunnelConfiguration {
+        TunnelConfiguration(host: host, account: account, localPort: localPort)
+    }
+
+    var displayTarget: String {
+        configuration.target
+    }
+
+    func normalized() throws -> TunnelProfile {
+        let configuration = TunnelConfiguration(
+            host: host,
+            account: account,
+            localPort: localPort
+        )
+        if let validationError = configuration.validationError {
+            throw TunnelProfileError.invalidProfile(validationError)
+        }
+
+        return TunnelProfile(
+            id: id,
+            host: configuration.normalizedHost,
+            account: configuration.normalizedAccount,
+            localPort: localPort
+        )
+    }
+}
+
+struct TunnelProfilePayload: Codable, Equatable {
+    static let currentSchemaVersion = 1
+
+    let schemaVersion: Int
+    var profiles: [TunnelProfile]
+
+    init(profiles: [TunnelProfile]) {
+        schemaVersion = Self.currentSchemaVersion
+        self.profiles = profiles
+    }
+}
+
+enum TunnelProfileValidator {
+    static func normalize(_ profiles: [TunnelProfile]) throws -> [TunnelProfile] {
+        var profileIDs = Set<UUID>()
+        var localPorts = Set<Int>()
+
+        return try profiles.map { profile in
+            let normalized = try profile.normalized()
+
+            guard profileIDs.insert(normalized.id).inserted else {
+                throw TunnelProfileError.duplicateProfileID(normalized.id)
+            }
+            guard localPorts.insert(normalized.localPort).inserted else {
+                throw TunnelProfileError.duplicateLocalPort(normalized.localPort)
+            }
+            return normalized
+        }
+    }
+}
+
+enum TunnelProfileError: LocalizedError, Equatable {
+    case invalidProfile(String)
+    case duplicateProfileID(UUID)
+    case duplicateLocalPort(Int)
+    case profileNotFound(UUID)
+    case activeProfile(UUID)
+    case persistenceUnavailable(String)
+
+    var errorDescription: String? {
+        switch self {
+        case let .invalidProfile(message):
+            message
+        case let .duplicateProfileID(id):
+            "The saved profile identifier \(id.uuidString) is duplicated."
+        case let .duplicateLocalPort(port):
+            "Local SOCKS port \(port) is already assigned to another profile."
+        case .profileNotFound:
+            "The selected tunnel profile no longer exists."
+        case .activeProfile:
+            "Disconnect this tunnel before editing or removing its profile."
+        case let .persistenceUnavailable(message):
+            message
+        }
+    }
+}
diff --git a/Sources/ReluxProxy/TunnelProfileStore.swift b/Sources/ReluxProxy/TunnelProfileStore.swift
new file mode 100644
index 0000000000000000000000000000000000000000..c9db99f28f5fe6f03b59c04da3de08157f7e553d
--- /dev/null
+++ b/Sources/ReluxProxy/TunnelProfileStore.swift
@@ -0,0 +1,238 @@
+import Foundation
+
+final class TunnelProfileStore {
+    static let profilesKey = "legacySocksProfiles.v1"
+    static let migrationCompleteKey = "legacySocksProfiles.migration.v1.complete"
+
+    static let legacyHostKey = "sshHost"
+    static let legacyAccountKey = "sshAccount"
+    static let legacyPortKey = "localPort"
+
+    private static let defaultHost = "relux"
+    private static let defaultAccount = "administrator"
+    private static let defaultPort = 1_080
+    private static let maximumDiagnosticLength = 4_000
+
+    private let defaults: UserDefaults
+    private let makeUUID: () -> UUID
+    private let encoder: JSONEncoder
+    private let decoder: JSONDecoder
+
+    private(set) var profiles: [TunnelProfile] = []
+    private(set) var migrationDiagnostic: String?
+    private(set) var blockingError: String?
+
+    init(
+        defaults: UserDefaults = .standard,
+        makeUUID: @escaping () -> UUID = UUID.init
+    ) {
+        self.defaults = defaults
+        self.makeUUID = makeUUID
+
+        let encoder = JSONEncoder()
+        encoder.outputFormatting = [.sortedKeys]
+        self.encoder = encoder
+        decoder = JSONDecoder()
+
+        loadOrMigrate()
+    }
+
+    @discardableResult
+    func addProfile(host: String, account: String, localPort: Int) throws -> TunnelProfile {
+        try requireWritableStore()
+
+        let profile = TunnelProfile(
+            id: makeUUID(),
+            host: host,
+            account: account,
+            localPort: localPort
+        )
+        try persist(profiles + [profile])
+        return try requireProfile(id: profile.id)
+    }
+
+    @discardableResult
+    func updateProfile(_ profile: TunnelProfile) throws -> TunnelProfile {
+        try requireWritableStore()
+        guard let index = profiles.firstIndex(where: { $0.id == profile.id }) else {
+            throw TunnelProfileError.profileNotFound(profile.id)
+        }
+
+        var candidate = profiles
+        candidate[index] = profile
+        try persist(candidate)
+        return try requireProfile(id: profile.id)
+    }
+
+    func removeProfile(id: UUID) throws {
+        try requireWritableStore()
+        guard profiles.contains(where: { $0.id == id }) else {
+            throw TunnelProfileError.profileNotFound(id)
+        }
+
+        try persist(profiles.filter { $0.id != id })
+    }
+
+    private func loadOrMigrate() {
+        if let storedObject = defaults.object(forKey: Self.profilesKey) {
+            guard let data = storedObject as? Data else {
+                setBlockingError(
+                    "Saved tunnel profiles have an incompatible data type. "
+                        + "The existing value was preserved; reset it explicitly before continuing."
+                )
+                return
+            }
+            loadExistingPayload(data)
+            return
+        }
+
+        if migrationIsComplete {
+            initializeEmptyStore()
+        } else {
+            migrateLegacySettings()
+        }
+    }
+
+    private func loadExistingPayload(_ data: Data) {
+        do {
+            let payload = try decoder.decode(TunnelProfilePayload.self, from: data)
+            guard payload.schemaVersion == TunnelProfilePayload.currentSchemaVersion else {
+                throw StoredPayloadError.unsupportedSchema(payload.schemaVersion)
+            }
+
+            profiles = try TunnelProfileValidator.normalize(payload.profiles)
+            if !migrationIsComplete {
+                defaults.set(true, forKey: Self.migrationCompleteKey)
+            }
+        } catch {
+            setBlockingError(
+                "Saved tunnel profiles could not be loaded: \(error.localizedDescription) "
+                    + "The existing value was preserved; reset it explicitly before continuing."
+            )
+        }
+    }
+
+    private func initializeEmptyStore() {
+        do {
+            try writePayload([])
+            profiles = []
+        } catch {
+            setBlockingError("An empty tunnel profile store could not be created: \(error.localizedDescription)")
+        }
+    }
+
+    private func migrateLegacySettings() {
+        do {
+            let profile = TunnelProfile(
+                id: makeUUID(),
+                host: try legacyString(forKey: Self.legacyHostKey, defaultValue: Self.defaultHost),
+                account: try legacyString(
+                    forKey: Self.legacyAccountKey,
+                    defaultValue: Self.defaultAccount
+                ),
+                localPort: try legacyPort()
+            )
+            let normalizedProfiles = try TunnelProfileValidator.normalize([profile])
+            try writePayload(normalizedProfiles)
+            profiles = normalizedProfiles
+            defaults.set(true, forKey: Self.migrationCompleteKey)
+        } catch {
+            do {
+                try writePayload([])
+                profiles = []
+                migrationDiagnostic = Self.bounded(
+                    "Legacy tunnel settings were not migrated: \(error.localizedDescription) "
+                        + "Create a new profile manually."
+                )
+                defaults.set(true, forKey: Self.migrationCompleteKey)
+            } catch {
+                setBlockingError(
+                    "Legacy tunnel settings could not be migrated and an empty profile store "
+                        + "could not be created: \(error.localizedDescription)"
+                )
+            }
+        }
+    }
+
+    private func legacyString(forKey key: String, defaultValue: String) throws -> String {
+        guard let value = defaults.object(forKey: key) else {
+            return defaultValue
+        }
+        guard let string = value as? String else {
+            throw LegacyMigrationError.incompatibleType(key)
+        }
+        return string
+    }
+
+    private func legacyPort() throws -> Int {
+        guard let value = defaults.object(forKey: Self.legacyPortKey) else {
+            return Self.defaultPort
+        }
+        guard let port = value as? Int else {
+            throw LegacyMigrationError.incompatibleType(Self.legacyPortKey)
+        }
+        return port
+    }
+
+    private func persist(_ candidate: [TunnelProfile]) throws {
+        let normalized = try TunnelProfileValidator.normalize(candidate)
+        try writePayload(normalized)
+        profiles = normalized
+    }
+
+    private func writePayload(_ profiles: [TunnelProfile]) throws {
+        let data = try encoder.encode(TunnelProfilePayload(profiles: profiles))
+        defaults.set(data, forKey: Self.profilesKey)
+    }
+
+    private func requireWritableStore() throws {
+        if let blockingError {
+            throw TunnelProfileError.persistenceUnavailable(blockingError)
+        }
+    }
+
+    private func requireProfile(id: UUID) throws -> TunnelProfile {
+        guard let profile = profiles.first(where: { $0.id == id }) else {
+            throw TunnelProfileError.profileNotFound(id)
+        }
+        return profile
+    }
+
+    private var migrationIsComplete: Bool {
+        (defaults.object(forKey: Self.migrationCompleteKey) as? Bool) == true
+    }
+
+    private func setBlockingError(_ message: String) {
+        profiles = []
+        blockingError = Self.bounded(message)
+    }
+
+    private static func bounded(_ message: String) -> String {
+        guard message.count > maximumDiagnosticLength else {
+            return message
+        }
+        return String(message.suffix(maximumDiagnosticLength))
+    }
+}
+
+private enum LegacyMigrationError: LocalizedError {
+    case incompatibleType(String)
+
+    var errorDescription: String? {
+        switch self {
+        case let .incompatibleType(key):
+            "Legacy preference \(key) has an incompatible value type."
+        }
+    }
+}
+
+private enum StoredPayloadError: LocalizedError {
+    case unsupportedSchema(Int)
+
+    var errorDescription: String? {
+        switch self {
+        case let .unsupportedSchema(version):
+            "Schema version \(version) is not supported."
+        }
+    }
+}
diff --git a/Sources/ReluxProxy/TunnelRuntime.swift b/Sources/ReluxProxy/TunnelRuntime.swift
new file mode 100644
index 0000000000000000000000000000000000000000..eb27f7a62524f52c42bab1cb3aaa051829e6041a
--- /dev/null
+++ b/Sources/ReluxProxy/TunnelRuntime.swift
@@ -0,0 +1,305 @@
+import Darwin
+import Foundation
+
+protocol TunnelCancellation: AnyObject, Sendable {
+    func cancel()
+}
+
+protocol TunnelProcessHandle: AnyObject, Sendable {
+    var isRunning: Bool { get }
+
+    @MainActor
+    func run(
+        executableURL: URL,
+        arguments: [String],
+        stderrHandler: @escaping @MainActor (String) -> Void,
+        terminationHandler: @escaping @MainActor (Int32) -> Void
+    ) throws
+
+    @MainActor
+    func terminate()
+
+    @MainActor
+    func forceTerminate()
+
+    @MainActor
+    func invalidateCallbacks()
+}
+
+protocol TunnelProcessFactory: Sendable {
+    @MainActor
+    func makeProcess() -> TunnelProcessHandle
+}
+
+protocol LocalPortProbing: Sendable {
+    func isAvailable(_ port: Int) -> Bool
+    func canConnect(_ port: Int) -> Bool
+}
+
+enum TunnelReadinessResult {
+    case ready
+    case timedOut
+}
+
+protocol TunnelReadinessMonitoring: Sendable {
+    @MainActor
+    func monitor(
+        process: TunnelProcessHandle,
+        port: Int,
+        completion: @escaping @MainActor (TunnelReadinessResult) -> Void
+    ) -> TunnelCancellation
+}
+
+protocol TunnelScheduling: Sendable {
+    @MainActor
+    func schedule(
+        after delay: TimeInterval,
+        action: @escaping @MainActor () -> Void
+    ) -> TunnelCancellation
+}
+
+struct SystemTunnelProcessFactory: TunnelProcessFactory {
+    @MainActor
+    func makeProcess() -> TunnelProcessHandle {
+        SystemTunnelProcess()
+    }
+}
+
+final class SystemTunnelProcess: TunnelProcessHandle, @unchecked Sendable {
+    private let process = Process()
+    private let eventQueue = DispatchQueue(label: "works.relux.proxy.ssh-process-events")
+    private var errorPipe: Pipe?
+
+    var isRunning: Bool {
+        process.isRunning
+    }
+
+    @MainActor
+    func run(
+        executableURL: URL,
+        arguments: [String],
+        stderrHandler: @escaping @MainActor (String) -> Void,
+        terminationHandler: @escaping @MainActor (Int32) -> Void
+    ) throws {
+        let pipe = Pipe()
+
+        process.executableURL = executableURL
+        process.arguments = arguments
+        process.standardInput = FileHandle.nullDevice
+        process.standardOutput = FileHandle.nullDevice
+        process.standardError = pipe
+        errorPipe = pipe
+
+        pipe.fileHandleForReading.readabilityHandler = { [eventQueue] handle in
+            let data = handle.availableData
+            guard !data.isEmpty, let text = String(data: data, encoding: .utf8) else {
+                return
+            }
+            eventQueue.async {
+                Task { @MainActor in
+                    stderrHandler(text)
+                }
+            }
+        }
+
+        process.terminationHandler = { [eventQueue, weak pipe] terminatedProcess in
+            eventQueue.async {
+                pipe?.fileHandleForReading.readabilityHandler = nil
+                let remainingData = pipe?.fileHandleForReading.readDataToEndOfFile() ?? Data()
+                let remainingText = String(data: remainingData, encoding: .utf8)
+
+                Task { @MainActor in
+                    if let remainingText, !remainingText.isEmpty {
+                        stderrHandler(remainingText)
+                    }
+                    terminationHandler(terminatedProcess.terminationStatus)
+                }
+            }
+        }
+
+        try process.run()
+    }
+
+    @MainActor
+    func terminate() {
+        guard process.isRunning else {
+            return
+        }
+        process.terminate()
+    }
+
+    @MainActor
+    func forceTerminate() {
+        guard process.isRunning, process.processIdentifier > 0 else {
+            return
+        }
+        kill(process.processIdentifier, SIGKILL)
+    }
+
+    @MainActor
+    func invalidateCallbacks() {
+        errorPipe?.fileHandleForReading.readabilityHandler = nil
+        process.terminationHandler = nil
+        errorPipe = nil
+    }
+}
+
+struct SystemLocalPortProbe: LocalPortProbing {
+    func isAvailable(_ port: Int) -> Bool {
+        withSocket(for: port) { descriptor, address in
+            var address = address
+            return withUnsafePointer(to: &address) { pointer in
+                pointer.withMemoryRebound(to: sockaddr.self, capacity: 1) { socketAddress in
+                    Darwin.bind(
+                        descriptor,
+                        socketAddress,
+                        socklen_t(MemoryLayout<sockaddr_in>.size)
+                    ) == 0
+                }
+            }
+        }
+    }
+
+    func canConnect(_ port: Int) -> Bool {
+        withSocket(for: port) { descriptor, address in
+            var address = address
+            return withUnsafePointer(to: &address) { pointer in
+                pointer.withMemoryRebound(to: sockaddr.self, capacity: 1) { socketAddress in
+                    Darwin.connect(
+                        descriptor,
+                        socketAddress,
+                        socklen_t(MemoryLayout<sockaddr_in>.size)
+                    ) == 0
+                }
+            }
+        }
+    }
+
+    private func withSocket(
+        for port: Int,
+        operation: (Int32, sockaddr_in) -> Bool
+    ) -> Bool {
+        let descriptor = socket(AF_INET, SOCK_STREAM, 0)
+        guard descriptor >= 0 else {
+            return false
+        }
+        defer { close(descriptor) }
+
+        var address = sockaddr_in()
+        address.sin_len = UInt8(MemoryLayout<sockaddr_in>.size)
+        address.sin_family = sa_family_t(AF_INET)
+        address.sin_port = in_port_t(UInt16(port).bigEndian)
+        address.sin_addr = in_addr(s_addr: inet_addr("127.0.0.1"))
+        return operation(descriptor, address)
+    }
+}
+
+final class PollingTunnelReadinessMonitor: TunnelReadinessMonitoring, @unchecked Sendable {
+    private let portProbe: LocalPortProbing
+    private let attempts: Int
+    private let interval: TimeInterval
+    private let queue: DispatchQueue
+
+    init(
+        portProbe: LocalPortProbing,
+        attempts: Int = 100,
+        interval: TimeInterval = 0.2,
+        queue: DispatchQueue = .global(qos: .utility)
+    ) {
+        self.portProbe = portProbe
+        self.attempts = attempts
+        self.interval = interval
+        self.queue = queue
+    }
+
+    @MainActor
+    func monitor(
+        process: TunnelProcessHandle,
+        port: Int,
+        completion: @escaping @MainActor (TunnelReadinessResult) -> Void
+    ) -> TunnelCancellation {
+        let cancellation = LockedTunnelCancellation()
+
+        queue.async { [attempts, interval, portProbe] in
+            for _ in 0..<attempts {
+                guard !cancellation.isCancelled else {
+                    return
+                }
+                Thread.sleep(forTimeInterval: interval)
+                guard !cancellation.isCancelled, process.isRunning else {
+                    return
+                }
+                if portProbe.canConnect(port) {
+                    Task { @MainActor in
+                        guard !cancellation.isCancelled else {
+                            return
+                        }
+                        completion(.ready)
+                    }
+                    return
+                }
+            }
+
+            guard !cancellation.isCancelled, process.isRunning else {
+                return
+            }
+            Task { @MainActor in
+                guard !cancellation.isCancelled else {
+                    return
+                }
+                completion(.timedOut)
+            }
+        }
+
+        return cancellation
+    }
+}
+
+struct DispatchTunnelScheduler: TunnelScheduling {
+    private let queue: DispatchQueue
+
+    init(queue: DispatchQueue = .global(qos: .utility)) {
+        self.queue = queue
+    }
+
+    @MainActor
+    func schedule(
+        after delay: TimeInterval,
+        action: @escaping @MainActor () -> Void
+    ) -> TunnelCancellation {
+        let workItem = DispatchWorkItem {
+            Task { @MainActor in
+                action()
+            }
+        }
+        queue.asyncAfter(deadline: .now() + delay, execute: workItem)
+        return WorkItemTunnelCancellation(workItem: workItem)
+    }
+}
+
+private final class LockedTunnelCancellation: TunnelCancellation, @unchecked Sendable {
+    private let lock = NSLock()
+    private var cancelled = false
+
+    var isCancelled: Bool {
+        lock.withLock { cancelled }
+    }
+
+    func cancel() {
+        lock.withLock {
+            cancelled = true
+        }
+    }
+}
+
+private final class WorkItemTunnelCancellation: TunnelCancellation, @unchecked Sendable {
+    private let workItem: DispatchWorkItem
+
+    init(workItem: DispatchWorkItem) {
+        self.workItem = workItem
+    }
+
+    func cancel() {
+        workItem.cancel()
+    }
+}
diff --git a/Tests/ReluxProxyTests/LocalPortProbeTests.swift b/Tests/ReluxProxyTests/LocalPortProbeTests.swift
new file mode 100644
index 0000000000000000000000000000000000000000..6db53a151357ba821836fc069434250ecbd5783b
--- /dev/null
+++ b/Tests/ReluxProxyTests/LocalPortProbeTests.swift
@@ -0,0 +1,46 @@
+import Darwin
+import Testing
+@testable import ReluxProxy
+
+@Suite
+struct LocalPortProbeTests {
+    @Test
+    func detectsAListenerAlreadyBoundToIPv4Loopback() throws {
+        let descriptor = socket(AF_INET, SOCK_STREAM, 0)
+        #expect(descriptor >= 0)
+        defer { close(descriptor) }
+
+        var address = sockaddr_in()
+        address.sin_len = UInt8(MemoryLayout<sockaddr_in>.size)
+        address.sin_family = sa_family_t(AF_INET)
+        address.sin_port = 0
+        address.sin_addr = in_addr(s_addr: inet_addr("127.0.0.1"))
+
+        let bindResult = withUnsafePointer(to: &address) { pointer in
+            pointer.withMemoryRebound(to: sockaddr.self, capacity: 1) { socketAddress in
+                Darwin.bind(
+                    descriptor,
+                    socketAddress,
+                    socklen_t(MemoryLayout<sockaddr_in>.size)
+                )
+            }
+        }
+        #expect(bindResult == 0)
+        #expect(listen(descriptor, 1) == 0)
+
+        var boundAddress = sockaddr_in()
+        var boundLength = socklen_t(MemoryLayout<sockaddr_in>.size)
+        let nameResult = withUnsafeMutablePointer(to: &boundAddress) { pointer in
+            pointer.withMemoryRebound(to: sockaddr.self, capacity: 1) { socketAddress in
+                getsockname(descriptor, socketAddress, &boundLength)
+            }
+        }
+        #expect(nameResult == 0)
+        let port = Int(UInt16(bigEndian: boundAddress.sin_port))
+        let probe = SystemLocalPortProbe()
+
+        #expect(port > 0)
+        #expect(!probe.isAvailable(port))
+        #expect(probe.canConnect(port))
+    }
+}
