+  private func scheduleForcedStop(
+    for session: TunnelSession,
+    process: TunnelProcessHandle,
+    generation: UInt64
+  ) {
+    session.forceStopAction?.cancel()
+    session.forceStopAction = scheduler.schedule(after: Self.stopGracePeriod) {
+      guard
