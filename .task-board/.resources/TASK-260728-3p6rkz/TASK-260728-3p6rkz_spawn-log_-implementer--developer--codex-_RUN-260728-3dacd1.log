--- a/Tests/ReluxProxyTests/TunnelConfigurationTests.swift
+++ b/Tests/ReluxProxyTests/TunnelConfigurationTests.swift
@@ -1,38 +1,77 @@
-import XCTest
+import Foundation
+import Testing
 @testable import ReluxProxy
 
-final class TunnelConfigurationTests: XCTestCase {
-    func testBuildsTargetWithAccount() throws {
+@Suite
+struct TunnelConfigurationTests {
+    @Test
+    func normalizesDisplayTargetAndLocalEndpoint() {
         let configuration = TunnelConfiguration(
-            host: " relux ",
-            account: " administrator ",
+            host: " work-bastion ",
+            account: " ops ",
