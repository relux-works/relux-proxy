+    @Test
+    func duplicateOrInvalidMutationLeavesPreviousPayloadUntouched() throws {
+        let defaults = makeDefaults()
+        defer { clear(defaults) }
+        defaults.set(true, forKey: TunnelProfileStore.migrationCompleteKey)
+
