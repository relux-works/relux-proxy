+        let restart = TunnelProfileStore(defaults: defaults)
+        #expect(restart.profiles == store.profiles)
+        #expect(restart.profiles[0].host == "renamed-alias")
+        #expect(restart.profiles[0].localPort == 2_080)
+    }
