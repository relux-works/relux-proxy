+                    id: first.id,
+                    host: first.host,
+                    account: first.account,
+                    localPort: 1_081
+                )
+            )
+        }
+        #expect(throws: TunnelProfileError.self) {
+            try store.addProfile(host: "-invalid", account: "", localPort: 1_082)
+        }
