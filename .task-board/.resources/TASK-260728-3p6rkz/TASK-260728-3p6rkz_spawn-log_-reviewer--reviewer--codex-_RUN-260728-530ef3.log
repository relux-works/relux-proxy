import Foundation

struct TunnelProfile: Codable, Identifiable, Equatable, Sendable {
  let id: UUID
  var host: String
  var account: String
  var localPort: Int

  var configuration: TunnelConfiguration {
    TunnelConfiguration(host: host, account: account, localPort: localPort)
  }

  var displayTarget: String {
    configuration.target
  }

  func normalized() throws -> TunnelProfile {
    let configuration = TunnelConfiguration(
      host: host,
      account: account,
      localPort: localPort
    )
    if let validationError = configuration.validationError {
      throw TunnelProfileError.invalidProfile(validationError)
    }

    return TunnelProfile(
      id: id,
      host: configuration.normalizedHost,
      account: configuration.normalizedAccount,
      localPort: localPort
    )
  }
}

struct TunnelProfilePayload: Codable, Equatable {
  static let currentSchemaVersion = 1

  let schemaVersion: Int
  var profiles: [TunnelProfile]

  init(profiles: [TunnelProfile]) {
    schemaVersion = Self.currentSchemaVersion
    self.profiles = profiles
  }
}

enum TunnelProfileValidator {
  static func normalize(_ profiles: [TunnelProfile]) throws -> [TunnelProfile] {
    try validateCollection(
      profiles.map { profile in
        try profile.normalized()
      }
    )
  }

  static func validateStored(_ profiles: [TunnelProfile]) throws -> [TunnelProfile] {
    for profile in profiles {
      let normalized = try profile.normalized()
      guard normalized == profile else {
        throw TunnelProfileError.invalidProfile(
          "Saved profile \(profile.id.uuidString) contains surrounding whitespace."
        )
      }
    }
    return try validateCollection(profiles)
  }

  private static func validateCollection(
    _ profiles: [TunnelProfile]
  ) throws -> [TunnelProfile] {
    var profileIDs = Set<UUID>()
    var localPorts = Set<Int>()

    for profile in profiles {
      guard profileIDs.insert(profile.id).inserted else {
        throw TunnelProfileError.duplicateProfileID(profile.id)
      }
      guard localPorts.insert(profile.localPort).inserted else {
        throw TunnelProfileError.duplicateLocalPort(profile.localPort)
      }
    }
    return profiles
  }
}

enum TunnelProfileError: LocalizedError, Equatable {
  case invalidProfile(String)
  case duplicateProfileID(UUID)
  case duplicateLocalPort(Int)
  case profileNotFound(UUID)
  case activeProfile(UUID)
  case persistenceUnavailable(String)

  var errorDescription: String? {
    switch self {
    case .invalidProfile(let message):
      message
    case .duplicateProfileID(let id):
      "The saved profile identifier \(id.uuidString) is duplicated."
    case .duplicateLocalPort(let port):
      "Local SOCKS port \(port) is already assigned to another profile."
    case .profileNotFound:
      "The selected tunnel profile no longer exists."
    case .activeProfile:
      "Disconnect this tunnel before editing or removing its profile."
    case .persistenceUnavailable(let message):
      message
    }
  }
}
import Foundation

enum SSHCommandBuilder {
  static let executableURL = URL(fileURLWithPath: "/usr/bin/ssh")

  static func arguments(for configuration: TunnelConfiguration) throws -> [String] {
    if let error = configuration.validationError {
      throw SSHCommandError.invalidConfiguration(error)
    }

    var arguments = [
      "-N",
      "-C",
      "-D", configuration.localEndpoint,
      "-o", "ExitOnForwardFailure=yes",
      "-o", "ServerAliveInterval=30",
      "-o", "ServerAliveCountMax=3",
      "-o", "ConnectTimeout=15",
      "-o", "BatchMode=yes",
      "-o", "LogLevel=ERROR",
    ]
    if !configuration.normalizedAccount.isEmpty {
      arguments.append(contentsOf: ["-l", configuration.normalizedAccount])
    }
    arguments.append(configuration.sshDestination)
    return arguments
  }
}

enum SSHCommandError: LocalizedError, Equatable {
  case invalidConfiguration(String)

  var errorDescription: String? {
    switch self {
    case .invalidConfiguration(let message):
      return message
    }
  }
}
import Foundation

struct TunnelConfiguration: Equatable {
  let host: String
  let account: String
  let localPort: Int

  var normalizedHost: String {
    host.trimmingCharacters(in: .whitespacesAndNewlines)
  }

  var normalizedAccount: String {
    account.trimmingCharacters(in: .whitespacesAndNewlines)
  }

  var target: String {
    normalizedAccount.isEmpty
      ? normalizedHost
      : "\(normalizedAccount)@\(normalizedHost)"
  }

  var sshDestination: String {
    normalizedHost
  }

  var localEndpoint: String {
    "127.0.0.1:\(localPort)"
  }

  var validationError: String? {
    if normalizedHost.isEmpty {
      return "Enter an SSH host or an alias from ~/.ssh/config."
    }
    if normalizedHost.contains(where: \Character.isWhitespace) {
      return "The SSH host cannot contain whitespace."
    }
    if normalizedHost.hasPrefix("-") {
      return "The SSH host cannot begin with -."
    }
    if normalizedAccount.contains(where: \Character.isWhitespace)
      || normalizedAccount.contains("@")
    {
      return "The SSH account must not contain whitespace or @."
    }
    if !(1...65_535).contains(localPort) {
      return "The local port must be between 1 and 65535."
    }
    return nil
  }
}
import AppKit
import SwiftUI

final class AppDelegate: NSObject, NSApplicationDelegate {
  private var terminationPending = false

  func applicationShouldTerminate(_ sender: NSApplication) -> NSApplication.TerminateReply {
    guard !terminationPending else {
      return .terminateLater
    }

    terminationPending = true
    TunnelController.shared.shutdown {
      DispatchQueue.main.async {
        sender.reply(toApplicationShouldTerminate: true)
      }
    }
    return .terminateLater
  }
}

@main
struct ReluxProxyApp: App {
  @NSApplicationDelegateAdaptor(AppDelegate.self) private var appDelegate
  @State private var controller = TunnelController.shared

  var body: some Scene {
    MenuBarExtra {
      MenuContentView(controller: controller)
    } label: {
      Image(systemName: controller.aggregateStatus.symbolName)
        .accessibilityLabel("Relux Proxy: \(controller.aggregateStatus.title)")
    }
    .menuBarExtraStyle(.window)
  }

