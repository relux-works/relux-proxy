    let fixture = try ControllerFixture(
      profiles: [
        ("alpha", 1_080),
        ("beta", 1_081),
      ]
    )
    defer { fixture.cleanup() }
    let first = fixture.profiles[0]
    let second = fixture.profiles[1]

