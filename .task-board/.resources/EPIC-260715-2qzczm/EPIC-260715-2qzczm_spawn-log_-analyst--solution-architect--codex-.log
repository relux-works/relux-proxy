/bin/zsh -lc "task-board m 'add_resource(TASK-260715-3f9kv8, name=TASK-260715-3f9kv8_lane-assignment-plan.puml, content=\"@startuml
title M3 new-flow lane assignment
start
:Receive current-generation channel request;
if (Memory and server admission available?) then (yes)
  if (Control or latency-sensitive DNS?) then (yes)
    :Filter control-eligible capacity;
  else (no)
    if (Likely bulk at open?) then (yes)
      :Filter optional bulk then general capacity;
    else (ordinary)
      :Filter general capacity;
    endif
  endif
  :Exclude failed, closing, rekeying, stale, and pressure-blocked lanes;
  :Order by writable credit, queued bytes, RTT health, and open channels;
  if (Eligible lane exists?) then (yes)
    :Pin flow to selected lane until close;
    :Record aggregate assignment;
  else (no)
    :Return bounded typed admission failure;
  endif
else (no)
  :Return bounded pressure or capacity failure;
endif
stop
@enduml\", type=outcome, description=\"Planning activity diagram for deterministic lane eligibility, selection, pinning, and bounded rejection\"); add_resource(TASK-260715-1pn983, name=TASK-260715-1pn983_memory-pressure-plan.puml, content=\"@startuml
title M3 extension memory pressure states
state Normal
state Soft
state Pressure
state Critical
[*] --> Normal
Normal --> Soft : soft entry
Soft --> Normal : recovery hysteresis
Soft --> Pressure : pressure entry
Pressure --> Soft : pressure recovery
Pressure --> Critical : critical entry
Critical --> Pressure : critical recovery
Normal : full admitted configuration
Soft : suppress optional lanes
Soft : close idle channels and shrink caches
Soft : cap new windows
Pressure : withhold window adjustments
Pressure : reduce HEV session and cache limits
Pressure : refuse new nonessential flows
Critical : release old transport before replacement
Critical : stop explicitly when recovery cannot fit
note right of Normal
Every transition uses current ledger bytes,
physical footprint, one uncached advisory
available-memory sample, and a generation.
end note
@enduml\", type=outcome, description=\"Planning state diagram for soft, pressure, critical, and recovery actions\"); add_resource(TASK-260715-1zikbu, name=TASK-260715-1zikbu_reconnect-state-plan.puml, content=\"@startuml
title M3 reconnect and reasserting lifecycle
state Disconnected
state Connecting
state ConnectedFull
state ConnectedDegraded
state Reasserting
state Failed
state Disconnecting
[*] --> Disconnected
Disconnected --> Connecting : user or system start
Connecting --> ConnectedFull : SSH, safe DNS, packet, relay ready
Connecting --> ConnectedDegraded : SSH, safe DNS, packet ready
Connecting --> Failed : mandatory or terminal failure
ConnectedFull --> Reasserting : path, SSH, lane A, or lifecycle loss
ConnectedDegraded --> Reasserting : path, SSH, or lifecycle change
Reasserting --> ConnectedFull : current full readiness restored
Reasserting --> ConnectedDegraded : current TCP and safe DNS restored
Reasserting --> Failed : terminal cause or bounded retry exhausted
ConnectedFull --> Disconnecting : stop
ConnectedDegraded --> Disconnecting : stop
Reasserting --> Disconnecting : stop
Failed --> Connecting : explicit eligible retry
Failed --> Disconnecting : stop
Disconnecting --> Disconnected : settings and resources released
note right of Reasserting
Invalidate old lane and relay generations.
Reserve bounded replacement memory.
Try cached endpoints, then required-interface
resolution and connect. Capture actual endpoint,
replace exact exclusion and settings, restore
lane A, safe DNS, packet and TCP, relay, then
optional lanes. Clear reasserting only when
the advertised mode is usable.
end note
@enduml\", type=outcome, description=\"Planning state diagram for generation-safe reconnect, settings replacement, and capability restoration\"); add_resource(TASK-260715-1je8v2, name=TASK-260715-1je8v2_quic-policy-plan.puml, content=\"@startuml
title M3 destination UDP 443 policy
start
:Classify tunnel DNS before general UDP;
if (Destination is UDP 443?) then (yes)
  if (Policy is Block UDP 443?) then (yes)
    :Return bounded local unreachable or equivalent;
  else (no)
    if (Current generation has validated relay UDP?) then (yes)
      if (Policy is Allow QUIC?) then (yes)
        :Admit through current relay association path;
      else (Auto)
        :Read current bounded lane loss and latency evidence;
        if (Evidence predicts acceptable QUIC?) then (yes)
          :Admit through current relay association path;
        else (no)
          :Return bounded local unreachable or equivalent;
        endif
      endif
    else (no)
      :Return bounded local unreachable or equivalent;
    endif
  endif
else (no)
  :Preserve existing DNS or unrelated UDP policy;
endif
stop
@enduml\", type=outcome, description=\"Planning activity diagram for Allow, Block, and Auto QUIC outcomes without silent timeout\"); add_resource(TASK-260715-1je8v2, name=TASK-260715-1je8v2_route-mode-plan.puml, content=\"@startuml
title M3 route-mode settings transaction
start
:Require authenticated actual SSH endpoint;
:Require ready tunnel-owned safe DNS;
if (Route mode is fail-closed?) then (yes)
  if (includeAllNetworks supported?) then (yes)
    :Build dual-stack defaults plus includeAllNetworks;
    :Add only exact endpoint host exclusion;
    :Expose documented Apple system exceptions;
  else (no)
    :Fail validation with unsupported-mode reason;
    stop
  endif
else (compatible)
  :Build dual-stack default included routes;
  :Add only exact endpoint and approved system exclusions;
endif
:Attach tunnel DNS and accepted MTU;
:Validate no collision, broad bypass, or stale generation;
:Apply one settings transaction;
if (Current apply succeeds?) then (yes)
  :Permit packet reads and current capability publication;
else (no)
  :Rollback or publish explicit non-usable failure;
endif
stop
