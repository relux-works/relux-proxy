name: ci

on:
  push:
    branches: [main]
  pull_request:

permissions:
  contents: read

jobs:
  macos:
    runs-on: macos-15
    steps:
      - uses: actions/checkout@v7
      - name: Test
        run: swift test
      - name: Build universal app bundle
        env:
          SIGN_IDENTITY: "-"
        run: scripts/build-app.sh
name: release

on:
  push:
    tags: ["v*"]

permissions:
  contents: write
  id-token: write
  attestations: write

concurrency:
  group: release-${{ github.ref }}
  cancel-in-progress: false

jobs:
  notarized-dmg:
    runs-on: macos-15
    steps:
      - uses: actions/checkout@v7
        with:
          fetch-depth: 0

      - name: Import Developer ID identity
        env:
          MACOS_CERT_P12: ${{ secrets.MACOS_CERT_P12 }}
        run: |
          echo "$MACOS_CERT_P12" | base64 --decode > /tmp/relux-devid.p12
          security create-keychain -p ci-temp ci.keychain
          security set-keychain-settings -lut 21600 ci.keychain
          security unlock-keychain -p ci-temp ci.keychain
          security import /tmp/relux-devid.p12 -k ci.keychain -P "" -T /usr/bin/codesign
          security set-key-partition-list -S apple-tool:,apple: -s -k ci-temp ci.keychain
          security list-keychains -d user -s ci.keychain login.keychain
          rm -f /tmp/relux-devid.p12

      - name: Build signed universal app
        env:
          VERSION: ${{ github.ref_name }}
          BUILD_NUMBER: ${{ github.run_number }}
          SIGN_IDENTITY: "Developer ID Application: Relux Works, LLC (262RZ595FP)"
        run: scripts/build-app.sh

      - name: Package and sign DMG
        env:
          VERSION: ${{ github.ref_name }}
        run: |
          scripts/create-dmg.sh
          codesign --force --sign "Developer ID Application: Relux Works, LLC (262RZ595FP)" \
            --timestamp dist/ReluxProxy-*.dmg

      - name: Notarize and staple
        env:
          ASC_KEY_ID: ${{ secrets.ASC_KEY_ID }}
          ASC_ISSUER_ID: ${{ secrets.ASC_ISSUER_ID }}
          ASC_KEY_P8: ${{ secrets.ASC_KEY_P8 }}
        run: |
          echo "$ASC_KEY_P8" | base64 --decode > /tmp/asc.p8
          xcrun notarytool submit dist/ReluxProxy-*.dmg \
            --key /tmp/asc.p8 \
            --key-id "$ASC_KEY_ID" \
            --issuer "$ASC_ISSUER_ID" \
            --wait
          rm -f /tmp/asc.p8
          xcrun stapler staple dist/ReluxProxy-*.dmg
          xcrun stapler validate dist/ReluxProxy-*.dmg
          spctl -a -t open --context context:primary-signature -v dist/ReluxProxy-*.dmg

      - name: Create stable latest asset and checksums
        run: |
          cp dist/ReluxProxy-*.dmg dist/ReluxProxy.dmg
          (cd dist && shasum -a 256 ReluxProxy-*.dmg ReluxProxy.dmg > SHA256SUMS)

      - name: Attest build provenance
        uses: actions/attest-build-provenance@v4
        with:
          subject-path: dist/ReluxProxy*.dmg

      - name: Publish GitHub release
        uses: softprops/action-gh-release@v3
        with:
          files: |
            dist/ReluxProxy-*.dmg
            dist/ReluxProxy.dmg
            dist/SHA256SUMS
          generate_release_notes: true
#!/bin/bash
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
VERSION="${VERSION:-0.1.0-dev}"
VERSION="${VERSION#v}"
SHORT_VERSION="${VERSION%%-*}"
BUILD_NUMBER="${BUILD_NUMBER:-$(git -C "$ROOT" rev-list --count HEAD 2>/dev/null || echo 1)}"
APP_NAME="ReluxProxy"
BUNDLE="$ROOT/dist/$APP_NAME.app"
SIGN_IDENTITY="${SIGN_IDENTITY:-Developer ID Application: Relux Works, LLC (262RZ595FP)}"

cd "$ROOT"
rm -rf "$BUNDLE"
mkdir -p "$BUNDLE/Contents/MacOS" "$BUNDLE/Contents/Resources"

BUILD_ARGUMENTS=(-c release)
if [[ "${UNIVERSAL:-1}" == "1" ]]; then
    BUILD_ARGUMENTS+=(--arch arm64 --arch x86_64)
fi

swift build "${BUILD_ARGUMENTS[@]}"
BIN_DIR="$(swift build "${BUILD_ARGUMENTS[@]}" --show-bin-path)"
cp "$BIN_DIR/ReluxProxy" "$BUNDLE/Contents/MacOS/ReluxProxy"
cp "$ROOT/Resources/Info.plist" "$BUNDLE/Contents/Info.plist"
swift "$ROOT/scripts/generate-icon.swift" "$BUNDLE/Contents/Resources/ReluxProxy.icns"

/usr/libexec/PlistBuddy -c "Set :CFBundleShortVersionString $SHORT_VERSION" "$BUNDLE/Contents/Info.plist"
/usr/libexec/PlistBuddy -c "Set :CFBundleVersion $BUILD_NUMBER" "$BUNDLE/Contents/Info.plist"

if [[ "$SIGN_IDENTITY" == "-" ]]; then
    codesign --force --sign - "$BUNDLE"
elif security find-identity -v -p codesigning | grep -Fq "$SIGN_IDENTITY"; then
    codesign --force --options runtime --timestamp --sign "$SIGN_IDENTITY" "$BUNDLE"
else
    echo "warning: '$SIGN_IDENTITY' not found; using an ad-hoc signature" >&2
    codesign --force --sign - "$BUNDLE"
fi

codesign --verify --deep --strict --verbose=2 "$BUNDLE"
echo "Built $BUNDLE ($VERSION, build $BUILD_NUMBER)"
#!/bin/bash
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
VERSION="${VERSION:-0.1.0-dev}"
VERSION="${VERSION#v}"
APP="$ROOT/dist/ReluxProxy.app"
DMG="$ROOT/dist/ReluxProxy-v$VERSION-universal.dmg"
STAGE="$ROOT/.build/dmg-root"

if [[ ! -d "$APP" ]]; then
    echo "error: $APP does not exist; run scripts/build-app.sh first" >&2
    exit 1
fi

rm -rf "$STAGE" "$DMG"
mkdir -p "$STAGE"
cp -R "$APP" "$STAGE/"
ln -s /Applications "$STAGE/Applications"
hdiutil create -volname "Relux Proxy" -srcfolder "$STAGE" -ov -format UDZO "$DMG"
echo "Built $DMG"
