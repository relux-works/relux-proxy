diff --git a/.gitlab-ci.yml b/.gitlab-ci.yml
new file mode 100644
index 0000000000000000000000000000000000000000..424617eda67f581eab4e056ff9c40b0000b38b0f
--- /dev/null
+++ b/.gitlab-ci.yml
@@ -0,0 +1,94 @@
+workflow:
+  rules:
+    - if: '$CI_COMMIT_TAG == "v0.2.0"'
+    - if: "$CI_COMMIT_TAG"
+      when: never
+    - if: '$CI_PIPELINE_SOURCE == "merge_request_event"'
+    - if: "$CI_COMMIT_BRANCH"
+
+stages:
+  - validate
+  - release
+  - verify
+
+variables:
+  GIT_DEPTH: "0"
+
+validate:
+  stage: validate
+  tags:
+    - macos
+  script:
+    - shellcheck scripts/*.sh
+    - swift test
+    - swift build
+    - SIGN_IDENTITY="-" REQUIRE_DEVELOPER_ID=0 scripts/build-app.sh
+
+release_v0_2_0:
+  stage: release
+  tags:
+    - macos
+    - relux-release
+  resource_group: relux-production-release
+  interruptible: false
+  environment:
+    name: production
+  rules:
+    - if: '$CI_COMMIT_TAG == "v0.2.0"'
+  script:
+    - command -v glab
+    - scripts/release-macos.sh
+    - scripts/upload-gitlab-release-assets.sh
+  artifacts:
+    name: "ReluxProxy-$CI_COMMIT_TAG-release-evidence"
+    access: maintainer
+    expire_in: 1 year
+    paths:
+      - dist/ReluxProxy-v0.2.0-universal.dmg
+      - dist/ReluxProxy.dmg
+      - dist/SHA256SUMS
+      - dist/RELEASE-EVIDENCE.txt
+      - dist/ReluxProxy-v0.2.0-architectures.txt
+      - dist/ReluxProxy-v0.2.0-codesign.txt
+      - dist/ReluxProxy-v0.2.0-gatekeeper.txt
+      - dist/ReluxProxy-v0.2.0-notarization.json
+      - dist/ReluxProxy-v0.2.0-notarization-log.json
+  release:
+    name: "Relux Proxy v0.2.0"
+    tag_name: "$CI_COMMIT_TAG"
+    description: "./release-notes/v0.2.0.md"
+    assets:
+      links:
+        - name: "ReluxProxy-v0.2.0-universal.dmg"
+          url: "$CI_API_V4_URL/projects/$CI_PROJECT_ID/packages/generic/relux-proxy/$CI_COMMIT_TAG/ReluxProxy-v0.2.0-universal.dmg"
+          filepath: "/ReluxProxy-v0.2.0-universal.dmg"
+          link_type: package
+        - name: "ReluxProxy.dmg"
+          url: "$CI_API_V4_URL/projects/$CI_PROJECT_ID/packages/generic/relux-proxy/$CI_COMMIT_TAG/ReluxProxy.dmg"
+          filepath: "/ReluxProxy.dmg"
+          link_type: package
+        - name: "SHA256SUMS"
+          url: "$CI_API_V4_URL/projects/$CI_PROJECT_ID/packages/generic/relux-proxy/$CI_COMMIT_TAG/SHA256SUMS"
+          filepath: "/SHA256SUMS"
+          link_type: package
+
+verify_v0_2_0:
+  stage: verify
+  tags:
+    - macos
+    - relux-release
+  interruptible: false
+  needs:
+    - job: release_v0_2_0
+      artifacts: true
+  rules:
+    - if: '$CI_COMMIT_TAG == "v0.2.0"'
+  script:
+    - scripts/verify-gitlab-release.sh
+  artifacts:
+    name: "ReluxProxy-$CI_COMMIT_TAG-published-verification"
+    access: maintainer
+    when: always
+    expire_in: 1 year
+    paths:
+      - dist/published-verification/
diff --git a/.spec/legacy-socks-multi-tunnel.md b/.spec/legacy-socks-multi-tunnel.md
index 748253c55c3425459113464d7d6821a47059cc42..bc2628c8ea834577118fb70bd3fa4715525143d3
--- a/.spec/legacy-socks-multi-tunnel.md
+++ b/.spec/legacy-socks-multi-tunnel.md
@@ -1,15 +1,18 @@
 # Legacy SOCKS multi-tunnel contract
 
-**Contract version:** 1.0  
-**Status:** implementation contract for planned legacy macOS SOCKS work  
+**Contract version:** 1.1  
+**Status:** shipped product behavior in Relux Proxy v0.2.0; production GitLab
+publication remains gated on the external release prerequisites  
 **Applies to:** the system-OpenSSH SOCKS product only; it does not define the
 future system VPN.
 
-This is the source of truth for extending the current macOS menu-bar SOCKS app
-from one tunnel to independently controlled, concurrent tunnels. The current
-release remains a one-tunnel application; this document is not a claim that
-multi-tunnel support has shipped. The future VPN remains governed by the other
-documents in this directory.
