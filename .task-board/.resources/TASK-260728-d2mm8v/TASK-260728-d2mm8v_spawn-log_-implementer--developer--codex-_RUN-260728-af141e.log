+workflow:
+  rules:
+    - if: '$CI_COMMIT_TAG == "v0.2.0"'
+    - if: "$CI_COMMIT_TAG"
+      when: never
+    - if: '$CI_PIPELINE_SOURCE == "merge_request_event"'
+    - if: "$CI_COMMIT_BRANCH"
+
+stages:
+  - validate
+  - release
+  - verify
+
+variables:
+  GIT_DEPTH: "0"
+
+validate:
+  stage: validate
+  tags:
+    - macos
+  script:
+    - shellcheck scripts/*.sh
+    - swift test
+    - swift build
+    - SIGN_IDENTITY="-" REQUIRE_DEVELOPER_ID=0 scripts/build-app.sh
+
+release_v0_2_0:
+  stage: release
+  tags:
+    - macos
+    - relux-release
