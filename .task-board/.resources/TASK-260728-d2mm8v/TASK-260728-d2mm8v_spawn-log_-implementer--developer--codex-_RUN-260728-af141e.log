diff --git a/.research/TASK-260728-d2mm8v_gitlab-release-logbook.md b/.research/TASK-260728-d2mm8v_gitlab-release-logbook.md
new file mode 100644
index 0000000000000000000000000000000000000000..e7e4434814d3aad13cc39a409fbe937854678a8d
