diff --git a/Tests/ReluxProxyTests/GitLabReleaseAutomationTests.swift b/Tests/ReluxProxyTests/GitLabReleaseAutomationTests.swift
new file mode 100644
index 0000000000000000000000000000000000000000..85f35046181715583029a10b377c026fe590f9d2
