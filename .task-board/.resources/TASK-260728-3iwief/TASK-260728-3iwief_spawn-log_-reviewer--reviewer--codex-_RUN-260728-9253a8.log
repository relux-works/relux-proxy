@@ -0,0 +1,222 @@
+#!/bin/bash
+set -euo pipefail
+
+ROOT="${1:?snapshot root is required}"
+DIST="$ROOT/dist"
+VERSIONED="ReluxProxy-v0.2.0-universal.dmg"
+HARNESS="$ROOT/.review-offline"
+FIXTURES="$HARNESS/fixtures"
+REGISTRY="$HARNESS/registry"
+FAKE_URL_LOG="$HARNESS/requested-urls.txt"
+
+mkdir -p "$DIST" "$FIXTURES" "$REGISTRY"
+
+curl() {
+    local output=""
+    local upload=""
+    local header=""
+    local url=""
+
+    while (($#)); do
+        case "$1" in
+        --header)
+            header="$2"
+            shift 2
+            ;;
+        --output)
+            output="$2"
+            shift 2
+            ;;
+        --upload-file)
+            upload="$2"
+            shift 2
+            ;;
+        --fail-with-body | --silent | --show-error | --location)
+            shift
+            ;;
+        --*)
+            echo "stub rejected unsupported curl option: $1" >&2
+            return 2
+            ;;
+        *)
+            url="$1"
+            shift
+            ;;
+        esac
+    done
+
+    [[ "$header" == "JOB-TOKEN: $CI_JOB_TOKEN" ]] || {
+        echo "stub rejected missing or mismatched JOB-TOKEN header" >&2
+        return 22
+    }
+    [[ -n "$url" ]] || {
+        echo "stub rejected missing URL" >&2
+        return 2
+    }
+    printf '%s\n' "$url" >>"$FAKE_URL_LOG"
+
+    local package_base="$CI_API_V4_URL/projects/$CI_PROJECT_ID/packages/generic/relux-proxy/$CI_COMMIT_TAG"
+    local release_api="$CI_API_V4_URL/projects/$CI_PROJECT_ID/releases/$CI_COMMIT_TAG"
+    local download_base="$release_api/downloads"
+
+    if [[ -n "$upload" ]]; then
+        [[ "$url" == "$package_base/"* ]] || {
+            echo "stub rejected unexpected upload URL" >&2
+            return 22
+        }
+        cp "$upload" "$REGISTRY/${url##*/}"
+        return 0
+    fi
+
+    if [[ "$url" == "$release_api" ]]; then
+        printf '{"tag_name":"%s","commit":{"id":"%s"}}\n' \
+            "${FAKE_RELEASE_TAG:-$CI_COMMIT_TAG}" \
+            "${FAKE_RELEASE_COMMIT:-$CI_COMMIT_SHA}" >"$output"
+        return 0
+    fi
+
+    if [[ "$url" == "$download_base/"* ]]; then
+        local asset="${url##*/}"
+        [[ -f "$REGISTRY/$asset" ]] || {
+            echo "stub rejected unavailable published asset" >&2
+            return 22
+        }
+        cp "$REGISTRY/$asset" "$output"
+        if [[ "${FAKE_CORRUPT_ASSET:-}" == "$asset" ]]; then
+            printf 'corruption' >>"$output"
+        fi
+        return 0
+    fi
+
+    echo "stub rejected unexpected download URL" >&2
+    return 22
+}
+export -f curl
+export REGISTRY FAKE_URL_LOG
+
+commit="$(git -C "$ROOT" rev-parse HEAD)"
+base=(
+    CI_SERVER_HOST=gitlab.relux.example
+    CI_SERVER_URL=https://gitlab.relux.example
+    CI_PROJECT_PATH=relux/relux-proxy
+    CI_PROJECT_ID=42
+    CI_PROJECT_URL=https://gitlab.relux.example/relux/relux-proxy
+    CI_API_V4_URL=https://gitlab.relux.example/api/v4
+    CI_COMMIT_TAG=v0.2.0
+    CI_COMMIT_SHA="$commit"
+    CI_COMMIT_REF_PROTECTED=true
+    CI_PIPELINE_SOURCE=push
+    'CI_RUNNER_TAGS=["macos", "relux-release"]'
+    RELUX_GITLAB_HOST=gitlab.relux.example
+    RELUX_GITLAB_PROJECT_PATH=relux/relux-proxy
+    RELUX_ACCEPTED_RELEASE_SHA="$commit"
+)
+
+restore_dist() {
+    cp "$FIXTURES/$VERSIONED" "$DIST/$VERSIONED"
+    cp "$FIXTURES/ReluxProxy.dmg" "$DIST/ReluxProxy.dmg"
+    cp "$FIXTURES/SHA256SUMS" "$DIST/SHA256SUMS"
+}
+
+restore_registry() {
+    cp "$FIXTURES/$VERSIONED" "$REGISTRY/$VERSIONED"
+    cp "$FIXTURES/ReluxProxy.dmg" "$REGISTRY/ReluxProxy.dmg"
+    cp "$FIXTURES/SHA256SUMS" "$REGISTRY/SHA256SUMS"
+}
+
+run_upload() {
+    env "${base[@]}" CI_JOB_TOKEN=synthetic-review-token "$@" \
+        "$ROOT/scripts/upload-gitlab-release-assets.sh"
+}
+
+run_verify() {
+    env "${base[@]}" CI_JOB_TOKEN=synthetic-review-token "$@" \
+        "$ROOT/scripts/verify-gitlab-release.sh"
+}
+
+expect_fail() {
+    local label="$1"
+    local expected="$2"
+    shift 2
+    local output
+    if output="$("$@" 2>&1)"; then
+        echo "unexpected pass: $label" >&2
+        exit 1
+    fi
+    [[ "$output" == *"$expected"* ]] || {
+        echo "wrong failure for $label: $output" >&2
+        exit 1
+    }
+    echo "expected fail: $label"
+}
+
+cp /bin/echo "$FIXTURES/$VERSIONED"
+cp "$FIXTURES/$VERSIONED" "$FIXTURES/ReluxProxy.dmg"
+(
+    cd "$FIXTURES"
+    shasum -a 256 "$VERSIONED" ReluxProxy.dmg >SHA256SUMS
+)
+restore_dist
+rm -f "$FAKE_URL_LOG"
+
+run_upload
+[[ -s "$REGISTRY/$VERSIONED" && -s "$REGISTRY/ReluxProxy.dmg" && -s "$REGISTRY/SHA256SUMS" ]]
+[[ "$(wc -l <"$FAKE_URL_LOG")" -eq 3 ]]
+echo "pass: offline upload with exact package API URLs"
+
+upload_calls_before="$(wc -l <"$FAKE_URL_LOG")"
+expect_fail upload-missing-token "CI_JOB_TOKEN is required" run_upload CI_JOB_TOKEN=
+
+mv "$DIST/ReluxProxy.dmg" "$DIST/ReluxProxy.dmg.saved"
+expect_fail upload-missing-asset "missing or empty" run_upload
+mv "$DIST/ReluxProxy.dmg.saved" "$DIST/ReluxProxy.dmg"
+
+printf 'corruption' >>"$DIST/$VERSIONED"
+expect_fail upload-bad-checksum "FAILED" run_upload
+restore_dist
+
+cp /bin/cat "$DIST/ReluxProxy.dmg"
+(
+    cd "$DIST"
+    shasum -a 256 "$VERSIONED" ReluxProxy.dmg >SHA256SUMS
+)
+expect_fail upload-divergent-aliases "stable and versioned DMGs differ" run_upload
+restore_dist
+[[ "$(wc -l <"$FAKE_URL_LOG")" -eq "$upload_calls_before" ]]
+echo "upload fail-closed matrix: 1 positive + 4 expected negatives passed"
+
+rm -f "$FAKE_URL_LOG"
+run_verify
+release_api="https://gitlab.relux.example/api/v4/projects/42/releases/v0.2.0"
+grep -Fqx "$release_api" "$FAKE_URL_LOG"
+for asset in "$VERSIONED" ReluxProxy.dmg SHA256SUMS; do
+    grep -Fqx "$release_api/downloads/$asset" "$FAKE_URL_LOG"
+done
+if grep -Fq '/-/releases/' "$FAKE_URL_LOG"; then
+    echo "browser-style release route reached by verifier" >&2
+    exit 1
+fi
+echo "pass: offline verification with exact Releases API URLs"
+
+expect_fail verify-missing-token "CI_JOB_TOKEN is required" run_verify CI_JOB_TOKEN=
+expect_fail verify-wrong-tag "published release tag" run_verify FAKE_RELEASE_TAG=v0.2.1
+expect_fail verify-wrong-commit "accepted commit" run_verify \
+    FAKE_RELEASE_COMMIT=0000000000000000000000000000000000000000
+
+printf '\nchanged\n' >>"$REGISTRY/SHA256SUMS"
+expect_fail verify-changed-checksum-file "differs from the CI-produced" run_verify
+restore_registry
+
+expect_fail verify-corrupted-download "FAILED" run_verify \
+    FAKE_CORRUPT_ASSET="$VERSIONED"
+
+cp /bin/cat "$REGISTRY/ReluxProxy.dmg"
+(
+    cd "$REGISTRY"
+    shasum -a 256 "$VERSIONED" ReluxProxy.dmg >SHA256SUMS
+)
+cp "$REGISTRY/SHA256SUMS" "$DIST/SHA256SUMS"
+expect_fail verify-divergent-aliases "published stable-name DMG differs" run_verify
+restore_dist
+restore_registry
+echo "verification fail-closed matrix: 1 positive + 6 expected negatives passed"

