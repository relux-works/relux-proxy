class Quiet(http.server.BaseHTTPRequestHandler):
    def log_message(self, *args): pass
class Sink(Quiet):
    def do_GET(self):
        seen[\"forwarded\"] = self.headers.get(\"JOB-TOKEN\") == \"synthetic-review-token\"
        self.send_response(200); self.end_headers(); self.wfile.write(b\"asset\")
class Redirect(Quiet):
    target=None
    def do_GET(self):
        self.send_response(302); self.send_header(\"Location\", self.target); self.end_headers()
class Server(socketserver.TCPServer): allow_reuse_address=True
sink=Server((\"127.0.0.1\",0),Sink)
Redirect.target=f\"http://localhost:{sink.server_address[1]}/asset\"
redirect=Server((\"127.0.0.1\",0),Redirect)
threads=[threading.Thread(target=s.serve_forever,daemon=True) for s in (sink,redirect)]
[t.start() for t in threads]
r=subprocess.run([\"curl\",\"--fail-with-body\",\"--silent\",\"--show-error\",\"--location\",\"--header\",\"JOB-TOKEN: synthetic-review-token\",f\"http://127.0.0.1:{redirect.server_address[1]}/release/download\"],capture_output=True)
[s.shutdown() for s in (redirect,sink)]
assert r.returncode==0, r.stderr.decode()
assert seen[\"forwarded\"], \"custom JOB-TOKEN was not forwarded\"
print(\"reproduced: synthetic JOB-TOKEN reached a different-host redirect target\")'" in /Users/iv/Developer/relux-proxy/.temp/TASK-260728-3iwief/reviewer-RUN-260728-9253a8-Ft91W6/snapshot
