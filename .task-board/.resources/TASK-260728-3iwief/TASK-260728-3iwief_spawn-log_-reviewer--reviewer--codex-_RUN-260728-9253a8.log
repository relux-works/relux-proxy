+    shasum -a 256 "$VERSIONED" ReluxProxy.dmg >SHA256SUMS
+)
+expect_fail upload-divergent-aliases "stable and versioned DMGs differ" run_upload
+restore_dist
+[[ "$(wc -l <"$FAKE_URL_LOG")" -eq "$upload_calls_before" ]]
+echo "upload fail-closed matrix: 1 positive + 4 expected negatives passed"
