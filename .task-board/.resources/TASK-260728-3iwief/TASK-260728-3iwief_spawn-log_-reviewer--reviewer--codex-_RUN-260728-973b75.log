    84	security create-keychain -p "$MACOS_KEYCHAIN_PASSWORD" "$KEYCHAIN_PATH"
    85	security set-keychain-settings -lut 21600 "$KEYCHAIN_PATH"
    86	security unlock-keychain -p "$MACOS_KEYCHAIN_PASSWORD" "$KEYCHAIN_PATH"
    87	security import "$CERTIFICATE_PATH" \
    88	    -k "$KEYCHAIN_PATH" \
    89	    -P "$MACOS_CERT_PASSWORD" \
    90	    -T /usr/bin/codesign
    91	security set-key-partition-list \
    92	    -S apple-tool:,apple: \
    93	    -s \
    94	    -k "$MACOS_KEYCHAIN_PASSWORD" \
    95	    "$KEYCHAIN_PATH"
    96	security find-identity -v -p codesigning "$KEYCHAIN_PATH" |
    97	    grep -Fq "$SIGN_IDENTITY" ||
    98	    fail "the imported keychain does not contain the Relux Works Developer ID"
