+#!/bin/bash
+set -euo pipefail
+
+output_path=""
+upload_path=""
+request_url=""
+
+while [[ $# -gt 0 ]]; do
+    case "$1" in
+        --output)
+            output_path="$2"
+            shift 2
+            ;;
+        --upload-file)
+            upload_path="$2"
+            shift 2
+            ;;
+        --header)
+            shift 2
+            ;;
+        --fail-with-body | --silent | --show-error | --location)
+            shift
+            ;;
+        *)
+            request_url="$1"
+            shift
+            ;;
+    esac
+done
+
+[[ -n "$request_url" ]] || {
+    echo "stub curl: request URL is missing" >&2
+    exit 64
+}
+
+if [[ -n "$upload_path" ]]; then
+    [[ -s "$upload_path" ]] || {
+        echo "stub curl: upload file is missing or empty" >&2
+        exit 65
+    }
+    [[ "$request_url" == "$REVIEW_STUB_UPLOAD_BASE/"* ]] || {
+        echo "stub curl: unexpected upload URL" >&2
+        exit 66
+    }
+    exit 0
+fi
+
+[[ -n "$output_path" ]] || {
+    echo "stub curl: output path is missing" >&2
+    exit 67
+}
+
+if [[ "$request_url" == *"/releases/v0.2.0" ]]; then
+    printf '{"tag_name":"%s","commit":{"id":"%s"}}\n' \
+        "$REVIEW_STUB_RELEASE_TAG" \
+        "$REVIEW_STUB_RELEASE_COMMIT" >"$output_path"
+    exit 0
+fi
+
+asset_name="${request_url##*/}"
+cp "$REVIEW_STUB_REMOTE_DIR/$asset_name" "$output_path"

