     1	#!/bin/bash
     2	set -euo pipefail
     3	
     4	ROOT="$(cd "$(dirname "$0")/.." && pwd)"
     5	DIST="$ROOT/dist"
     6	VERIFY_DIR="$DIST/published-verification"
     7	
     8	fail() {
     9	    echo "error: $*" >&2
    10	    exit 1
    11	}
    12	
    13	"$ROOT/scripts/gitlab-release-preflight.sh"
    14	
    15	[[ -n "${CI_JOB_TOKEN:-}" ]] ||
    16	    fail "CI_JOB_TOKEN is required to verify the published GitLab Release"
    17	for command in cmp curl plutil shasum; do
    18	    command -v "$command" >/dev/null 2>&1 ||
    19	        fail "$command is required to verify the GitLab Release"
    20	done
    21	
    22	VERSIONED_DMG="ReluxProxy-$CI_COMMIT_TAG-universal.dmg"
    23	ASSETS=(
    24	    "$VERSIONED_DMG"
    25	    "ReluxProxy.dmg"
    26	    "SHA256SUMS"
    27	)
    28	
    29	rm -rf "$VERIFY_DIR"
    30	mkdir -p "$VERIFY_DIR"
    31	
    32	RELEASE_API="$CI_API_V4_URL/projects/$CI_PROJECT_ID/releases/$CI_COMMIT_TAG"
    33	curl \
    34	    --fail-with-body \
    35	    --silent \
    36	    --show-error \
    37	    --location \
    38	    --header "JOB-TOKEN: $CI_JOB_TOKEN" \
    39	    --output "$VERIFY_DIR/release.json" \
    40	    "$RELEASE_API"
    41	
    42	published_tag="$(plutil -extract tag_name raw -o - "$VERIFY_DIR/release.json")"
    43	published_commit="$(plutil -extract commit.id raw -o - "$VERIFY_DIR/release.json")"
    44	[[ "$published_tag" == "$CI_COMMIT_TAG" ]] ||
    45	    fail "the published release tag is '$published_tag', not '$CI_COMMIT_TAG'"
    46	[[ "$published_commit" == "$CI_COMMIT_SHA" ]] ||
    47	    fail "the published release points to '$published_commit', not the accepted commit"
    48	
    49	DIRECT_DOWNLOAD_BASE="$CI_PROJECT_URL/-/releases/$CI_COMMIT_TAG/downloads"
    50	for asset in "${ASSETS[@]}"; do
    51	    curl \
    52	        --fail-with-body \
    53	        --silent \
    54	        --show-error \
    55	        --location \
    56	        --header "JOB-TOKEN: $CI_JOB_TOKEN" \
    57	        --output "$VERIFY_DIR/$asset" \
    58	        "$DIRECT_DOWNLOAD_BASE/$asset"
    59	done
    60	
    61	cmp -s "$DIST/SHA256SUMS" "$VERIFY_DIR/SHA256SUMS" ||
    62	    fail "the published SHA256SUMS differs from the CI-produced checksum file"
    63	(
    64	    cd "$VERIFY_DIR"
    65	    shasum -a 256 -c SHA256SUMS
    66	)
    67	cmp -s "$VERIFY_DIR/$VERSIONED_DMG" "$VERIFY_DIR/ReluxProxy.dmg" ||
    68	    fail "the published stable-name DMG differs from the versioned DMG"
    69	
    70	echo "Verified the GitLab Release, accepted commit, asset links, and published hashes"

