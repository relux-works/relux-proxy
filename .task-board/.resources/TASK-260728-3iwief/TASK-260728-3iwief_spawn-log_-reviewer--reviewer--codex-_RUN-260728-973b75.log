   117	grep -Fq "TeamIdentifier=$EXPECTED_TEAM_ID" "$APP_SIGNATURE_REPORT" ||
   118	    fail "the app signature has the wrong Apple team identifier"
   119	codesign --verify --deep --strict --verbose=2 "$APP"
