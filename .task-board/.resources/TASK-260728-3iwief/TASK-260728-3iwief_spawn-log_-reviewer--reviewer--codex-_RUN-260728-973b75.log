    18	    runs-on: macos-15
    19	    steps:
    20	      - uses: actions/checkout@v7
    21	        with:
    22	          fetch-depth: 0
    23	
    24	      - name: Import Developer ID identity
    25	        env:
    26	          MACOS_CERT_P12: ${{ secrets.MACOS_CERT_P12 }}
    27	        run: |
    28	          echo "$MACOS_CERT_P12" | base64 --decode > /tmp/relux-devid.p12
    29	          security create-keychain -p ci-temp ci.keychain
    30	          security set-keychain-settings -lut 21600 ci.keychain
    31	          security unlock-keychain -p ci-temp ci.keychain
    32	          security import /tmp/relux-devid.p12 -k ci.keychain -P "" -T /usr/bin/codesign
    33	          security set-key-partition-list -S apple-tool:,apple: -s -k ci-temp ci.keychain
    34	          security list-keychains -d user -s ci.keychain login.keychain
    35	          rm -f /tmp/relux-devid.p12
    36	
    37	      - name: Build signed universal app
    38	        env:
    39	          VERSION: ${{ github.ref_name }}
    40	          BUILD_NUMBER: ${{ github.run_number }}
    41	          SIGN_IDENTITY: "Developer ID Application: Relux Works, LLC (262RZ595FP)"
    42	          REQUIRE_DEVELOPER_ID: "1"
    43	        run: scripts/build-app.sh
    44	
    45	      - name: Package and sign DMG
    46	        env:
    47	          VERSION: ${{ github.ref_name }}
    48	        run: |
    49	          scripts/create-dmg.sh
    50	          codesign --force --sign "Developer ID Application: Relux Works, LLC (262RZ595FP)" \
    51	            --timestamp dist/ReluxProxy-*.dmg
    52	
    53	      - name: Notarize and staple
    54	        env:
    55	          ASC_KEY_ID: ${{ secrets.ASC_KEY_ID }}
    56	          ASC_ISSUER_ID: ${{ secrets.ASC_ISSUER_ID }}
    57	          ASC_KEY_P8: ${{ secrets.ASC_KEY_P8 }}
    58	        run: |
    59	          echo "$ASC_KEY_P8" | base64 --decode > /tmp/asc.p8
    60	          xcrun notarytool submit dist/ReluxProxy-*.dmg \
    61	            --key /tmp/asc.p8 \
    62	            --key-id "$ASC_KEY_ID" \
    63	            --issuer "$ASC_ISSUER_ID" \
    64	            --wait
    65	          rm -f /tmp/asc.p8
    66	          xcrun stapler staple dist/ReluxProxy-*.dmg
    67	          xcrun stapler validate dist/ReluxProxy-*.dmg
    68	          spctl -a -t open --context context:primary-signature -v dist/ReluxProxy-*.dmg
    69	
    70	      - name: Create stable latest asset and checksums
    71	        run: |
    72	          cp dist/ReluxProxy-*.dmg dist/ReluxProxy.dmg
    73	          (cd dist && shasum -a 256 ReluxProxy-*.dmg ReluxProxy.dmg > SHA256SUMS)
    74	
    75	      - name: Attest build provenance
    76	        uses: actions/attest-build-provenance@v4
    77	        with:
    78	          subject-path: dist/ReluxProxy*.dmg
    79	
    80	      - name: Publish GitHub release
    81	        uses: softprops/action-gh-release@v3
    82	        with:
    83	          files: |
    84	            dist/ReluxProxy-*.dmg
    85	            dist/ReluxProxy.dmg
    86	            dist/SHA256SUMS
    87	          generate_release_notes: true

