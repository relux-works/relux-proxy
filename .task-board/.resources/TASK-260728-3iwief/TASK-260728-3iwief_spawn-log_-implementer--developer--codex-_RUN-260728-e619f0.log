+        )"
+        package_url="$(read_release_string "assets.links.$index.url" "$release_file")"
+        link_type="$(read_release_string "assets.links.$index.link_type" "$release_file")"
+
+        expected=0
+        for expected_asset in "${ASSETS[@]}"; do
+            if [[ "$name" == "$expected_asset" ]]; then
+                expected=1
+                break
+            fi
+        done
+        [[ "$expected" -eq 1 ]] ||
