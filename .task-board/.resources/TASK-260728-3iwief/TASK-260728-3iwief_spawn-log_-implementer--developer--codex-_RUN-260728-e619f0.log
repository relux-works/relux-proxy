    35	
    36	"$ROOT/scripts/gitlab-release-preflight.sh"
    37	
    38	for name in \
    39	    CI_PIPELINE_IID \
    40	    MACOS_CERT_P12_B64 \
    41	    MACOS_CERT_PASSWORD \
    42	    MACOS_KEYCHAIN_PASSWORD \
    43	    ASC_KEY_ID \
    44	    ASC_ISSUER_ID \
    45	    ASC_KEY_P8_B64; do
    46	    require_variable "$name"
