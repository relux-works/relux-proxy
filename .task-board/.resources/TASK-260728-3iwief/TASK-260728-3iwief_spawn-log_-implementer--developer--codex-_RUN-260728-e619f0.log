+      let remaining = searchStart..<contents.endIndex
+      let match = contents.range(of: marker, range: remaining)
+      #expect(match != nil, "missing or out-of-order marker: \(marker)")
+      guard let match else {
+        return
+      }
+      searchStart = match.upperBound
+    }
+  }
+
