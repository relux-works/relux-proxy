+            self.send_bytes(404, b"not found\n", "text/plain")
+
+    class ExternalHandler(Handler):
+        def do_GET(self):
+            path = urlparse(self.path).path
+            token_present = self.headers.get("JOB-TOKEN") is not None
+            append_log(
+                "external-requests.log",
