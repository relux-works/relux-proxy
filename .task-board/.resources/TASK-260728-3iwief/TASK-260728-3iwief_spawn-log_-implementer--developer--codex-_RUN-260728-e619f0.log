-    "$RELEASE_API"
+fetch_release_metadata "$RELEASE_API" "$VERIFY_DIR/release.json"
 
-published_tag="$(plutil -extract tag_name raw -o - "$VERIFY_DIR/release.json")"
-published_commit="$(plutil -extract commit.id raw -o - "$VERIFY_DIR/release.json")"
