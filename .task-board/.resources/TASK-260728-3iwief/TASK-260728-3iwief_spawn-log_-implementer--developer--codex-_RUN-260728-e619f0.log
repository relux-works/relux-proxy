   106	
   107	APP="$DIST/ReluxProxy.app"
   108	BINARY="$APP/Contents/MacOS/ReluxProxy"
   109	[[ -x "$BINARY" ]] || fail "the release app executable is missing"
   110	lipo "$BINARY" -verify_arch arm64 x86_64
   111	lipo -archs "$BINARY" >"$DIST/ReluxProxy-$CI_COMMIT_TAG-architectures.txt"
   112	
   113	APP_SIGNATURE_REPORT="$DIST/ReluxProxy-$CI_COMMIT_TAG-codesign.txt"
   114	codesign -dv --verbose=4 "$APP" >"$APP_SIGNATURE_REPORT" 2>&1
   115	grep -Fq "Authority=$SIGN_IDENTITY" "$APP_SIGNATURE_REPORT" ||
   116	    fail "the app signature authority is not the Relux Works Developer ID"
   117	grep -Fq "TeamIdentifier=$EXPECTED_TEAM_ID" "$APP_SIGNATURE_REPORT" ||
   118	    fail "the app signature has the wrong Apple team identifier"
   119	codesign --verify --deep --strict --verbose=2 "$APP"
   120	
   121	VERSION="$CI_COMMIT_TAG" "$ROOT/scripts/create-dmg.sh"
   122	VERSIONED_DMG="$DIST/ReluxProxy-$CI_COMMIT_TAG-universal.dmg"
   123	[[ -s "$VERSIONED_DMG" ]] || fail "the versioned universal DMG was not created"
   124	codesign --force \
   125	    --timestamp \
   126	    --sign "$SIGN_IDENTITY" \
   127	    --keychain "$KEYCHAIN_PATH" \
   128	    "$VERSIONED_DMG"
   129	codesign --verify --strict --verbose=2 "$VERSIONED_DMG"
   130	
   131	NOTARY_RESULT="$DIST/ReluxProxy-$CI_COMMIT_TAG-notarization.json"
   132	xcrun notarytool submit "$VERSIONED_DMG" \
   133	    --key "$NOTARY_KEY_PATH" \
   134	    --key-id "$ASC_KEY_ID" \
   135	    --issuer "$ASC_ISSUER_ID" \
   136	    --wait \
   137	    --output-format json >"$NOTARY_RESULT"
   138	
   139	notary_status="$(plutil -extract status raw -o - "$NOTARY_RESULT")"
   140	[[ "$notary_status" == "Accepted" ]] ||
   141	    fail "Apple notarization returned status '$notary_status'"
   142	submission_id="$(plutil -extract id raw -o - "$NOTARY_RESULT")"
   143	[[ -n "$submission_id" ]] || fail "Apple notarization did not return a submission ID"
   144	
   145	NOTARY_LOG="$DIST/ReluxProxy-$CI_COMMIT_TAG-notarization-log.json"
   146	xcrun notarytool log "$submission_id" \
   147	    --key "$NOTARY_KEY_PATH" \
   148	    --key-id "$ASC_KEY_ID" \
   149	    --issuer "$ASC_ISSUER_ID" \
   150	    "$NOTARY_LOG"
   151	
   152	xcrun stapler staple "$VERSIONED_DMG"
   153	xcrun stapler validate "$VERSIONED_DMG"
   154	codesign --verify --strict --verbose=2 "$VERSIONED_DMG"
   155	spctl -a \
   156	    -t open \
   157	    --context context:primary-signature \
   158	    -v "$VERSIONED_DMG" \
   159	    >"$DIST/ReluxProxy-$CI_COMMIT_TAG-gatekeeper.txt" 2>&1
   160	
   161	cp -p "$VERSIONED_DMG" "$DIST/ReluxProxy.dmg"
   162	cmp -s "$VERSIONED_DMG" "$DIST/ReluxProxy.dmg" ||
   163	    fail "the stable-name DMG does not match the versioned DMG"
   164	
   165	(
   166	    cd "$DIST"
   167	    shasum -a 256 \
   168	        "ReluxProxy-$CI_COMMIT_TAG-universal.dmg" \
   169	        ReluxProxy.dmg >SHA256SUMS
   170	    shasum -a 256 -c SHA256SUMS
   171	)
   172	
   173	versioned_hash_line="$(shasum -a 256 "$VERSIONED_DMG")"
   174	versioned_hash="${versioned_hash_line%% *}"
   175	architectures="$(lipo -archs "$BINARY")"
   176	cat >"$DIST/RELEASE-EVIDENCE.txt" <<EOF
   177	tag=$CI_COMMIT_TAG
   178	commit=$CI_COMMIT_SHA
