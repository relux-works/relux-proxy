+        [[ "$package_url" == "$expected_url" ]] ||
+            fail "published release asset '$name' does not target the confirmed project package"
+        [[ "$link_type" == "package" ]] ||
+            fail "published release asset '$name' does not use package link type"
+
+        index=$((index + 1))
+    done
