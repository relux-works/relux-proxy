+curl() {
+    local output=""
+    local upload=""
+    local header=""
+    local headers=""
+    local proto=""
+    local max_redirs=""
+    local write_out=""
+    local url=""
+    local status
+
+    while (($#)); do
+        case "$1" in
+            --disable | --silent | --show-error)
+                shift
+                ;;
+            --proto)
+                proto="$2"
+                shift 2
+                ;;
+            --max-redirs)
+                max_redirs="$2"
+                shift 2
+                ;;
+            --dump-header)
+                headers="$2"
+                shift 2
+                ;;
+            --output)
+                output="$2"
+                shift 2
+                ;;
+            --write-out)
+                write_out="$2"
+                shift 2
+                ;;
+            --header)
+                header="$2"
+                shift 2
+                ;;
+            --upload-file)
+                upload="$2"
+                shift 2
+                ;;
+            --location)
+                echo "stub rejected automatic redirect following" >&2
+                return 2
+                ;;
