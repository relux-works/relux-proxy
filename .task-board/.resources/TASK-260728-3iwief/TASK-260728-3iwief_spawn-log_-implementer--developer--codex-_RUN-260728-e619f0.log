diff --git a/.temp/TASK-260728-3iwief/validate-yaml.rb b/.temp/TASK-260728-3iwief/validate-yaml.rb
new file mode 100644
index 0000000000000000000000000000000000000000..1aba66006e0505d5d2cc4df26961c8d6af0beda1
--- /dev/null
+++ b/.temp/TASK-260728-3iwief/validate-yaml.rb
@@ -0,0 +1,43 @@
+require "yaml"
+
+root = ARGV.fetch(0)
+yaml_files = Dir[
+  File.join(root, ".gitlab-ci.yml"),
+  File.join(root, ".github", "**", "*.{yml,yaml}"),
+].sort
+
+raise "no YAML files found" if yaml_files.empty?
+
+yaml_files.each do |path|
+  YAML.load_file(path, aliases: true)
+end
+
+pipeline = YAML.load_file(File.join(root, ".gitlab-ci.yml"), aliases: true)
+release_job = pipeline.fetch("release_v0_2_0")
+verify_job = pipeline.fetch("verify_v0_2_0")
+
+expected_id_checks = [
+  'test -n "$RELUX_GITLAB_PROJECT_ID"',
+  'test "$CI_PROJECT_ID" = "$RELUX_GITLAB_PROJECT_ID"',
+]
+
+raise "release project-ID guard missing" unless expected_id_checks.all? {
+  |check| release_job.fetch("script").include?(check)
+}
+raise "verify project-ID guard missing" unless expected_id_checks.all? {
+  |check| verify_job.fetch("script").include?(check)
+}
+raise "release runner tags changed" unless release_job.fetch("tags") == [
+  "macos",
+  "relux-release",
+]
+raise "verify runner tags changed" unless verify_job.fetch("tags") == [
+  "macos",
+  "relux-release",
+]
+raise "release tag rule changed" unless release_job.fetch("rules").first.fetch("if") ==
+  '$CI_COMMIT_TAG == "v0.2.0"'
+raise "verify dependency changed" unless verify_job.fetch("needs").first.fetch("job") ==
+  "release_v0_2_0"
+
+puts "parsed #{yaml_files.length} YAML files and verified protected release job contracts"
diff --git a/.temp/TASK-260728-3iwief/worktree-fingerprint.py b/.temp/TASK-260728-3iwief/worktree-fingerprint.py
new file mode 100644
index 0000000000000000000000000000000000000000..7d006e0ee553a241d983f97ef94c636978811eaf
--- /dev/null
+++ b/.temp/TASK-260728-3iwief/worktree-fingerprint.py
@@ -0,0 +1,50 @@
+import hashlib
+import os
+import stat
+import subprocess
+
+
+def git_output(*arguments: str) -> bytes:
+    return subprocess.check_output(["git", *arguments])
+
+
+digest = hashlib.sha256()
+digest.update(
+    git_output(
+        "diff",
+        "--binary",
+        "HEAD",
+        "--",
+        ".",
+        ":(exclude).task-board/**",
+        ":(exclude).temp/**",
+    )
+)
+
+untracked = git_output(
+    "ls-files",
+    "--others",
+    "--exclude-standard",
+    "-z",
+    "--",
+    ".",
+    ":(exclude).task-board/**",
+    ":(exclude).temp/**",
+).split(b"\0")
+
+for raw_path in sorted(path for path in untracked if path):
+    path = os.fsdecode(raw_path)
+    file_stat = os.lstat(path)
+    digest.update(raw_path)
+    digest.update(b"\0")
+    digest.update(str(stat.S_IMODE(file_stat.st_mode)).encode("ascii"))
+    digest.update(b"\0")
+    if stat.S_ISLNK(file_stat.st_mode):
+        digest.update(os.fsencode(os.readlink(path)))
+    elif stat.S_ISREG(file_stat.st_mode):
+        with open(path, "rb") as handle:
+            for chunk in iter(lambda: handle.read(1024 * 1024), b""):
+                digest.update(chunk)
+    digest.update(b"\0")
+
+print(digest.hexdigest())
