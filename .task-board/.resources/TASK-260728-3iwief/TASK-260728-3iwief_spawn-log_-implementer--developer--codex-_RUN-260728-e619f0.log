   216	      .deletingLastPathComponent()
   217	      .deletingLastPathComponent()
   218	      .deletingLastPathComponent()
   219	  }
   220	}
   221	
   222	private struct CommandResult {
   223	  let status: Int32
   224	  let output: String
   225	}

