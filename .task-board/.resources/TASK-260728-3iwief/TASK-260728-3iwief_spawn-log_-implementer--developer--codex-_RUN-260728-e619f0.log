+#!/bin/bash
+set -euo pipefail
+
+ROOT="${1:?snapshot root is required}"
+COMMIT="$(git -C "$ROOT" rev-parse HEAD)"
+PREFLIGHT="$ROOT/scripts/gitlab-release-preflight.sh"
+
+BASE=(
+    CI_SERVER_HOST=gitlab.relux.example
+    CI_SERVER_URL=https://gitlab.relux.example
+    CI_PROJECT_PATH=relux/relux-proxy
+    CI_PROJECT_ID=42
+    CI_PROJECT_URL=https://gitlab.relux.example/relux/relux-proxy
+    CI_API_V4_URL=https://gitlab.relux.example/api/v4
+    CI_COMMIT_TAG=v0.2.0
+    CI_COMMIT_SHA="$COMMIT"
+    CI_COMMIT_REF_PROTECTED=true
+    CI_PIPELINE_SOURCE=push
+    'CI_RUNNER_TAGS=["macos", "relux-release"]'
+    RELUX_GITLAB_HOST=gitlab.relux.example
+    RELUX_GITLAB_PROJECT_PATH=relux/relux-proxy
+    RELUX_GITLAB_PROJECT_ID=42
+    RELUX_ACCEPTED_RELEASE_SHA="$COMMIT"
+)
+
+run_preflight() {
+    env "${BASE[@]}" "$@" "$PREFLIGHT"
+}
+
+expect_failure() {
+    local label="$1"
+    local expected="$2"
+    local output
+    local status
+    shift 2
+
+    set +e
+    output="$(run_preflight "$@" 2>&1)"
+    status=$?
+    set -e
+
+    [[ "$status" -ne 0 ]] || {
+        echo "unexpected pass: $label" >&2
+        exit 1
+    }
+    [[ "$output" == *"$expected"* ]] || {
+        echo "wrong failure for $label (exit $status): $output" >&2
+        exit 1
+    }
+    echo "expected failure: $label (exit $status)"
+}
+
+run_preflight
+echo "positive protected release context: exit 0"
+
+expect_failure \
+    excluded-host \
+    "explicitly excluded" \
+    CI_SERVER_HOST=gitlab.wildberries.ru \
+    CI_SERVER_URL=https://gitlab.wildberries.ru \
+    CI_PROJECT_URL=https://gitlab.wildberries.ru/relux/relux-proxy \
+    CI_API_V4_URL=https://gitlab.wildberries.ru/api/v4 \
+    RELUX_GITLAB_HOST=gitlab.wildberries.ru
+expect_failure wrong-host "confirmed Relux GitLab hostname" \
+    RELUX_GITLAB_HOST=gitlab.other.example
+expect_failure wrong-project-path "confirmed Relux namespace/project" \
+    CI_PROJECT_PATH=relux/other
+expect_failure missing-ci-project-id "CI_PROJECT_ID" CI_PROJECT_ID=
+expect_failure malformed-ci-project-id "positive numeric" \
+    CI_PROJECT_ID=project RELUX_GITLAB_PROJECT_ID=project
+expect_failure missing-protected-project-id "RELUX_GITLAB_PROJECT_ID" \
+    RELUX_GITLAB_PROJECT_ID=
+expect_failure malformed-protected-project-id "confirmed positive numeric" \
+    RELUX_GITLAB_PROJECT_ID=project
+expect_failure mismatched-project-id "confirmed Relux GitLab project ID" \
+    RELUX_GITLAB_PROJECT_ID=43
+expect_failure non-https-server "requires HTTPS" \
+    CI_SERVER_URL=http://gitlab.relux.example \
+    CI_PROJECT_URL=http://gitlab.relux.example/relux/relux-proxy \
+    CI_API_V4_URL=http://gitlab.relux.example/api/v4
+expect_failure wrong-project-url "does not identify the confirmed Relux project" \
+    CI_PROJECT_URL=https://gitlab.relux.example/relux/other
+expect_failure wrong-api-origin "not hosted by the confirmed Relux GitLab instance" \
+    CI_API_V4_URL=https://gitlab.other.example/api/v4
+expect_failure wrong-tag "only publishes v0.2.0" CI_COMMIT_TAG=v0.2.1
+expect_failure unprotected-tag "must be configured as a protected tag" \
+    CI_COMMIT_REF_PROTECTED=false
+expect_failure non-push-source "must run from a pushed protected tag" \
+    CI_PIPELINE_SOURCE=web
+expect_failure malformed-ci-sha "full 40-character commit SHA" CI_COMMIT_SHA=abc
+expect_failure missing-accepted-sha "RELUX_ACCEPTED_RELEASE_SHA" \
+    RELUX_ACCEPTED_RELEASE_SHA=
+expect_failure mismatched-accepted-sha "accepted release commit" \
+    RELUX_ACCEPTED_RELEASE_SHA=0000000000000000000000000000000000000000
+expect_failure checkout-sha-mismatch "checked-out source does not match" \
+    CI_COMMIT_SHA=1111111111111111111111111111111111111111 \
+    RELUX_ACCEPTED_RELEASE_SHA=1111111111111111111111111111111111111111
+expect_failure missing-macos-runner-tag "missing the required 'macos' tag" \
+    'CI_RUNNER_TAGS=["relux-release"]'
+expect_failure missing-release-runner-tag "missing the required 'relux-release' tag" \
+    'CI_RUNNER_TAGS=["macos"]'
+
+echo "preflight matrix: 1 positive + 20 expected failures"
