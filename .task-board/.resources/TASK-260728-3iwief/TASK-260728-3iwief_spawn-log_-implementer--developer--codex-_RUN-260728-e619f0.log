@@ -0,0 +1,13 @@
+#!/bin/bash
+set -euo pipefail
+
+ROOT="${1:?snapshot root is required}"
+count=0
+
+for script in "$ROOT"/scripts/*.sh; do
+    /bin/bash -n "$script"
+    echo "bash syntax: ${script##*/} (exit 0)"
+    count=$((count + 1))
+done
+
+echo "bash syntax matrix: $count scripts passed"
diff --git a/.temp/TASK-260728-3iwief/offline-publication-matrix.sh b/.temp/TASK-260728-3iwief/offline-publication-matrix.sh
new file mode 100644
index 0000000000000000000000000000000000000000..3421061abce2c302b66a6575599a53789424b4d0
--- /dev/null
+++ b/.temp/TASK-260728-3iwief/offline-publication-matrix.sh
@@ -0,0 +1,302 @@
+#!/bin/bash
+set -euo pipefail
+
+ROOT="${1:?snapshot root is required}"
+DIST="$ROOT/dist"
+VERSIONED="ReluxProxy-v0.2.0-universal.dmg"
+HARNESS="$ROOT/.offline-publication"
+FIXTURES="$HARNESS/fixtures"
+REGISTRY="$HARNESS/registry"
+REQUEST_LOG="$HARNESS/requested-urls.txt"
+
+mkdir -p "$DIST" "$FIXTURES" "$REGISTRY"
+
+curl() {
+    local output=""
+    local upload=""
+    local header=""
+    local headers=""
+    local proto=""
+    local max_redirs=""
+    local write_out=""
+    local url=""
+    local status
+
+    while (($#)); do
+        case "$1" in
+            --disable | --silent | --show-error)
+                shift
+                ;;
+            --proto)
+                proto="$2"
+                shift 2
+                ;;
+            --max-redirs)
+                max_redirs="$2"
+                shift 2
+                ;;
+            --dump-header)
+                headers="$2"
+                shift 2
+                ;;
+            --output)
+                output="$2"
+                shift 2
+                ;;
+            --write-out)
+                write_out="$2"
+                shift 2
+                ;;
+            --header)
+                header="$2"
+                shift 2
+                ;;
+            --upload-file)
+                upload="$2"
+                shift 2
+                ;;
+            --location)
+                echo "stub rejected automatic redirect following" >&2
+                return 2
+                ;;
+            --*)
+                echo "stub rejected unsupported curl option: $1" >&2
+                return 2
+                ;;
+            *)
+                url="$1"
+                shift
+                ;;
+        esac
+    done
+
+    [[ "$proto" == "=https" ]] || {
+        echo "stub rejected missing HTTPS-only protocol guard" >&2
+        return 2
+    }
+    [[ "$max_redirs" == "0" ]] || {
+        echo "stub rejected missing zero automatic-redirect limit" >&2
+        return 2
+    }
+    [[ "$write_out" == "%{http_code}" ]] || {
+        echo "stub rejected missing HTTP status output" >&2
+        return 2
+    }
+    [[ "$header" == "JOB-TOKEN: $CI_JOB_TOKEN" ]] || {
+        echo "stub rejected missing or mismatched JOB-TOKEN header" >&2
+        return 22
+    }
+    [[ -n "$url" ]] || {
+        echo "stub rejected missing URL" >&2
+        return 2
+    }
+    printf '%s\n' "$url" >>"$REQUEST_LOG"
+
+    local package_base="$CI_API_V4_URL/projects/$CI_PROJECT_ID/packages/generic/relux-proxy/$CI_COMMIT_TAG"
+    local release_api="$CI_API_V4_URL/projects/$CI_PROJECT_ID/releases/$CI_COMMIT_TAG"
+    local download_base="$release_api/downloads"
+
+    if [[ -n "$upload" ]]; then
+        [[ "$url" == "$package_base/"* ]] || {
+            echo "stub rejected unexpected upload URL" >&2
+            return 22
+        }
+        status="${FAKE_UPLOAD_STATUS:-201}"
+        if [[ "$status" == "201" ]]; then
+            cp "$upload" "$REGISTRY/${url##*/}"
+        fi
+        printf '%s' "$status"
+        return 0
+    fi
+
+    [[ -n "$headers" && -n "$output" ]] || {
+        echo "stub rejected incomplete download destinations" >&2
+        return 2
+    }
+    printf 'HTTP/1.1 200 OK\r\nContent-Length: 0\r\n\r\n' >"$headers"
+
+    if [[ "$url" == "$release_api" ]]; then
+        local first_url="$package_base/$VERSIONED"
+        if [[ "${FAKE_BAD_LINK:-0}" == "1" ]]; then
+            first_url="https://objects.invalid/$VERSIONED"
+        fi
+        printf \
+            '{"tag_name":"%s","commit":{"id":"%s"},"assets":{"links":[{"name":"%s","url":"%s","direct_asset_path":"/%s","link_type":"package"},{"name":"ReluxProxy.dmg","url":"%s/ReluxProxy.dmg","direct_asset_path":"/ReluxProxy.dmg","link_type":"package"},{"name":"SHA256SUMS","url":"%s/SHA256SUMS","direct_asset_path":"/SHA256SUMS","link_type":"package"}]}}\n' \
+            "${FAKE_RELEASE_TAG:-$CI_COMMIT_TAG}" \
+            "${FAKE_RELEASE_COMMIT:-$CI_COMMIT_SHA}" \
+            "$VERSIONED" \
+            "$first_url" \
+            "$VERSIONED" \
+            "$package_base" \
+            "$package_base" >"$output"
+        printf '200'
+        return 0
+    fi
+
+    if [[ "$url" == "$download_base/"* ]]; then
+        local asset="${url##*/}"
+        [[ -f "$REGISTRY/$asset" ]] || {
+            echo "stub rejected unavailable published asset" >&2
+            return 22
+        }
+        cp "$REGISTRY/$asset" "$output"
+        if [[ "${FAKE_CORRUPT_ASSET:-}" == "$asset" ]]; then
+            printf 'corruption' >>"$output"
+        fi
+        printf '200'
+        return 0
+    fi
+
+    echo "stub rejected unexpected download URL" >&2
+    return 22
+}
+export -f curl
+export REGISTRY REQUEST_LOG
+
+COMMIT="$(git -C "$ROOT" rev-parse HEAD)"
+BASE=(
+    CI_SERVER_HOST=gitlab.relux.example
+    CI_SERVER_URL=https://gitlab.relux.example
+    CI_PROJECT_PATH=relux/relux-proxy
+    CI_PROJECT_ID=42
+    CI_PROJECT_URL=https://gitlab.relux.example/relux/relux-proxy
+    CI_API_V4_URL=https://gitlab.relux.example/api/v4
+    CI_COMMIT_TAG=v0.2.0
+    CI_COMMIT_SHA="$COMMIT"
+    CI_COMMIT_REF_PROTECTED=true
+    CI_PIPELINE_SOURCE=push
+    'CI_RUNNER_TAGS=["macos", "relux-release"]'
+    RELUX_GITLAB_HOST=gitlab.relux.example
+    RELUX_GITLAB_PROJECT_PATH=relux/relux-proxy
+    RELUX_GITLAB_PROJECT_ID=42
+    RELUX_ACCEPTED_RELEASE_SHA="$COMMIT"
+)
+
+restore_dist() {
+    cp "$FIXTURES/$VERSIONED" "$DIST/$VERSIONED"
+    cp "$FIXTURES/ReluxProxy.dmg" "$DIST/ReluxProxy.dmg"
+    cp "$FIXTURES/SHA256SUMS" "$DIST/SHA256SUMS"
+}
+
+restore_registry() {
+    cp "$FIXTURES/$VERSIONED" "$REGISTRY/$VERSIONED"
+    cp "$FIXTURES/ReluxProxy.dmg" "$REGISTRY/ReluxProxy.dmg"
+    cp "$FIXTURES/SHA256SUMS" "$REGISTRY/SHA256SUMS"
+}
+
+# shellcheck disable=SC2120
+run_upload() {
+    env "${BASE[@]}" CI_JOB_TOKEN=synthetic-offline-token "$@" \
+        "$ROOT/scripts/upload-gitlab-release-assets.sh"
+}
+
+# shellcheck disable=SC2120
+run_verify() {
+    env "${BASE[@]}" CI_JOB_TOKEN=synthetic-offline-token "$@" \
+        "$ROOT/scripts/verify-gitlab-release.sh"
+}
+
+expect_failure() {
+    local label="$1"
+    local expected="$2"
+    local output
+    local status
+    shift 2
+
+    set +e
+    output="$("$@" 2>&1)"
+    status=$?
+    set -e
+
+    [[ "$status" -ne 0 ]] || {
+        echo "unexpected pass: $label" >&2
+        exit 1
+    }
+    [[ "$output" == *"$expected"* ]] || {
+        echo "wrong failure for $label (exit $status): $output" >&2
+        exit 1
+    }
+    echo "expected failure: $label (exit $status)"
+}
+
+cp /bin/echo "$FIXTURES/$VERSIONED"
+cp "$FIXTURES/$VERSIONED" "$FIXTURES/ReluxProxy.dmg"
+(
+    cd "$FIXTURES"
+    shasum -a 256 "$VERSIONED" ReluxProxy.dmg >SHA256SUMS
+)
+restore_dist
+rm -f "$REQUEST_LOG"
+
+# shellcheck disable=SC2119
+run_upload
+[[ -s "$REGISTRY/$VERSIONED" ]]
+[[ -s "$REGISTRY/ReluxProxy.dmg" ]]
+[[ -s "$REGISTRY/SHA256SUMS" ]]
+[[ "$(wc -l <"$REQUEST_LOG")" -eq 3 ]]
+echo "offline upload positive: exit 0"
+
+upload_calls_before="$(wc -l <"$REQUEST_LOG")"
+expect_failure upload-missing-token "CI_JOB_TOKEN is required" run_upload CI_JOB_TOKEN=
+
+mv "$DIST/ReluxProxy.dmg" "$DIST/ReluxProxy.dmg.saved"
+expect_failure upload-missing-asset "missing or empty" run_upload
+mv "$DIST/ReluxProxy.dmg.saved" "$DIST/ReluxProxy.dmg"
+
+printf 'corruption' >>"$DIST/$VERSIONED"
+expect_failure upload-bad-checksum "FAILED" run_upload
+restore_dist
+
+cp /bin/cat "$DIST/ReluxProxy.dmg"
+(
+    cd "$DIST"
+    shasum -a 256 "$VERSIONED" ReluxProxy.dmg >SHA256SUMS
+)
+expect_failure upload-divergent-aliases "stable and versioned DMGs differ" run_upload
+restore_dist
+[[ "$(wc -l <"$REQUEST_LOG")" -eq "$upload_calls_before" ]]
+
+expect_failure upload-redirect-status "unexpected HTTP status '302'" \
+    run_upload FAKE_UPLOAD_STATUS=302
+echo "upload fail-closed matrix: 1 positive + 5 expected failures"
+
+restore_registry
+rm -f "$REQUEST_LOG"
+# shellcheck disable=SC2119
+run_verify
+release_api="https://gitlab.relux.example/api/v4/projects/42/releases/v0.2.0"
+grep -Fqx "$release_api" "$REQUEST_LOG"
+for asset in "$VERSIONED" ReluxProxy.dmg SHA256SUMS; do
+    grep -Fqx "$release_api/downloads/$asset" "$REQUEST_LOG"
+done
+if grep -Fq '/-/releases/' "$REQUEST_LOG"; then
+    echo "browser-style release route reached by verifier" >&2
+    exit 1
+fi
+echo "offline verification positive: exit 0"
+
+expect_failure verify-missing-token "CI_JOB_TOKEN is required" run_verify CI_JOB_TOKEN=
+expect_failure verify-wrong-tag "published release tag" run_verify \
+    FAKE_RELEASE_TAG=v0.2.1
+expect_failure verify-wrong-commit "accepted commit" run_verify \
+    FAKE_RELEASE_COMMIT=0000000000000000000000000000000000000000
+expect_failure verify-wrong-package-link "confirmed project package" run_verify \
+    FAKE_BAD_LINK=1
+
+printf '\nchanged\n' >>"$REGISTRY/SHA256SUMS"
+expect_failure verify-changed-checksum-file "differs from the CI-produced" run_verify
+restore_registry
+
+expect_failure verify-corrupted-download "FAILED" run_verify \
+    FAKE_CORRUPT_ASSET="$VERSIONED"
+
+cp /bin/cat "$REGISTRY/ReluxProxy.dmg"
+(
+    cd "$REGISTRY"
+    shasum -a 256 "$VERSIONED" ReluxProxy.dmg >SHA256SUMS
+)
+cp "$REGISTRY/SHA256SUMS" "$DIST/SHA256SUMS"
+expect_failure verify-divergent-aliases "published stable-name DMG differs" run_verify
+restore_dist
+restore_registry
+echo "verification fail-closed matrix: 1 positive + 7 expected failures"
