    63	
    64	[[ "$CI_PIPELINE_IID" =~ ^[1-9][0-9]*$ ]] ||
    65	    fail "CI_PIPELINE_IID must be a positive integer"
    66	
    67	SIGN_IDENTITY="${DEVELOPER_ID_APPLICATION:-$EXPECTED_SIGN_IDENTITY}"
    68	[[ "$SIGN_IDENTITY" == "$EXPECTED_SIGN_IDENTITY" ]] ||
    69	    fail "the configured Developer ID is not the Relux Works release identity"
    70	
    71	TEMP_ROOT="${TMPDIR:-/tmp}"
    72	TEMP_ROOT="${TEMP_ROOT%/}"
    73	RELEASE_TEMP="$(mktemp -d "$TEMP_ROOT/relux-proxy-release.XXXXXX")"
    74	KEYCHAIN_PATH="$RELEASE_TEMP/relux-release.keychain-db"
    75	CERTIFICATE_PATH="$RELEASE_TEMP/relux-developer-id.p12"
    76	NOTARY_KEY_PATH="$RELEASE_TEMP/AuthKey_$ASC_KEY_ID.p8"
    77	
    78	printf '%s' "$MACOS_CERT_P12_B64" | /usr/bin/base64 --decode >"$CERTIFICATE_PATH"
    79	printf '%s' "$ASC_KEY_P8_B64" | /usr/bin/base64 --decode >"$NOTARY_KEY_PATH"
    80	chmod 600 "$CERTIFICATE_PATH" "$NOTARY_KEY_PATH"
    81	[[ -s "$CERTIFICATE_PATH" ]] || fail "decoded Developer ID certificate is empty"
    82	[[ -s "$NOTARY_KEY_PATH" ]] || fail "decoded App Store Connect key is empty"
    83	
    84	security create-keychain -p "$MACOS_KEYCHAIN_PASSWORD" "$KEYCHAIN_PATH"
    85	security set-keychain-settings -lut 21600 "$KEYCHAIN_PATH"
    86	security unlock-keychain -p "$MACOS_KEYCHAIN_PASSWORD" "$KEYCHAIN_PATH"
    87	security import "$CERTIFICATE_PATH" \
