   184	notarization_status=$notary_status
   185	notarization_submission_id=$submission_id
   186	versioned_dmg_sha256=$versioned_hash
   187	EOF
   188	
   189	echo "Created signed, notarized, stapled, Gatekeeper-approved $VERSIONED_DMG"
     1	#!/bin/bash
     2	set -euo pipefail
     3	
     4	ROOT="$(cd "$(dirname "$0")/.." && pwd)"
     5	VERSION="${VERSION:-0.1.0-dev}"
     6	VERSION="${VERSION#v}"
     7	SHORT_VERSION="${VERSION%%-*}"
     8	BUILD_NUMBER="${BUILD_NUMBER:-$(git -C "$ROOT" rev-list --count HEAD 2>/dev/null || echo 1)}"
     9	APP_NAME="ReluxProxy"
    10	BUNDLE="$ROOT/dist/$APP_NAME.app"
    11	SIGN_IDENTITY="${SIGN_IDENTITY:-Developer ID Application: Relux Works, LLC (262RZ595FP)}"
    12	SIGN_KEYCHAIN="${SIGN_KEYCHAIN:-}"
    13	REQUIRE_DEVELOPER_ID="${REQUIRE_DEVELOPER_ID:-0}"
    14	
    15	if [[ "$REQUIRE_DEVELOPER_ID" != "0" && "$REQUIRE_DEVELOPER_ID" != "1" ]]; then
    16	    echo "error: REQUIRE_DEVELOPER_ID must be 0 or 1" >&2
    17	    exit 1
    18	fi
    19	if [[ "$REQUIRE_DEVELOPER_ID" == "1" && "$SIGN_IDENTITY" == "-" ]]; then
    20	    echo "error: an ad-hoc signature is forbidden for a production release" >&2
    21	    exit 1
    22	fi
    23	
    24	cd "$ROOT"
    25	rm -rf "$BUNDLE"
    26	mkdir -p "$BUNDLE/Contents/MacOS" "$BUNDLE/Contents/Resources"
    27	
    28	BUILD_ARGUMENTS=(-c release)
    29	if [[ "${UNIVERSAL:-1}" == "1" ]]; then
    30	    BUILD_ARGUMENTS+=(--arch arm64 --arch x86_64)
    31	fi
    32	
    33	swift build "${BUILD_ARGUMENTS[@]}"
    34	BIN_DIR="$(swift build "${BUILD_ARGUMENTS[@]}" --show-bin-path)"
    35	cp "$BIN_DIR/ReluxProxy" "$BUNDLE/Contents/MacOS/ReluxProxy"
    36	cp "$ROOT/Resources/Info.plist" "$BUNDLE/Contents/Info.plist"
    37	swift "$ROOT/scripts/generate-icon.swift" "$BUNDLE/Contents/Resources/ReluxProxy.icns"
    38	
    39	/usr/libexec/PlistBuddy -c "Set :CFBundleShortVersionString $SHORT_VERSION" "$BUNDLE/Contents/Info.plist"
    40	/usr/libexec/PlistBuddy -c "Set :CFBundleVersion $BUILD_NUMBER" "$BUNDLE/Contents/Info.plist"
    41	
    42	SIGNING_IDENTITIES=""
    43	if [[ "$SIGN_IDENTITY" != "-" ]]; then
    44	    if [[ -n "$SIGN_KEYCHAIN" ]]; then
    45	        SIGNING_IDENTITIES="$(security find-identity -v -p codesigning "$SIGN_KEYCHAIN")"
    46	    else
    47	        SIGNING_IDENTITIES="$(security find-identity -v -p codesigning)"
    48	    fi
    49	fi
    50	
    51	if [[ "$SIGN_IDENTITY" == "-" ]]; then
    52	    codesign --force --sign - "$BUNDLE"
    53	elif grep -Fq "$SIGN_IDENTITY" <<<"$SIGNING_IDENTITIES"; then
    54	    if [[ -n "$SIGN_KEYCHAIN" ]]; then
    55	        codesign --force --options runtime --timestamp --sign "$SIGN_IDENTITY" \
    56	            --keychain "$SIGN_KEYCHAIN" "$BUNDLE"
    57	    else
    58	        codesign --force --options runtime --timestamp --sign "$SIGN_IDENTITY" "$BUNDLE"
    59	    fi
    60	elif [[ "$REQUIRE_DEVELOPER_ID" == "1" ]]; then
    61	    echo "error: required signing identity '$SIGN_IDENTITY' was not found" >&2
    62	    exit 1
    63	else
    64	    echo "warning: '$SIGN_IDENTITY' not found; using an ad-hoc signature" >&2
    65	    codesign --force --sign - "$BUNDLE"
    66	fi
    67	
    68	codesign --verify --deep --strict --verbose=2 "$BUNDLE"
    69	echo "Built $BUNDLE ($VERSION, build $BUILD_NUMBER)"

