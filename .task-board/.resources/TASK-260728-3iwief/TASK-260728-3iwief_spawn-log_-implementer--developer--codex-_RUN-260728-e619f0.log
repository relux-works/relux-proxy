+trap cleanup EXIT
+
+url_origin() {
+    local url="$1"
+    local remainder
+    local authority
+
+    case "$url" in
+        https://*) ;;
+        *) return 1 ;;
+    esac
+    if [[ "$url" =~ [[:space:][:cntrl:]] ]] ||
+        [[ "$url" == *\\* || "$url" == *"#"* ]]; then
+        return 1
+    fi
+
+    remainder="${url#https://}"
+    authority="${remainder%%[/?#]*}"
+    [[ -n "$authority" && "$authority" != *"@"* ]] || return 1
+    printf 'https://%s' "$authority"
