   171	  private func currentCommit() throws -> String {
   172	    let result = try run(
   173	      executable: "/usr/bin/git",
   174	      arguments: ["rev-parse", "HEAD"]
   175	    )
   176	    #expect(result.status == 0, "git output: \(result.output)")
   177	    return result.output.trimmingCharacters(in: .whitespacesAndNewlines)
   178	  }
   179	
   180	  private func run(
   181	    executable: String,
   182	    arguments: [String],
   183	    environment: [String: String] = [:]
   184	  ) throws -> CommandResult {
   185	    let process = Process()
   186	    let output = Pipe()
   187	
   188	    process.executableURL = URL(fileURLWithPath: executable)
   189	    process.arguments = arguments
   190	    process.currentDirectoryURL = repositoryRoot
   191	    process.standardOutput = output
   192	    process.standardError = output
   193	    process.environment = ProcessInfo.processInfo.environment.merging(environment) {
   194	      _, replacement in replacement
   195	    }
   196	
   197	    try process.run()
   198	    process.waitUntilExit()
   199	
   200	    let data = output.fileHandleForReading.readDataToEndOfFile()
   201	    return CommandResult(
   202	      status: process.terminationStatus,
   203	      output: String(decoding: data, as: UTF8.self)
   204	    )
   205	  }
   206	
   207	  private func repositoryContents(at relativePath: String) throws -> String {
