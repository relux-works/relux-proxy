+validate_release_assets "$VERIFY_DIR/release.json"
 
 DIRECT_DOWNLOAD_BASE="$CI_API_V4_URL/projects/$CI_PROJECT_ID/releases/$CI_COMMIT_TAG/downloads"
 for asset in "${ASSETS[@]}"; do
-    curl \
