 mkdir -p "$VERIFY_DIR"
+TEMP_ROOT="${TMPDIR:-/tmp}"
+TEMP_ROOT="${TEMP_ROOT%/}"
+REQUEST_TEMP="$(mktemp -d "$TEMP_ROOT/relux-release-verification.XXXXXX")"
 
 RELEASE_API="$CI_API_V4_URL/projects/$CI_PROJECT_ID/releases/$CI_COMMIT_TAG"
