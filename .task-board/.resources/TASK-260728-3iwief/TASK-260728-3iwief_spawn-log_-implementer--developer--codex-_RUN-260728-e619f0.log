diff --git a/.temp/TASK-260728-3iwief/release-guard-matrix.sh b/.temp/TASK-260728-3iwief/release-guard-matrix.sh
new file mode 100644
index 0000000000000000000000000000000000000000..1fa7e868136aeef3454f389d24cfbb764687dad3
--- /dev/null
+++ b/.temp/TASK-260728-3iwief/release-guard-matrix.sh
@@ -0,0 +1,73 @@
+#!/bin/bash
+set -euo pipefail
+
+ROOT="${1:?snapshot root is required}"
+COMMIT="$(git -C "$ROOT" rev-parse HEAD)"
+
+BASE=(
+    CI_SERVER_HOST=gitlab.relux.example
+    CI_SERVER_URL=https://gitlab.relux.example
+    CI_PROJECT_PATH=relux/relux-proxy
+    CI_PROJECT_ID=42
+    CI_PROJECT_URL=https://gitlab.relux.example/relux/relux-proxy
+    CI_API_V4_URL=https://gitlab.relux.example/api/v4
+    CI_COMMIT_TAG=v0.2.0
+    CI_COMMIT_SHA="$COMMIT"
+    CI_COMMIT_REF_PROTECTED=true
+    CI_PIPELINE_SOURCE=push
+    'CI_RUNNER_TAGS=["macos", "relux-release"]'
+    RELUX_GITLAB_HOST=gitlab.relux.example
+    RELUX_GITLAB_PROJECT_PATH=relux/relux-proxy
+    RELUX_GITLAB_PROJECT_ID=42
+    RELUX_ACCEPTED_RELEASE_SHA="$COMMIT"
+)
+
+expect_failure() {
+    local label="$1"
+    local expected="$2"
+    local output
+    local status
+    shift 2
+
+    set +e
+    output="$("$@" 2>&1)"
+    status=$?
+    set -e
+
+    [[ "$status" -ne 0 ]] || {
+        echo "unexpected pass: $label" >&2
+        exit 1
+    }
+    [[ "$output" == *"$expected"* ]] || {
+        echo "wrong failure for $label (exit $status): $output" >&2
+        exit 1
+    }
+    echo "expected failure: $label (exit $status)"
+}
+
+expect_failure invalid-signing-mode "must be 0 or 1" \
+    env REQUIRE_DEVELOPER_ID=2 "$ROOT/scripts/build-app.sh"
+expect_failure production-ad-hoc-signature "ad-hoc signature is forbidden" \
+    env REQUIRE_DEVELOPER_ID=1 SIGN_IDENTITY=- "$ROOT/scripts/build-app.sh"
+expect_failure missing-required-identity "required signing identity" \
+    env \
+    REQUIRE_DEVELOPER_ID=1 \
+    SIGN_IDENTITY="Developer ID Application: Missing Identity (AAAAAAAAAA)" \
+    UNIVERSAL=0 \
+    "$ROOT/scripts/build-app.sh"
+expect_failure missing-release-variables "CI_PIPELINE_IID" \
+    env "${BASE[@]}" "$ROOT/scripts/release-macos.sh"
+expect_failure wrong-developer-id "not the Relux Works release identity" \
+    env \
+    "${BASE[@]}" \
+    CI_PIPELINE_IID=1 \
+    MACOS_CERT_P12_B64=c3ludGhldGlj \
+    MACOS_CERT_PASSWORD=synthetic \
+    MACOS_KEYCHAIN_PASSWORD=synthetic \
+    ASC_KEY_ID=SYNTHETIC \
+    ASC_ISSUER_ID=00000000-0000-0000-0000-000000000000 \
+    ASC_KEY_P8_B64=c3ludGhldGlj \
+    DEVELOPER_ID_APPLICATION="Developer ID Application: Other (AAAAAAAAAA)" \
+    "$ROOT/scripts/release-macos.sh"
+
+echo "release entry/signing guard matrix: 5 expected failures"
