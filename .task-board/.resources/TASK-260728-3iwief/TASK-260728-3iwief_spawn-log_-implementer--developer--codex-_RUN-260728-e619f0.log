   150	      executable: "/bin/bash",
   151	      arguments: ["scripts/gitlab-release-preflight.sh"],
   152	      environment: [
   153	        "CI_SERVER_HOST": host,
   154	        "CI_SERVER_URL": "https://\(host)",
   155	        "CI_PROJECT_PATH": projectPath,
   156	        "CI_PROJECT_ID": "42",
   157	        "CI_PROJECT_URL": "https://\(host)/\(projectPath)",
   158	        "CI_API_V4_URL": "https://\(host)/api/v4",
   159	        "CI_COMMIT_TAG": "v0.2.0",
   160	        "CI_COMMIT_SHA": commit,
   161	        "CI_COMMIT_REF_PROTECTED": "true",
   162	        "CI_PIPELINE_SOURCE": "push",
   163	        "CI_RUNNER_TAGS": #"["macos", "relux-release"]"#,
   164	        "RELUX_GITLAB_HOST": expectedHost,
   165	        "RELUX_GITLAB_PROJECT_PATH": projectPath,
   166	        "RELUX_ACCEPTED_RELEASE_SHA": acceptedCommit ?? commit,
   167	      ]
   168	    )
   169	  }
