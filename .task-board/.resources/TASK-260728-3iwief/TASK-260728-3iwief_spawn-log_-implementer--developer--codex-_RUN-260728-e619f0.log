-        --output "$VERIFY_DIR/$asset" \
-        "$DIRECT_DOWNLOAD_BASE/$asset"
+    fetch_release_asset "$DIRECT_DOWNLOAD_BASE/$asset" "$VERIFY_DIR/$asset"
 done
 
