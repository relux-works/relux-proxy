+    RELUX_GITLAB_PROJECT_PATH=relux/relux-proxy
+    RELUX_GITLAB_PROJECT_ID=42
+    RELUX_ACCEPTED_RELEASE_SHA="$COMMIT"
+)
+
+expect_failure() {
+    local label="$1"
+    local expected="$2"
+    local output
+    local status
+    shift 2
+
+    set +e
+    output="$("$@" 2>&1)"
+    status=$?
+    set -e
+
+    [[ "$status" -ne 0 ]] || {
+        echo "unexpected pass: $label" >&2
+        exit 1
+    }
+    [[ "$output" == *"$expected"* ]] || {
