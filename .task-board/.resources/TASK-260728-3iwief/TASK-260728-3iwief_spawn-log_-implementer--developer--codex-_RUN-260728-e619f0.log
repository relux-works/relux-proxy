diff --git a/.temp/TASK-260728-3iwief/preflight-matrix.sh b/.temp/TASK-260728-3iwief/preflight-matrix.sh
new file mode 100644
index 0000000000000000000000000000000000000000..5602c36411f573d9befb062a50eda6d3348e8643
--- /dev/null
+++ b/.temp/TASK-260728-3iwief/preflight-matrix.sh
@@ -0,0 +1,103 @@
+#!/bin/bash
+set -euo pipefail
+
+ROOT="${1:?snapshot root is required}"
+COMMIT="$(git -C "$ROOT" rev-parse HEAD)"
+PREFLIGHT="$ROOT/scripts/gitlab-release-preflight.sh"
+
+BASE=(
+    CI_SERVER_HOST=gitlab.relux.example
+    CI_SERVER_URL=https://gitlab.relux.example
+    CI_PROJECT_PATH=relux/relux-proxy
+    CI_PROJECT_ID=42
+    CI_PROJECT_URL=https://gitlab.relux.example/relux/relux-proxy
+    CI_API_V4_URL=https://gitlab.relux.example/api/v4
+    CI_COMMIT_TAG=v0.2.0
+    CI_COMMIT_SHA="$COMMIT"
+    CI_COMMIT_REF_PROTECTED=true
+    CI_PIPELINE_SOURCE=push
+    'CI_RUNNER_TAGS=["macos", "relux-release"]'
+    RELUX_GITLAB_HOST=gitlab.relux.example
+    RELUX_GITLAB_PROJECT_PATH=relux/relux-proxy
+    RELUX_GITLAB_PROJECT_ID=42
+    RELUX_ACCEPTED_RELEASE_SHA="$COMMIT"
+)
+
+run_preflight() {
+    env "${BASE[@]}" "$@" "$PREFLIGHT"
+}
+
+expect_failure() {
+    local label="$1"
+    local expected="$2"
+    local output
+    local status
+    shift 2
+
+    set +e
+    output="$(run_preflight "$@" 2>&1)"
+    status=$?
+    set -e
+
+    [[ "$status" -ne 0 ]] || {
+        echo "unexpected pass: $label" >&2
+        exit 1
+    }
+    [[ "$output" == *"$expected"* ]] || {
+        echo "wrong failure for $label (exit $status): $output" >&2
+        exit 1
+    }
+    echo "expected failure: $label (exit $status)"
+}
+
+run_preflight
+echo "positive protected release context: exit 0"
+
+expect_failure \
+    excluded-host \
+    "explicitly excluded" \
+    CI_SERVER_HOST=gitlab.wildberries.ru \
+    CI_SERVER_URL=https://gitlab.wildberries.ru \
+    CI_PROJECT_URL=https://gitlab.wildberries.ru/relux/relux-proxy \
+    CI_API_V4_URL=https://gitlab.wildberries.ru/api/v4 \
+    RELUX_GITLAB_HOST=gitlab.wildberries.ru
+expect_failure wrong-host "confirmed Relux GitLab hostname" \
+    RELUX_GITLAB_HOST=gitlab.other.example
+expect_failure wrong-project-path "confirmed Relux namespace/project" \
+    CI_PROJECT_PATH=relux/other
+expect_failure missing-ci-project-id "CI_PROJECT_ID" CI_PROJECT_ID=
