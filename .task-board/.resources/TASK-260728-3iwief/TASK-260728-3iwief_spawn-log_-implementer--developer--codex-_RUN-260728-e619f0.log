 for asset in "${ASSETS[@]}"; do
-    curl \
-        --fail-with-body \
-        --silent \
-        --show-error \
-        --location \
-        --header "JOB-TOKEN: $CI_JOB_TOKEN" \
-        --output "$VERIFY_DIR/$asset" \
-        "$DIRECT_DOWNLOAD_BASE/$asset"
