+    done
+    while [[ "$value" == *" " || "$value" == *$'\t' ]]; do
+        value="${value%?}"
+    done
+    printf '%s' "$value"
+}
+
+extract_redirect_location() {
+    local headers="$1"
+    local line
+    local header_name
+    local value
+    local location=""
+    local count=0
+
+    while IFS= read -r line || [[ -n "$line" ]]; do
+        line="${line%$'\r'}"
+        [[ "$line" == *":"* ]] || continue
+        header_name="${line%%:*}"
+        header_name="$(printf '%s' "$header_name" | tr '[:upper:]' '[:lower:]')"
+        if [[ "$header_name" == "location" ]]; then
+            value="$(trim_http_value "${line#*:}")"
