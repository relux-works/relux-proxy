+    case "$1" in
+        --output)
+            output="$2"
+            shift 2
+            ;;
+        --upload-file)
+            upload_file="$2"
+            shift 2
+            ;;
+        --header)
+            [[ "${2:-}" == "JOB-TOKEN: "* ]] && job_token_seen=1
+            shift 2
+            ;;
+        --fail-with-body|--silent|--show-error|--location)
+            shift
+            ;;
+        *)
+            url="$1"
+            shift
+            ;;
+    esac
+done
+
+[[ "$job_token_seen" == "1" ]] || {
+    echo "stub error: missing JOB-TOKEN header" >&2
+    exit 1
+}
+[[ -n "$url" ]] || {
+    echo "stub error: missing request URL" >&2
+    exit 1
+}
+[[ "$url" != *"/-/releases/"* ]] || {
+    echo "stub error: browser release URLs are not valid job-token API targets" >&2
+    exit 1
+}
+
+printf '%s\n' "$url" >>"${CURL_STUB_LOG:?}"
+
+release_api="${CI_API_V4_URL}/projects/${CI_PROJECT_ID}/releases/${CI_COMMIT_TAG}"
+direct_download_base="${release_api}/downloads"
+package_base="${CI_API_V4_URL}/projects/${CI_PROJECT_ID}/packages/generic/relux-proxy/${CI_COMMIT_TAG}"
+
+if [[ -n "$upload_file" ]]; then
+    [[ -s "$upload_file" ]] || {
+        echo "stub error: upload source is missing" >&2
+        exit 1
+    }
+    [[ "$url" == "$package_base/"* ]] || {
+        echo "stub error: upload used an unexpected URL" >&2
+        exit 1
+    }
+    exit 0
+fi
+
+if [[ "$url" == "$release_api" ]]; then
+    [[ -n "$output" ]] || {
+        echo "stub error: release API response needs an output file" >&2
+        exit 1
+    }
+    cp "${CURL_STUB_RELEASE_JSON:?}" "$output"
+    exit 0
+fi
+
+if [[ "$url" == "$direct_download_base/"* ]]; then
+    asset="${url##*/}"
+    [[ -n "$output" && -s "${CURL_STUB_ASSET_DIR:?}/$asset" ]] || {
+        echo "stub error: published asset fixture is missing" >&2
+        exit 1
+    }
+    cp "${CURL_STUB_ASSET_DIR}/$asset" "$output"
+    exit 0
+fi
+
+echo "stub error: request used an unexpected URL" >&2
+exit 1
