+            shift
+            ;;
+        --proto)
+            proto="$2"
+            shift 2
+            ;;
+        --max-redirs)
+            max_redirs="$2"
+            shift 2
+            ;;
+        --output | --write-out)
+            shift 2
+            ;;
+        --header)
+            header="$2"
+            shift 2
+            ;;
