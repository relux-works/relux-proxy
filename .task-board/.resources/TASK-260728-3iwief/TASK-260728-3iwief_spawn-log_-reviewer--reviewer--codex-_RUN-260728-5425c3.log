+#!/bin/bash
+set -euo pipefail
+
+REVIEW_ROOT="$(cd "$(dirname "$0")" && pwd)"
+SNAPSHOT_ROOT="$REVIEW_ROOT/current-snapshot"
+BUILD_APP="$SNAPSHOT_ROOT/scripts/build-app.sh"
+RELEASE="$SNAPSHOT_ROOT/scripts/release-macos.sh"
+COMMIT="$(git -C "$SNAPSHOT_ROOT" rev-parse HEAD)"
+
+chmod 0755 "$REVIEW_ROOT/fake-security-bin/security"
+
+PREFLIGHT_ENV=(
+    "PATH=$PATH"
+    "TMPDIR=$REVIEW_ROOT/tmp"
+    "CI_SERVER_HOST=gitlab.relux.example"
+    "CI_SERVER_URL=https://gitlab.relux.example"
+    "CI_PROJECT_PATH=relux/relux-proxy"
+    "CI_PROJECT_ID=42"
+    "CI_PROJECT_URL=https://gitlab.relux.example/relux/relux-proxy"
+    "CI_API_V4_URL=https://gitlab.relux.example/api/v4"
+    "CI_COMMIT_TAG=v0.2.0"
+    "CI_COMMIT_SHA=$COMMIT"
+    "CI_COMMIT_REF_PROTECTED=true"
+    "CI_PIPELINE_SOURCE=push"
+    "CI_RUNNER_TAGS=[\"macos\", \"relux-release\"]"
+    "RELUX_GITLAB_HOST=gitlab.relux.example"
+    "RELUX_GITLAB_PROJECT_PATH=relux/relux-proxy"
+    "RELUX_GITLAB_PROJECT_ID=42"
+    "RELUX_ACCEPTED_RELEASE_SHA=$COMMIT"
+)
+
+run_failure() {
+    local label="$1"
+    local expected_text="$2"
+    shift 2
+
+    local output
+    local status
+    set +e
+    output="$("$@" 2>&1)"
+    status=$?
+    set -e
+
+    if [[ "$status" -ne 1 || "$output" != *"$expected_text"* ]]; then
+        printf 'FAIL case=%s status=%s missing=%s output=%s\n' \
+            "$label" "$status" "$expected_text" "$output" >&2
+        exit 1
+    fi
+    printf 'PASS case=%s status=%s\n' "$label" "$status"
+}
+
+run_failure invalid-signing-mode "REQUIRE_DEVELOPER_ID must be 0 or 1" \
+    env -i "PATH=$PATH" "REQUIRE_DEVELOPER_ID=2" /bin/bash "$BUILD_APP"
+
+run_failure production-adhoc "ad-hoc signature is forbidden" \
+    env -i "PATH=$PATH" "SIGN_IDENTITY=-" "REQUIRE_DEVELOPER_ID=1" \
+    /bin/bash "$BUILD_APP"
+
+run_failure missing-required-identity "required signing identity" \
+    env -i "PATH=$REVIEW_ROOT/fake-security-bin:$PATH" \
+    "SIGN_IDENTITY=Developer ID Application: Relux Works, LLC (262RZ595FP)" \
+    "REQUIRE_DEVELOPER_ID=1" "UNIVERSAL=0" \
+    /bin/bash "$BUILD_APP"
+
+run_failure missing-release-variable "CI_PIPELINE_IID" \
+    env -i "${PREFLIGHT_ENV[@]}" /bin/bash "$RELEASE"
+
+run_failure wrong-developer-id "not the Relux Works release identity" \
+    env -i "${PREFLIGHT_ENV[@]}" \
+    "CI_PIPELINE_IID=1" \
+    "MACOS_CERT_P12_B64=synthetic" \
+    "MACOS_CERT_PASSWORD=synthetic" \
+    "MACOS_KEYCHAIN_PASSWORD=synthetic" \
+    "ASC_KEY_ID=synthetic" \
+    "ASC_ISSUER_ID=synthetic" \
+    "ASC_KEY_P8_B64=synthetic" \
+    "DEVELOPER_ID_APPLICATION=Developer ID Application: Other (0000000000)" \
+    /bin/bash "$RELEASE"
+
+printf 'release_guard_matrix=pass negatives=5\n'
