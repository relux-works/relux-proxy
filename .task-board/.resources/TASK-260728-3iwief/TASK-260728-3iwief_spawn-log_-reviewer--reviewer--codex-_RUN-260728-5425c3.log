   429	private struct RedirectExecution {
   430	  let result: RedirectCommandResult
   431	  let gitLabRequests: String
   432	  let externalRequests: String
   433	}
   434	
   435	private struct RedirectCommandResult {
   436	  let status: Int32
   437	  let output: String
   438	}
   439	
   440	private enum RedirectFixtureError: Error {
   441	  case setup(String)
   442	}
   443	
   444	private func runRedirectCommand(
   445	  executable: String,
   446	  arguments: [String],
   447	  environment: [String: String] = [:],
   448	  currentDirectory: URL? = nil
   449	) throws -> RedirectCommandResult {
   450	  let process = Process()
   451	  let output = Pipe()
   452	
   453	  process.executableURL = URL(fileURLWithPath: executable)
   454	  process.arguments = arguments
   455	  process.currentDirectoryURL = currentDirectory
   456	  process.standardOutput = output
   457	  process.standardError = output
   458	  process.environment = ProcessInfo.processInfo.environment.merging(environment) {
   459	    _, replacement in replacement
   460	  }
   461	
   462	  try process.run()
   463	  process.waitUntilExit()
   464	
   465	  let data = output.fileHandleForReading.readDataToEndOfFile()
   466	  return RedirectCommandResult(
   467	    status: process.terminationStatus,
   468	    output: String(decoding: data, as: UTF8.self)
   469	  )
   470	}
     1	# GitLab macOS release runbook
     2	
     3	This runbook is the production path for Relux Proxy v0.2.0. It deliberately
     4	fails closed until the Relux-owned GitLab project, accepted commit, protected
     5	runner, and Apple credentials are all present.
     6	
     7	## Current external blocker
     8	
     9	As of 2026-07-28, the production release target is not confirmed:
    10	
    11	| Required identity | Current evidence |
    12	| --- | --- |
    13	| GitLab hostname | Not supplied. `gitlab.com` has no usable local API or SSH authorization. |
    14	| Namespace/project | Not supplied. The only repository remote is `git@github.com:relux-works/relux-proxy.git`. |
    15	| GitLab project ID | Not supplied. |
    16	| Authorized release account | Not supplied. |
    17	| Protected macOS release runner | Not discoverable without the target project. |
    18	| Notarization credentials in GitLab | Not discoverable without the target project. |
    19	
    20	`gitlab.wildberries.ru` is explicitly unrelated and prohibited for every
    21	Relux source push, tag, package, and Release operation. A credential happens to
    22	exist for that host on one development machine; its presence is not
    23	authorization to use it.
    24	
    25	Do not add a GitLab remote, push source, create a tag, or run a release until a
    26	Relux owner replaces the unknown fields above with the exact hostname,
    27	namespace/project, project ID, and authorized account in reviewed project
    28	documentation.
    29	
    30	## One-time project and runner setup
    31	
    32	1. Confirm that the hostname and full namespace/project are owned by Relux.
    33	   Confirm the project ID through the same project page or API and record the
    34	   authorized operator.
    35	2. Enable the project Package Registry and CI/CD.
    36	3. Register a project-locked macOS runner using GitLab's supported user-mode
    37	   `LaunchAgent` and shell executor. Give it both `macos` and `relux-release`
    38	   tags, disable untagged jobs, mark it protected, and do not share it with
    39	   untrusted projects. The runner needs Xcode, Swift, `glab`, `shellcheck`,
    40	   Python 3, OpenSSL, and the standard macOS signing tools.
    41	4. Protect the `v0.2.0` tag so only the release owner can create it.
    42	5. Protect the `production` environment and require the project's chosen
    43	   release approval.
    44	6. Store the following project CI/CD variables. Secret values must be
    45	   **Masked and hidden**, **Protected**, and have variable expansion disabled:
    46	
    47	   | Variable | Handling |
    48	   | --- | --- |
    49	   | `MACOS_CERT_P12_B64` | Base64-encoded Relux Works Developer ID Application certificate plus private key. Secret. |
    50	   | `MACOS_CERT_PASSWORD` | Non-empty password for the PKCS#12 payload. Secret. |
    51	   | `MACOS_KEYCHAIN_PASSWORD` | Temporary CI keychain password. Secret. |
    52	   | `ASC_KEY_ID` | App Store Connect API key ID. Secret metadata. |
    53	   | `ASC_ISSUER_ID` | App Store Connect issuer ID. Secret metadata. |
    54	   | `ASC_KEY_P8_B64` | Base64-encoded App Store Connect API private key. Secret. |
    55	
    56	   Add these non-secret values as Protected variables:
    57	
    58	   | Variable | Required value |
    59	   | --- | --- |
    60	   | `RELUX_GITLAB_HOST` | Exact confirmed hostname, without a scheme. |
    61	   | `RELUX_GITLAB_PROJECT_PATH` | Exact case-sensitive namespace/project path. |
    62	   | `RELUX_GITLAB_PROJECT_ID` | Exact positive numeric project ID shown by the confirmed project. |
    63	   | `RELUX_ACCEPTED_RELEASE_SHA` | Full lowercase 40-character SHA accepted by review for v0.2.0. |
    64	
    65	   The pipeline and preflight both require `RELUX_GITLAB_PROJECT_ID` to equal
    66	   GitLab's `CI_PROJECT_ID` exactly. A missing, malformed, or mismatched value
    67	   stops the job before any package, Release, or download URL is constructed.
    68	
    69	GitLab documents that protected variables are limited to protected refs and
    70	that sensitive values should be masked and hidden. Masking is only a log
    71	defense, so the release runner and every pipeline change still require review:
    72	<https://docs.gitlab.com/ci/variables/>.
    73	
    74	GitLab's supported macOS runner setup uses a user-mode `LaunchAgent`; code
    75	signing requires that user session and keychain access:
    76	<https://docs.gitlab.com/runner/install/osx/>.
    77	
    78	## Audited pipeline
    79	
    80	`.gitlab-ci.yml` has three gates:
    81	
    82	1. `validate` runs shell lint, Swift tests, a Swift build, and an ad-hoc-signed
    83	   universal development bundle without production credentials.
    84	2. `release_v0_2_0` runs only for the protected `v0.2.0` tag on the trusted
    85	   `macos` + `relux-release` runner. It compares GitLab's actual host, project
    86	   path, checked-out commit, and runner tags with the protected expected
    87	   values. It imports the certificate into a disposable keychain; builds both
    88	   `arm64` and `x86_64`; signs with the exact Relux Works Developer ID; submits
    89	   the DMG with `notarytool`; requires `Accepted`; saves the notarization log;
    90	   staples and validates the ticket; runs Gatekeeper; and produces checksums.
    91	3. `verify_v0_2_0` first requires the Release metadata to name exactly the
    92	   expected same-project Generic Package Registry links, then downloads all
    93	   three assets through the job-token-supported Releases API endpoint
    94	   `CI_API_V4_URL/projects/$CI_PROJECT_ID/releases/$CI_COMMIT_TAG/downloads/<asset>`.
    95	   Browser-style `/-/releases/` permanent links remain end-user URLs and are
    96	   not used as authenticated CI API targets. Redirects are followed manually
    97	   with a fixed hop limit: `JOB-TOKEN` is attached only when the next request
    98	   has the exact confirmed GitLab origin, while an external HTTPS object-storage
    99	   URL is fetched without that header. Unsafe, malformed, missing, excessive,
   100	   or unexpected redirects fail closed. The job verifies that the Release points
   101	   to the accepted commit, compares the published checksum file with the
   102	   CI-produced file, checks both hashes, and proves the stable and versioned
   103	   DMGs are byte-identical.
   104	
   105	Production jobs are serialized through the
   106	`relux-production-release` resource group. The certificate and API key are
   107	decoded only under a `mktemp` directory; the temporary keychain and decoded
   108	files are removed by an exit trap.
   109	
   110	The package upload uses the automatically scoped `CI_JOB_TOKEN`, following the
   111	GitLab Generic Package Registry contract:
   112	<https://docs.gitlab.com/user/packages/generic_packages/>.
   113	Uploads do not follow redirects and require the registry's exact `201` response,
   114	so the custom token cannot be forwarded to another origin.
   115	The GitLab Release exposes the package objects as direct asset links:
   116	<https://docs.gitlab.com/api/releases/links/>.
   117	
   118	## Source mirror and tag
   119	
   120	Only after the target table is explicit and authorization has been verified:
   121	
   122	```bash
   123	git remote add relux-gitlab "git@<CONFIRMED_HOST>:<CONFIRMED_NAMESPACE>/relux-proxy.git"
   124	git ls-remote relux-gitlab
   125	git push --dry-run relux-gitlab "<ACCEPTED_SHA>:refs/heads/main"
   126	git push relux-gitlab "<ACCEPTED_SHA>:refs/heads/main"
   127	git tag -s v0.2.0 "<ACCEPTED_SHA>" -m "Relux Proxy v0.2.0"
   128	git push relux-gitlab v0.2.0
   129	```
   130	
   131	Stop if the remote default branch has unrelated history, the dry run names a
   132	different project, the target values disagree, or the protected runner and
   133	variables are absent. Do not force-push around such a mismatch.
   134	
   135	The protected tag pipeline publishes exactly:
   136	
   137	- `ReluxProxy-v0.2.0-universal.dmg`
   138	- `ReluxProxy.dmg`
   139	- `SHA256SUMS`
   140	
   141	The locally configured checkout remains the source of the accepted commit; no
   142	uncommitted working-tree content can enter a tag pipeline.
   143	
   144	## Post-release evidence
   145	
   146	Keep the successful release and verification job artifacts for audit. They
   147	include the source SHA, architectures, signing authority and team ID,
   148	notarization response and log, Gatekeeper result, and published downloads.
   149	
   150	Verify the direct links in the confirmed project:
   151	
   152	```text
   153	https://<CONFIRMED_HOST>/<CONFIRMED_NAMESPACE>/relux-proxy/-/releases/v0.2.0/downloads/ReluxProxy-v0.2.0-universal.dmg
   154	https://<CONFIRMED_HOST>/<CONFIRMED_NAMESPACE>/relux-proxy/-/releases/v0.2.0/downloads/ReluxProxy.dmg
   155	https://<CONFIRMED_HOST>/<CONFIRMED_NAMESPACE>/relux-proxy/-/releases/v0.2.0/downloads/SHA256SUMS
   156	```
   157	
   158	An unsigned, ad-hoc-signed, unstapled, Gatekeeper-rejected, wrong-host, or
   159	wrong-commit artifact is a failed candidate and must never be described as the
   160	production release.
     1	# Relux Proxy v0.2.0
     2	
     3	Relux Proxy v0.2.0 adds saved, independently controlled SSH SOCKS profiles to
     4	the native macOS menu-bar app.
     5	
     6	## Highlights
     7	
     8	- Save multiple profiles with stable identity and a unique local port.
     9	- Connect multiple profiles at once as concurrent local SOCKS endpoints on
    10	  `127.0.0.1`.
    11	- Use an IP address, DNS hostname, or SSH config alias without Relux Proxy
    12	  parsing or rewriting `~/.ssh/config`.
    13	- Leave Account empty to preserve the `User` selected by OpenSSH for a matching
    14	  SSH config alias, or set Account to pass an explicit `-l` user override.
    15	- Start, stop, diagnose, edit, and remove profiles independently. A failed or
    16	  occupied port affects only that profile.
    17	- Migrate the previous single-tunnel preferences once while retaining the old
    18	  keys for rollback compatibility.
    19	
    20	Relux Proxy continues to launch the system `/usr/bin/ssh` client. Each endpoint
    21	is an application SOCKS5 proxy for TCP traffic, not a system VPN. SOCKS-aware
    22	clients should enable SOCKS5h or proxy DNS when the remote SSH host must resolve
    23	private names.
    24	
    25	## Assets
    26	
    27	- `ReluxProxy-v0.2.0-universal.dmg` — versioned Apple silicon and Intel build.
    28	- `ReluxProxy.dmg` — stable-name copy of the same notarized DMG.
    29	- `SHA256SUMS` — SHA-256 hashes for both DMG names.
    30	
    31	The production GitLab pipeline publishes these assets only after verifying the
    32	accepted source commit, Relux GitLab project identity, Developer ID signature,
    33	universal architectures, Apple notarization ticket, stapling, Gatekeeper
    34	assessment, and checksums.
     1	# Platform and distribution specification
     2	
     3	## Project shape
     4	
     5	The current SwiftPM executable is insufficient for embedded Network Extension
     6	targets and iOS distribution. The target project is a generated Xcode workspace,
     7	using the Relux Works Tuist convention unless the project migration task records
     8	a better supported choice.
     9	
    10	Planned targets:
    11	
    12	- `ReluxProxyMac` containing app;
    13	- `ReluxProxyMacTunnel` packet tunnel extension;
    14	- `ReluxProxyIOS` containing app;
    15	- `ReluxProxyIOSTunnel` packet tunnel extension;
    16	- `ReluxTunnelCore` Swift package shared by both providers;
    17	- `ReluxTunnelHarness` macOS CLI for fast packet/SSH/relay experiments;
    18	- `relux-relay` portable remote executable and protocol test target.
    19	
    20	The existing menu bar SOCKS app remains buildable until an explicit migration
    21	task replaces it. Migration MUST preserve or deliberately retire its profile
    22	defaults and release history.
    23	
    24	## Apple capabilities
    25	
    26	Both containing apps manage custom VPN configurations through
    27	`NETunnelProviderManager`. Host and extension App IDs require the Network
    28	Extension packet-tunnel entitlement and matching provisioning profiles. App
    29	Groups and Keychain Sharing provide the minimum app/extension state boundary.
    30	
    31	**Gate P0:** confirm Relux Works organization enrollment, bundle IDs, Network
    32	Extension capability/profiles, and device installation before packet-plane work
    33	is considered viable.
    34	
    35	The app must be primarily a networking product and accurately disclose its
    36	extension and VPN behavior. Apple App Review Guideline 5.4 requires VPN apps to
    37	be offered by an organization and imposes privacy and regional-law obligations.
    38	
    39	## Minimum platform policy
    40	
    41	Exact deployment targets are selected during project migration from current
    42	API/support evidence. The baseline MUST support:
    43	
    44	- a current iOS release on a physical iPhone used for memory/lifecycle gates;
    45	- a current macOS release on Apple silicon;
    46	- the oldest iOS/macOS versions for which all selected Network Extension,
    47	  Network.framework, Swift concurrency, signing, and dependency requirements can
    48	  be tested in CI.
    49	
    50	No deployment target is lowered by adding private API or fragile compatibility
    51	shims.
    52	
    53	## Signing and release channels
    54	
    55	### macOS
    56	
    57	Developer ID distribution uses hardened runtime, nested signing in inside-out
    58	order, notarization, stapling, Gatekeeper validation, checksums, and provenance
    59	attestation. The packet tunnel extension and containing app need compatible
    60	entitlements/profiles. A stable `ReluxProxy.dmg` release asset may continue, but
    61	on a private repository it requires authenticated GitHub access.
    62	
    63	### iOS
    64	
    65	iOS uses Apple Development for device spikes and Apple Distribution through
    66	TestFlight/App Store. Developer ID and notarization do not apply to iOS.
    67	TestFlight is required for lifecycle, entitlement, and review-preparation
    68	iterations before App Store submission.
    69	
    70	### macOS self-update
    71	
    72	The macOS app ships an in-app self-update channel so security fixes reach users
    73	without a manual re-download (ADR-018). Constraints:
    74	
    75	- Sparkle 2.x with an EdDSA (ed25519) signed appcast; the public key is pinned in
    76	  `Info.plist` (`SUPublicEDKey`), the private key is a CI secret held in the same
    77	  custody as the Developer ID / notarization credentials.
    78	- Every update payload is an already-notarized Developer ID build, so hardened
    79	  runtime, Gatekeeper, and stapling guarantees are preserved end to end. The
    80	  updater embeds without introducing notarization-breaking entitlements.
    81	- The appcast and update assets are published from the same authenticated GitHub
    82	  release channel as the notarized DMG; a missing or invalid signature fails
    83	  closed, downgrades are refused outside an explicit rollback channel, and a
    84	  payload whose team identifier does not match is rejected.
    85	- iOS is out of scope for self-update: the App Store owns iOS updates.
    86	- Key custody, rotation, appcast withdrawal, emergency stop, and rollback are
    87	  documented in the self-update runbook and referenced by the threat model
    88	  (supply-chain adversary, §4.E).
    89	
    90	## CI/CD contract
    91	
    92	Pull requests run documentation/board validation plus builds and tests available
    93	without production credentials. Release workflows use GitHub Environments and
    94	least-privilege secrets; no certificate, private key, issuer credential, or
    95	provisioning secret is committed.
    96	
    97	Required pipelines:
    98	
    99	1. shared-core unit and protocol conformance tests on macOS;
   100	2. macOS host/extension build, entitlement inspection, signing verification,
   101	   notarization, DMG publication, checksums, and stable-name asset;
   102	3. iOS host/extension archive, entitlement/provisioning inspection, and
   103	   TestFlight upload;
   104	4. reproducible relay cross-build matrix, tests, checksums, manifest generation,
   105	   and bundling into Apple targets;
   106	5. dependency license/SBOM and secret scanning;
   107	6. semantic version/tag validation and release notes.
   108	
   109	Production release jobs are serialized. Build artifacts retain exact source
   110	commit, dependency lockfiles, relay manifest, protocol version, bundle versions,
   111	and signing identity metadata.
   112	
   113	## App Review package
   114	
   115	The submission package includes:
   116	
   117	- an accurate VPN data-flow explanation and test SSH host instructions;
   118	- in-app VPN data disclosure and public privacy policy;
   119	- Network Extension entitlement purpose;
   120	- regional licensing notes or excluded storefronts;
   121	- explanation that users provide their own SSH exit host;
   122	- degraded-mode behavior and system-excluded traffic disclosure;
   123	- review account/profile or reproducible setup that does not expose private
   124	  production credentials.
     1	# Architecture decision log
     2	
     3	| ID | Status | Decision |
     4	| --- | --- | --- |
     5	| ADR-001 | Accepted | Build a system VPN around `NEPacketTunnelProvider`; keep the live SSH transport inside the extension |
     6	| ADR-002 | Accepted | Use HEV/lwIP instead of writing a TCP/IP stack |
     7	| ADR-003 | Accepted | Bridge `NEPacketTunnelFlow` through a public nonblocking `AF_UNIX/SOCK_DGRAM` socket pair; do not discover the utun FD |
     8	| ADR-004 | Accepted | Fix HEV's internal UDP mode to UDP-in-TCP and reuse its datagram address framing |
     9	| ADR-005 | Accepted | Use SSH `direct-tcpip` for TCP and a rootless exec/stdio relay for UDP |
    10	| ADR-006 | Accepted | Upload the relay through exec stdin; do not add SFTP to `SSHTransport` |
    11	| ADR-007 | Accepted | Support full and degraded TCP + safe-DNS modes instead of failing solely because UDP relay is unavailable |
    12	| ADR-008 | Accepted | Use 2–4 SSH lanes, pin live flows, and assign only new flows using congestion-aware policy |
    13	| ADR-009 | Accepted | Treat channel windows, lane count, HEV limits, and reconnect overlap as one memory budget |
    14	| ADR-010 | Accepted | Expose configurable QUIC behavior; default `Auto` may force a fast TCP fallback |
    15	| ADR-011 | Accepted | Develop packet/SSH/relay core through an SPM macOS harness while proving packetFlow, lifecycle, and memory on physical iPhone |
    16	| ADR-012 | Accepted | Make compatible and platform-scoped fail-closed route modes explicit user choices |
    17	| ADR-013 | Gate | Obtain evidence that local TCP termination + remote `direct-tcpip` is acceptable under Apple's packet-tunnel intended-use guidance |
    18	| ADR-014 | Open | Select a minimal SwiftNIO SSH fork or libssh2 only after per-channel windows, rekey, compatibility, memory, and lifecycle tests |
    19	| ADR-015 | Open | Select the production MTU from physical-device tests of 1500, 4096, and 8500 |
    20	| ADR-016 | Open | Confirm exact deployment targets during the multi-target project migration |
    21	| ADR-017 | Open | Confirm whether Tuist remains the best project generator for the combined Swift/C/relay build |
    22	| ADR-018 | Accepted | Ship macOS in-app self-update via Sparkle 2.x with an EdDSA-signed appcast; every payload is an already-notarized Developer ID build; iOS updates stay with the App Store |
    23	
    24	## Decision rationale
    25	
    26	The accepted decisions preserve the product invariant that device-to-exit
    27	payload transport is SSH while avoiding TCP-over-TCP for application TCP. They
    28	also keep the iOS extension memory budget and public-API boundary ahead of code
    29	reuse convenience.
    30	
    31	Open items are deliberately concentrated in M0. No implementation task may
    32	silently resolve them through a local workaround; the evidence and selected
    33	tradeoff must update this log.
