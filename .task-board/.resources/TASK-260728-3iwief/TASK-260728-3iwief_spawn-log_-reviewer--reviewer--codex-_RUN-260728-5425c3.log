+
+prepare_identical
+run_case wrong-project-metadata 1 "does not target the confirmed project package" \
+    "CI_JOB_TOKEN=synthetic-verify-token" \
+    "VERIFY_SCENARIO=wrong-metadata"
+
+prepare_identical
+run_case changed-published-checksum 1 "published SHA256SUMS differs" \
+    "CI_JOB_TOKEN=synthetic-verify-token" \
+    "VERIFY_SCENARIO=changed-checksum"
+
+prepare_identical
+run_case corrupt-published-download 1 "FAILED" \
+    "CI_JOB_TOKEN=synthetic-verify-token" \
+    "VERIFY_SCENARIO=corrupt-download"
+
+prepare_divergent
+run_case divergent-published-aliases 1 "published stable-name DMG differs" \
+    "CI_JOB_TOKEN=synthetic-verify-token" \
+    "VERIFY_SCENARIO=positive"
