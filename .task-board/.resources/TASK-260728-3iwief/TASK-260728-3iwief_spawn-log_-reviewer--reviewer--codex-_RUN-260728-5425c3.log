        "CI_COMMIT_SHA": commit,
        "CI_COMMIT_TAG": "v0.2.0",
        "CI_JOB_TOKEN": Self.syntheticToken,
        "CI_PROJECT_ID": "42",
        "CI_SERVER_URL": gitLabOrigin,
        "CURL_CA_BUNDLE": certificate.path,
        "NO_PROXY": "127.0.0.1,localhost",
        "RELUX_GITLAB_PROJECT_ID": "42",
        "no_proxy": "127.0.0.1,localhost",
