   202	      "CI_COMMIT_TAG": "v0.2.0",
   203	      "CI_COMMIT_SHA": commit,
   204	      "CI_COMMIT_REF_PROTECTED": "true",
   205	      "CI_PIPELINE_SOURCE": "push",
   206	      "CI_RUNNER_TAGS": #"["macos", "relux-release"]"#,
   207	      "RELUX_GITLAB_HOST": expectedHost,
   208	      "RELUX_GITLAB_PROJECT_PATH": projectPath,
   209	      "RELUX_ACCEPTED_RELEASE_SHA": acceptedCommit ?? commit,
   210	    ]
   211	    if let expectedProjectID {
   212	      environment["RELUX_GITLAB_PROJECT_ID"] = expectedProjectID
   213	    }
   214	
   215	    return try run(
   216	      executable: "/bin/bash",
   217	      arguments: ["scripts/gitlab-release-preflight.sh"],
   218	      environment: environment
   219	    )
   220	  }
   221	
   222	  private func currentCommit() throws -> String {
   223	    let result = try run(
   224	      executable: "/usr/bin/git",
   225	      arguments: ["rev-parse", "HEAD"]
   226	    )
   227	    #expect(result.status == 0, "git output: \(result.output)")
   228	    return result.output.trimmingCharacters(in: .whitespacesAndNewlines)
   229	  }
   230	
   231	  private func expectInOrder(_ markers: [String], in contents: String) {
   232	    var searchStart = contents.startIndex
   233	    for marker in markers {
   234	      let remaining = searchStart..<contents.endIndex
   235	      let match = contents.range(of: marker, range: remaining)
   236	      #expect(match != nil, "missing or out-of-order marker: \(marker)")
   237	      guard let match else {
   238	        return
   239	      }
   240	      searchStart = match.upperBound
   241	    }
   242	  }
   243	
   244	  private func run(
   245	    executable: String,
   246	    arguments: [String],
   247	    environment: [String: String] = [:]
   248	  ) throws -> CommandResult {
   249	    let process = Process()
   250	    let output = Pipe()
   251	
   252	    process.executableURL = URL(fileURLWithPath: executable)
   253	    process.arguments = arguments
   254	    process.currentDirectoryURL = repositoryRoot
   255	    process.standardOutput = output
   256	    process.standardError = output
   257	    process.environment = ProcessInfo.processInfo.environment.merging(environment) {
   258	      _, replacement in replacement
   259	    }
   260	
   261	    try process.run()
   262	    process.waitUntilExit()
   263	
   264	    let data = output.fileHandleForReading.readDataToEndOfFile()
   265	    return CommandResult(
   266	      status: process.terminationStatus,
   267	      output: String(decoding: data, as: UTF8.self)
   268	    )
   269	  }
   270	
   271	  private func repositoryContents(at relativePath: String) throws -> String {
   272	    try String(
   273	      contentsOf: repositoryRoot.appendingPathComponent(relativePath),
   274	      encoding: .utf8
   275	    )
   276	  }
   277	
   278	  private var repositoryRoot: URL {
   279	    URL(fileURLWithPath: #filePath)
   280	      .deletingLastPathComponent()
   281	      .deletingLastPathComponent()
   282	      .deletingLastPathComponent()
   283	  }
   284	}
