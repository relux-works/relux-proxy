   272	
   273	[[ -n "${CI_JOB_TOKEN:-}" ]] ||
   274	    fail "CI_JOB_TOKEN is required to verify the published GitLab Release"
   275	for command in cmp curl mktemp mv plutil shasum; do
   276	    command -v "$command" >/dev/null 2>&1 ||
   277	        fail "$command is required to verify the GitLab Release"
   278	done
