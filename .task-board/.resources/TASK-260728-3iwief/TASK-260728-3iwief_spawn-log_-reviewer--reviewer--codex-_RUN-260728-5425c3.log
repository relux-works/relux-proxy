+#!/bin/bash
+set -euo pipefail
+
+scenario="${UPLOAD_SCENARIO:-positive}"
+expected_base="https://gitlab.relux.example/api/v4/projects/42/packages/generic/relux-proxy/v0.2.0/"
+header=""
+upload_file=""
+url=""
+proto=""
+max_redirs=""
+
+while [[ "$#" -gt 0 ]]; do
+    case "$1" in
+        --disable | --silent | --show-error)
+            shift
+            ;;
+        --proto)
+            proto="$2"
+            shift 2
+            ;;
+        --max-redirs)
+            max_redirs="$2"
+            shift 2
+            ;;
+        --output | --write-out)
+            shift 2
+            ;;
+        --header)
+            header="$2"
+            shift 2
+            ;;
+        --upload-file)
+            upload_file="$2"
+            shift 2
+            ;;
+        https://*)
+            url="$1"
+            shift
+            ;;
+        *)
+            printf 'fake curl rejected argument: %s\n' "$1" >&2
+            exit 90
+            ;;
+    esac
+done
+
+[[ "$proto" == "=https" ]] || exit 91
+[[ "$max_redirs" == "0" ]] || exit 92
+[[ "$header" == "JOB-TOKEN: synthetic-upload-token" ]] || exit 93
+[[ -s "$upload_file" ]] || exit 94
+[[ "$url" == "$expected_base${upload_file##*/}" ]] || exit 95
+
+case "$scenario" in
+    positive)
+        printf '201'
+        ;;
+    redirect)
+        printf '302'
+        ;;
+    *)
+        exit 96
+        ;;
+esac
