    57	done
     1	#!/bin/bash
     2	set -euo pipefail
     3	
     4	ROOT="$(cd "$(dirname "$0")/.." && pwd)"
     5	DIST="$ROOT/dist"
     6	VERIFY_DIR="$DIST/published-verification"
     7	PACKAGE_NAME="relux-proxy"
     8	MAX_REDIRECTS=5
     9	REQUEST_TEMP=""
    10	
    11	fail() {
    12	    echo "error: $*" >&2
    13	    exit 1
    14	}
    15	
    16	cleanup() {
    17	    if [[ -n "$REQUEST_TEMP" && -d "$REQUEST_TEMP" ]]; then
    18	        rm -rf "$REQUEST_TEMP"
    19	    fi
    20	}
    21	trap cleanup EXIT
    22	
    23	url_origin() {
    24	    local url="$1"
    25	    local remainder
    26	    local authority
    27	
    28	    case "$url" in
    29	        https://*) ;;
    30	        *) return 1 ;;
    31	    esac
    32	    if [[ "$url" =~ [[:space:][:cntrl:]] ]] ||
    33	        [[ "$url" == *\\* || "$url" == *"#"* ]]; then
    34	        return 1
    35	    fi
    36	
    37	    remainder="${url#https://}"
    38	    authority="${remainder%%[/?#]*}"
    39	    [[ -n "$authority" && "$authority" != *"@"* ]] || return 1
    40	    printf 'https://%s' "$authority"
    41	}
    42	
    43	is_gitlab_origin() {
    44	    local origin
    45	
    46	    origin="$(url_origin "$1")" || return 1
    47	    [[ "$origin" == "$CI_SERVER_URL" ]]
    48	}
    49	
    50	trim_http_value() {
    51	    local value="$1"
    52	
    53	    while [[ "$value" == " "* || "$value" == $'\t'* ]]; do
    54	        value="${value#?}"
    55	    done
    56	    while [[ "$value" == *" " || "$value" == *$'\t' ]]; do
    57	        value="${value%?}"
    58	    done
    59	    printf '%s' "$value"
    60	}
    61	
    62	extract_redirect_location() {
    63	    local headers="$1"
    64	    local line
    65	    local header_name
    66	    local value
    67	    local location=""
    68	    local count=0
    69	
    70	    while IFS= read -r line || [[ -n "$line" ]]; do
    71	        line="${line%$'\r'}"
    72	        [[ "$line" == *":"* ]] || continue
    73	        header_name="${line%%:*}"
    74	        header_name="$(printf '%s' "$header_name" | tr '[:upper:]' '[:lower:]')"
    75	        if [[ "$header_name" == "location" ]]; then
    76	            value="$(trim_http_value "${line#*:}")"
    77	            location="$value"
    78	            count=$((count + 1))
    79	        fi
    80	    done <"$headers"
    81	
    82	    [[ "$count" -eq 1 && -n "$location" ]] ||
    83	        fail "redirect response must contain exactly one non-empty Location header"
    84	    if [[ "$location" =~ [[:space:][:cntrl:]] ]] ||
    85	        [[ "$location" == *\\* || "$location" == *"#"* ]]; then
    86	        fail "redirect Location is malformed"
    87	    fi
    88	    printf '%s' "$location"
    89	}
    90	
    91	resolve_redirect() {
    92	    local current_url="$1"
    93	    local location="$2"
    94	    local origin
    95	
    96	    case "$location" in
    97	        https://*)
    98	            url_origin "$location" >/dev/null ||
    99	                fail "redirect Location is not a valid HTTPS URL"
   100	            printf '%s' "$location"
   101	            ;;
   102	        *://*)
   103	            fail "redirect URL must use HTTPS"
   104	            ;;
   105	        //*)
   106	            fail "scheme-relative redirect Locations are not allowed"
   107	            ;;
   108	        /*)
   109	            origin="$(url_origin "$current_url")" ||
   110	                fail "cannot resolve redirect from a malformed current URL"
   111	            printf '%s%s' "$origin" "$location"
   112	            ;;
   113	        *)
   114	            fail "redirect Location must be an absolute HTTPS URL or absolute path"
   115	            ;;
   116	    esac
   117	}
   118	
   119	http_get() {
   120	    local url="$1"
   121	    local headers="$2"
   122	    local body="$3"
   123	    local status
   124	    local curl_arguments=(
   125	        --disable
   126	        --silent
   127	        --show-error
   128	        --proto '=https'
   129	        --max-redirs 0
   130	        --dump-header "$headers"
   131	        --output "$body"
   132	        --write-out '%{http_code}'
   133	    )
   134	
   135	    if is_gitlab_origin "$url"; then
   136	        curl_arguments+=(--header "JOB-TOKEN: $CI_JOB_TOKEN")
   137	    fi
   138	
   139	    if ! status="$(curl "${curl_arguments[@]}" "$url")"; then
   140	        fail "HTTPS request failed"
   141	    fi
   142	    printf '%s' "$status"
   143	}
   144	
   145	fetch_release_metadata() {
   146	    local url="$1"
   147	    local destination="$2"
   148	    local headers="$REQUEST_TEMP/release.headers"
   149	    local body="$REQUEST_TEMP/release.body"
   150	    local status
   151	
   152	    is_gitlab_origin "$url" ||
   153	        fail "the Release API URL is not on the confirmed GitLab origin"
   154	    status="$(http_get "$url" "$headers" "$body")"
   155	    [[ "$status" == "200" ]] ||
   156	        fail "the GitLab Release API returned unexpected HTTP status '$status'"
   157	    mv "$body" "$destination"
   158	    rm -f "$headers"
   159	}
   160	
   161	fetch_release_asset() {
   162	    local initial_url="$1"
   163	    local destination="$2"
   164	    local current_url="$initial_url"
   165	    local destination_name="${destination##*/}"
   166	    local redirect_count=0
   167	    local headers
   168	    local body
   169	    local status
   170	    local location
   171	    local next_url
   172	
   173	    is_gitlab_origin "$initial_url" ||
   174	        fail "the initial release asset URL is not on the confirmed GitLab origin"
   175	
   176	    while true; do
   177	        headers="$REQUEST_TEMP/$destination_name.headers"
   178	        body="$REQUEST_TEMP/$destination_name.body"
   179	        rm -f "$headers" "$body"
   180	        status="$(http_get "$current_url" "$headers" "$body")"
   181	
   182	        case "$status" in
   183	            200)
   184	                mv "$body" "$destination"
   185	                rm -f "$headers"
   186	                return 0
   187	                ;;
   188	            301 | 302 | 303 | 307 | 308)
   189	                location="$(extract_redirect_location "$headers")"
   190	                next_url="$(resolve_redirect "$current_url" "$location")"
   191	                redirect_count=$((redirect_count + 1))
   192	                [[ "$redirect_count" -le "$MAX_REDIRECTS" ]] ||
   193	                    fail "release asset download exceeded $MAX_REDIRECTS redirects"
   194	                current_url="$next_url"
   195	                ;;
   196	            *)
   197	                fail "release asset download returned unexpected HTTP status '$status'"
   198	                ;;
   199	        esac
   200	    done
   201	}
   202	
   203	read_release_string() {
   204	    local key_path="$1"
   205	    local release_file="$2"
   206	    local value
   207	
   208	    if ! value="$(
   209	        plutil -extract "$key_path" raw -expect string -o - "$release_file"
   210	    )"; then
   211	        fail "the GitLab Release response is missing string '$key_path'"
   212	    fi
   213	    printf '%s' "$value"
   214	}
   215	
   216	validate_release_assets() {
   217	    local release_file="$1"
   218	    local link_count
   219	    local index
   220	    local name
   221	    local direct_path
   222	    local package_url
   223	    local link_type
   224	    local expected_url
   225	    local expected=0
   226	    local expected_asset
   227	    local seen_assets="|"
   228	
   229	    if ! link_count="$(
   230	        plutil -extract assets.links raw -expect array -o - "$release_file"
   231	    )"; then
   232	        fail "the GitLab Release response is missing the asset links array"
   233	    fi
   234	    [[ "$link_count" == "${#ASSETS[@]}" ]] ||
   235	        fail "the GitLab Release must contain exactly ${#ASSETS[@]} asset links"
   236	
   237	    index=0
   238	    while [[ "$index" -lt "$link_count" ]]; do
   239	        name="$(read_release_string "assets.links.$index.name" "$release_file")"
   240	        direct_path="$(
   241	            read_release_string "assets.links.$index.direct_asset_path" "$release_file"
   242	        )"
   243	        package_url="$(read_release_string "assets.links.$index.url" "$release_file")"
   244	        link_type="$(read_release_string "assets.links.$index.link_type" "$release_file")"
   245	
   246	        expected=0
   247	        for expected_asset in "${ASSETS[@]}"; do
   248	            if [[ "$name" == "$expected_asset" ]]; then
   249	                expected=1
   250	                break
   251	            fi
   252	        done
   253	        [[ "$expected" -eq 1 ]] ||
   254	            fail "the GitLab Release contains unexpected asset '$name'"
   255	        [[ "$seen_assets" != *"|$name|"* ]] ||
   256	            fail "the GitLab Release contains duplicate asset '$name'"
   257	        seen_assets="$seen_assets$name|"
   258	
   259	        [[ "$direct_path" == "/$name" ]] ||
   260	            fail "published release asset '$name' has an unexpected direct path"
   261	        expected_url="$CI_API_V4_URL/projects/$CI_PROJECT_ID/packages/generic/$PACKAGE_NAME/$CI_COMMIT_TAG/$name"
   262	        [[ "$package_url" == "$expected_url" ]] ||
   263	            fail "published release asset '$name' does not target the confirmed project package"
   264	        [[ "$link_type" == "package" ]] ||
   265	            fail "published release asset '$name' does not use package link type"
   266	
   267	        index=$((index + 1))
   268	    done
   269	}
