@@ -0,0 +1,122 @@
+#!/bin/bash
+set -euo pipefail
+
+REVIEW_ROOT="$(cd "$(dirname "$0")" && pwd)"
+SNAPSHOT_ROOT="$REVIEW_ROOT/current-snapshot"
+VERIFY="$SNAPSHOT_ROOT/scripts/verify-gitlab-release.sh"
+DIST="$SNAPSHOT_ROOT/dist"
+COMMIT="$(git -C "$SNAPSHOT_ROOT" rev-parse HEAD)"
+VERSIONED="ReluxProxy-v0.2.0-universal.dmg"
+STABLE="ReluxProxy.dmg"
+VERIFY_BIN="$REVIEW_ROOT/verify-fake-bin"
+
+mkdir -p "$VERIFY_BIN" "$REVIEW_ROOT/tmp"
+cp "$REVIEW_ROOT/fake-bin/verify-curl" "$VERIFY_BIN/curl"
+chmod 0755 "$VERIFY_BIN/curl"
+
+BASE_ENV=(
+    "PATH=$VERIFY_BIN:$PATH"
+    "TMPDIR=$REVIEW_ROOT/tmp"
+    "CI_SERVER_HOST=gitlab.relux.example"
+    "CI_SERVER_URL=https://gitlab.relux.example"
+    "CI_PROJECT_PATH=relux/relux-proxy"
+    "CI_PROJECT_ID=42"
+    "CI_PROJECT_URL=https://gitlab.relux.example/relux/relux-proxy"
+    "CI_API_V4_URL=https://gitlab.relux.example/api/v4"
+    "CI_COMMIT_TAG=v0.2.0"
+    "CI_COMMIT_SHA=$COMMIT"
+    "CI_COMMIT_REF_PROTECTED=true"
+    "CI_PIPELINE_SOURCE=push"
+    "CI_RUNNER_TAGS=[\"macos\", \"relux-release\"]"
+    "RELUX_GITLAB_HOST=gitlab.relux.example"
+    "RELUX_GITLAB_PROJECT_PATH=relux/relux-proxy"
+    "RELUX_GITLAB_PROJECT_ID=42"
+    "RELUX_ACCEPTED_RELEASE_SHA=$COMMIT"
+    "VERIFY_FIXTURE_DIST=$DIST"
+    "VERIFY_COMMIT=$COMMIT"
+)
+
+prepare_identical() {
+    mkdir -p "$DIST"
+    printf 'synthetic notarized DMG bytes\n' >"$DIST/$VERSIONED"
+    cp "$DIST/$VERSIONED" "$DIST/$STABLE"
+    (
+        cd "$DIST"
+        shasum -a 256 "$VERSIONED" "$STABLE" >SHA256SUMS
+    )
+}
+
+prepare_divergent() {
+    mkdir -p "$DIST"
+    printf 'versioned bytes\n' >"$DIST/$VERSIONED"
+    printf 'stable bytes\n' >"$DIST/$STABLE"
+    (
+        cd "$DIST"
+        shasum -a 256 "$VERSIONED" "$STABLE" >SHA256SUMS
+    )
+}
+
+run_case() {
+    local label="$1"
+    local expected_status="$2"
+    local expected_text="$3"
+    shift 3
+
+    local output
+    local status
+    set +e
+    output="$(
+        env -i "${BASE_ENV[@]}" "$@" /bin/bash "$VERIFY" 2>&1
+    )"
+    status=$?
+    set -e
+
+    if [[ "$status" -ne "$expected_status" || "$output" != *"$expected_text"* ]]; then
+        printf 'FAIL case=%s status=%s expected=%s missing=%s output=%s\n' \
+            "$label" "$status" "$expected_status" "$expected_text" "$output" >&2
+        exit 1
+    fi
+    printf 'PASS case=%s status=%s\n' "$label" "$status"
+}
+
+prepare_identical
+run_case positive 0 "Verified the GitLab Release" \
+    "CI_JOB_TOKEN=synthetic-verify-token" \
+    "VERIFY_SCENARIO=positive"
+
+prepare_identical
+run_case missing-token 1 "CI_JOB_TOKEN is required" \
+    "CI_JOB_TOKEN=" \
+    "VERIFY_SCENARIO=positive"
+
+prepare_identical
+run_case wrong-release-tag 1 "published release tag is 'v0.2.1'" \
+    "CI_JOB_TOKEN=synthetic-verify-token" \
+    "VERIFY_SCENARIO=wrong-tag"
+
+prepare_identical
+run_case wrong-release-commit 1 "not the accepted commit" \
+    "CI_JOB_TOKEN=synthetic-verify-token" \
+    "VERIFY_SCENARIO=wrong-commit"
+
+prepare_identical
+run_case wrong-project-metadata 1 "does not target the confirmed project package" \
+    "CI_JOB_TOKEN=synthetic-verify-token" \
+    "VERIFY_SCENARIO=wrong-metadata"
+
+prepare_identical
+run_case changed-published-checksum 1 "published SHA256SUMS differs" \
+    "CI_JOB_TOKEN=synthetic-verify-token" \
+    "VERIFY_SCENARIO=changed-checksum"
+
+prepare_identical
+run_case corrupt-published-download 1 "FAILED" \
+    "CI_JOB_TOKEN=synthetic-verify-token" \
+    "VERIFY_SCENARIO=corrupt-download"
+
+prepare_divergent
+run_case divergent-published-aliases 1 "published stable-name DMG differs" \
+    "CI_JOB_TOKEN=synthetic-verify-token" \
+    "VERIFY_SCENARIO=positive"
+
+printf 'verify_matrix=pass positive=1 negatives=7\n'

