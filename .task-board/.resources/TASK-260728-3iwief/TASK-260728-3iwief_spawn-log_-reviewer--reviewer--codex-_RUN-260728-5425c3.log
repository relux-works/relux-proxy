index 0000000000000000000000000000000000000000..7595b9bd84eeb4cea6729338cc9827673dd64ab7
--- /dev/null
+++ b/.temp/TASK-260728-3iwief-review/fake-bin/verify-curl
@@ -0,0 +1,101 @@
+#!/bin/bash
+set -euo pipefail
+
+scenario="${VERIFY_SCENARIO:-positive}"
+fixture_dist="${VERIFY_FIXTURE_DIST:?}"
+commit="${VERIFY_COMMIT:?}"
+api_base="https://gitlab.relux.example/api/v4/projects/42"
+release_url="$api_base/releases/v0.2.0"
+download_base="$release_url/downloads/"
+package_base="$api_base/packages/generic/relux-proxy/v0.2.0"
+header=""
+headers_file=""
+body_file=""
+url=""
+proto=""
+max_redirs=""
+
+while [[ "$#" -gt 0 ]]; do
+    case "$1" in
+        --disable | --silent | --show-error)
+            shift
+            ;;
+        --proto)
+            proto="$2"
+            shift 2
+            ;;
+        --max-redirs)
+            max_redirs="$2"
+            shift 2
+            ;;
+        --dump-header)
+            headers_file="$2"
+            shift 2
+            ;;
+        --output)
+            body_file="$2"
+            shift 2
+            ;;
+        --write-out)
+            shift 2
+            ;;
+        --header)
+            header="$2"
+            shift 2
+            ;;
+        https://*)
+            url="$1"
+            shift
+            ;;
+        *)
+            printf 'fake verify curl rejected argument: %s\n' "$1" >&2
+            exit 90
+            ;;
+    esac
+done
+
+[[ "$proto" == "=https" ]] || exit 91
+[[ "$max_redirs" == "0" ]] || exit 92
+[[ "$header" == "JOB-TOKEN: synthetic-verify-token" ]] || exit 93
+[[ -n "$headers_file" && -n "$body_file" ]] || exit 94
+
+printf 'HTTP/1.1 200 OK\r\nContent-Length: 0\r\n\r\n' >"$headers_file"
+
+if [[ "$url" == "$release_url" ]]; then
+    tag="v0.2.0"
+    published_commit="$commit"
+    first_package_url="$package_base/ReluxProxy-v0.2.0-universal.dmg"
+    case "$scenario" in
+        wrong-tag)
+            tag="v0.2.1"
+            ;;
+        wrong-commit)
+            published_commit="0000000000000000000000000000000000000000"
+            ;;
+        wrong-metadata)
+            first_package_url="https://gitlab.relux.example/api/v4/projects/43/packages/generic/relux-proxy/v0.2.0/ReluxProxy-v0.2.0-universal.dmg"
+            ;;
+    esac
+    printf \
+        '{"tag_name":"%s","commit":{"id":"%s"},"assets":{"links":[{"name":"ReluxProxy-v0.2.0-universal.dmg","url":"%s","direct_asset_path":"/ReluxProxy-v0.2.0-universal.dmg","link_type":"package"},{"name":"ReluxProxy.dmg","url":"%s/ReluxProxy.dmg","direct_asset_path":"/ReluxProxy.dmg","link_type":"package"},{"name":"SHA256SUMS","url":"%s/SHA256SUMS","direct_asset_path":"/SHA256SUMS","link_type":"package"}]}}' \
+        "$tag" "$published_commit" "$first_package_url" "$package_base" "$package_base" \
+        >"$body_file"
+    printf '200'
+    exit 0
+fi
+
+[[ "$url" == "$download_base"* ]] || exit 95
+asset="${url#"$download_base"}"
+case "$asset" in
+    ReluxProxy-v0.2.0-universal.dmg | ReluxProxy.dmg | SHA256SUMS) ;;
+    *) exit 96 ;;
+esac
+
+if [[ "$scenario" == "changed-checksum" && "$asset" == "SHA256SUMS" ]]; then
+    printf 'changed published checksum file\n' >"$body_file"
+elif [[ "$scenario" == "corrupt-download" && "$asset" == "ReluxProxy.dmg" ]]; then
+    printf 'corrupted published bytes\n' >"$body_file"
+else
+    cp "$fixture_dist/$asset" "$body_file"
+fi
+printf '200'
