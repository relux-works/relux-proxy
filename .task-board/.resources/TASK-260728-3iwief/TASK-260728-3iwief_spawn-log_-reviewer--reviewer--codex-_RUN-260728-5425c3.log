   332	                        "commit": {"id": commit},
   333	                        "assets": {"links": links},
   334	                    }
   335	                ).encode("utf-8")
   336	                self.send_bytes(200, body, "application/json")
   337	                return
   338	
   339	            if path.startswith(download_prefix):
   340	                asset = path[len(download_prefix):]
   341	                if asset not in assets:
   342	                    self.send_bytes(404, b"unknown asset\n", "text/plain")
   343	                    return
   344	                if asset == assets[0]:
   345	                    if scenario == "unsafe-http":
