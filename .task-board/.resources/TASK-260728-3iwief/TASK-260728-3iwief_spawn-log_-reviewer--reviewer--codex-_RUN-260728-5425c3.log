+max_redirs=""
+
+while [[ "$#" -gt 0 ]]; do
+    case "$1" in
+        --disable | --silent | --show-error)
+            shift
+            ;;
+        --proto)
+            proto="$2"
+            shift 2
+            ;;
+        --max-redirs)
+            max_redirs="$2"
+            shift 2
+            ;;
+        --output | --write-out)
+            shift 2
+            ;;
+        --header)
+            header="$2"
+            shift 2
+            ;;
+        --upload-file)
+            upload_file="$2"
+            shift 2
+            ;;
+        https://*)
+            url="$1"
+            shift
+            ;;
+        *)
+            printf 'fake curl rejected argument: %s\n' "$1" >&2
+            exit 90
+            ;;
+    esac
+done
+
+[[ "$proto" == "=https" ]] || exit 91
+[[ "$max_redirs" == "0" ]] || exit 92
+[[ "$header" == "JOB-TOKEN: synthetic-upload-token" ]] || exit 93
