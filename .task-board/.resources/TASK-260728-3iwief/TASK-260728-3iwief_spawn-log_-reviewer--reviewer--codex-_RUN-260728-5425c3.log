+        --proto)
+            proto="$2"
+            shift 2
+            ;;
+        --max-redirs)
+            max_redirs="$2"
+            shift 2
+            ;;
+        --dump-header)
+            headers_file="$2"
+            shift 2
+            ;;
+        --output)
+            body_file="$2"
+            shift 2
+            ;;
+        --write-out)
+            shift 2
+            ;;
+        --header)
+            header="$2"
+            shift 2
+            ;;
+        https://*)
+            url="$1"
+            shift
+            ;;
+        *)
