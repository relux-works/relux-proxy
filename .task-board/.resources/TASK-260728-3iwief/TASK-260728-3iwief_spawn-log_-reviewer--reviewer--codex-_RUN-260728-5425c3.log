+[[ -s "$upload_file" ]] || exit 94
+[[ "$url" == "$expected_base${upload_file##*/}" ]] || exit 95
+
+case "$scenario" in
+    positive)
+        printf '201'
+        ;;
+    redirect)
+        printf '302'
+        ;;
+    *)
+        exit 96
+        ;;
+esac
diff --git a/.temp/TASK-260728-3iwief-review/fake-bin/verify-curl b/.temp/TASK-260728-3iwief-review/fake-bin/verify-curl
