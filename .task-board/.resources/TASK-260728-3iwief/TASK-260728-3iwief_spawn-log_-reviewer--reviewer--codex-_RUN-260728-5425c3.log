@@ -0,0 +1,96 @@
+#!/bin/bash
+set -euo pipefail
+
+SNAPSHOT_ROOT="$(cd "$(dirname "$0")/current-snapshot" && pwd)"
+PREFLIGHT="$SNAPSHOT_ROOT/scripts/gitlab-release-preflight.sh"
+COMMIT="$(git -C "$SNAPSHOT_ROOT" rev-parse HEAD)"
+
+BASE_ENV=(
+    "CI_SERVER_HOST=gitlab.relux.example"
+    "CI_SERVER_URL=https://gitlab.relux.example"
+    "CI_PROJECT_PATH=relux/relux-proxy"
+    "CI_PROJECT_ID=42"
+    "CI_PROJECT_URL=https://gitlab.relux.example/relux/relux-proxy"
+    "CI_API_V4_URL=https://gitlab.relux.example/api/v4"
+    "CI_COMMIT_TAG=v0.2.0"
+    "CI_COMMIT_SHA=$COMMIT"
+    "CI_COMMIT_REF_PROTECTED=true"
+    "CI_PIPELINE_SOURCE=push"
+    "CI_RUNNER_TAGS=[\"macos\", \"relux-release\"]"
+    "RELUX_GITLAB_HOST=gitlab.relux.example"
+    "RELUX_GITLAB_PROJECT_PATH=relux/relux-proxy"
+    "RELUX_GITLAB_PROJECT_ID=42"
+    "RELUX_ACCEPTED_RELEASE_SHA=$COMMIT"
+)
+
+run_case() {
+    local label="$1"
+    local expected_status="$2"
+    local expected_text="$3"
+    shift 3
+
+    local output
+    local status
+    set +e
+    output="$(
+        env -i "PATH=$PATH" "${BASE_ENV[@]}" "$@" /bin/bash "$PREFLIGHT" 2>&1
+    )"
+    status=$?
+    set -e
+
+    if [[ "$status" -ne "$expected_status" || "$output" != *"$expected_text"* ]]; then
+        printf 'FAIL case=%s status=%s expected=%s output=%s\n' \
+            "$label" "$status" "$expected_status" "$output" >&2
+        exit 1
+    fi
+    printf 'PASS case=%s status=%s\n' "$label" "$status"
+}
+
+run_case positive 0 "Verified release target"
+run_case excluded-host 1 "explicitly excluded" \
+    "CI_SERVER_HOST=gitlab.wildberries.ru" \
+    "CI_SERVER_URL=https://gitlab.wildberries.ru" \
+    "CI_PROJECT_URL=https://gitlab.wildberries.ru/relux/relux-proxy" \
+    "CI_API_V4_URL=https://gitlab.wildberries.ru/api/v4" \
+    "RELUX_GITLAB_HOST=gitlab.wildberries.ru"
+run_case wrong-host 1 "confirmed Relux GitLab hostname" \
+    "RELUX_GITLAB_HOST=other.relux.example"
+run_case wrong-project-path 1 "confirmed Relux namespace/project" \
+    "RELUX_GITLAB_PROJECT_PATH=relux/other"
+run_case malformed-project-id 1 "CI_PROJECT_ID must be" \
+    "CI_PROJECT_ID=abc"
+run_case missing-confirmed-project-id 1 "RELUX_GITLAB_PROJECT_ID" \
+    "RELUX_GITLAB_PROJECT_ID="
+run_case malformed-confirmed-project-id 1 "confirmed positive numeric project ID" \
+    "RELUX_GITLAB_PROJECT_ID=abc"
+run_case mismatched-project-id 1 "does not match the confirmed Relux GitLab project ID" \
+    "RELUX_GITLAB_PROJECT_ID=43"
+run_case non-https-server 1 "requires HTTPS" \
+    "CI_SERVER_URL=http://gitlab.relux.example"
+run_case wrong-project-url 1 "does not identify the confirmed Relux project" \
+    "CI_PROJECT_URL=https://gitlab.relux.example/relux/other"
+run_case wrong-api-origin 1 "not hosted by the confirmed Relux GitLab instance" \
+    "CI_API_V4_URL=https://other.relux.example/api/v4"
+run_case wrong-tag 1 "only publishes v0.2.0" \
+    "CI_COMMIT_TAG=v0.2.1"
+run_case unprotected-tag 1 "must be configured as a protected tag" \
+    "CI_COMMIT_REF_PROTECTED=false"
+run_case non-push-pipeline 1 "pushed protected tag" \
+    "CI_PIPELINE_SOURCE=web"
+run_case malformed-commit-sha 1 "full 40-character commit SHA" \
+    "CI_COMMIT_SHA=abc"
+run_case missing-accepted-sha 1 "RELUX_ACCEPTED_RELEASE_SHA" \
+    "RELUX_ACCEPTED_RELEASE_SHA="
+run_case malformed-accepted-sha 1 "reviewed full commit SHA" \
+    "RELUX_ACCEPTED_RELEASE_SHA=ABC"
+run_case mismatched-accepted-sha 1 "accepted release commit" \
+    "RELUX_ACCEPTED_RELEASE_SHA=0000000000000000000000000000000000000000"
+run_case checkout-mismatch 1 "checked-out source does not match" \
+    "CI_COMMIT_SHA=0000000000000000000000000000000000000000" \
+    "RELUX_ACCEPTED_RELEASE_SHA=0000000000000000000000000000000000000000"
+run_case missing-macos-runner-tag 1 "missing the required 'macos' tag" \
+    "CI_RUNNER_TAGS=[\"relux-release\"]"
+run_case missing-release-runner-tag 1 "missing the required 'relux-release' tag" \
+    "CI_RUNNER_TAGS=[\"macos\"]"
+
+printf 'preflight_matrix=pass positive=1 negatives=20\n'
diff --git a/.temp/TASK-260728-3iwief-review/run-release-guards.sh b/.temp/TASK-260728-3iwief-review/run-release-guards.sh
new file mode 100644
index 0000000000000000000000000000000000000000..bc3a2459fbd2c14e8a4d68a77b25da21c25de417
--- /dev/null
+++ b/.temp/TASK-260728-3iwief-review/run-release-guards.sh
@@ -0,0 +1,80 @@
+#!/bin/bash
+set -euo pipefail
+
+REVIEW_ROOT="$(cd "$(dirname "$0")" && pwd)"
+SNAPSHOT_ROOT="$REVIEW_ROOT/current-snapshot"
+BUILD_APP="$SNAPSHOT_ROOT/scripts/build-app.sh"
+RELEASE="$SNAPSHOT_ROOT/scripts/release-macos.sh"
+COMMIT="$(git -C "$SNAPSHOT_ROOT" rev-parse HEAD)"
+
+chmod 0755 "$REVIEW_ROOT/fake-security-bin/security"
+
+PREFLIGHT_ENV=(
+    "PATH=$PATH"
+    "TMPDIR=$REVIEW_ROOT/tmp"
+    "CI_SERVER_HOST=gitlab.relux.example"
+    "CI_SERVER_URL=https://gitlab.relux.example"
+    "CI_PROJECT_PATH=relux/relux-proxy"
+    "CI_PROJECT_ID=42"
+    "CI_PROJECT_URL=https://gitlab.relux.example/relux/relux-proxy"
+    "CI_API_V4_URL=https://gitlab.relux.example/api/v4"
+    "CI_COMMIT_TAG=v0.2.0"
+    "CI_COMMIT_SHA=$COMMIT"
+    "CI_COMMIT_REF_PROTECTED=true"
+    "CI_PIPELINE_SOURCE=push"
+    "CI_RUNNER_TAGS=[\"macos\", \"relux-release\"]"
+    "RELUX_GITLAB_HOST=gitlab.relux.example"
+    "RELUX_GITLAB_PROJECT_PATH=relux/relux-proxy"
+    "RELUX_GITLAB_PROJECT_ID=42"
+    "RELUX_ACCEPTED_RELEASE_SHA=$COMMIT"
+)
+
+run_failure() {
+    local label="$1"
+    local expected_text="$2"
+    shift 2
+
+    local output
+    local status
+    set +e
+    output="$("$@" 2>&1)"
+    status=$?
+    set -e
+
+    if [[ "$status" -ne 1 || "$output" != *"$expected_text"* ]]; then
+        printf 'FAIL case=%s status=%s missing=%s output=%s\n' \
+            "$label" "$status" "$expected_text" "$output" >&2
+        exit 1
+    fi
+    printf 'PASS case=%s status=%s\n' "$label" "$status"
+}
+
+run_failure invalid-signing-mode "REQUIRE_DEVELOPER_ID must be 0 or 1" \
+    env -i "PATH=$PATH" "REQUIRE_DEVELOPER_ID=2" /bin/bash "$BUILD_APP"
+
+run_failure production-adhoc "ad-hoc signature is forbidden" \
+    env -i "PATH=$PATH" "SIGN_IDENTITY=-" "REQUIRE_DEVELOPER_ID=1" \
+    /bin/bash "$BUILD_APP"
+
+run_failure missing-required-identity "required signing identity" \
+    env -i "PATH=$REVIEW_ROOT/fake-security-bin:$PATH" \
+    "SIGN_IDENTITY=Developer ID Application: Relux Works, LLC (262RZ595FP)" \
+    "REQUIRE_DEVELOPER_ID=1" "UNIVERSAL=0" \
+    /bin/bash "$BUILD_APP"
+
+run_failure missing-release-variable "CI_PIPELINE_IID" \
+    env -i "${PREFLIGHT_ENV[@]}" /bin/bash "$RELEASE"
+
+run_failure wrong-developer-id "not the Relux Works release identity" \
+    env -i "${PREFLIGHT_ENV[@]}" \
+    "CI_PIPELINE_IID=1" \
+    "MACOS_CERT_P12_B64=synthetic" \
+    "MACOS_CERT_PASSWORD=synthetic" \
+    "MACOS_KEYCHAIN_PASSWORD=synthetic" \
+    "ASC_KEY_ID=synthetic" \
+    "ASC_ISSUER_ID=synthetic" \
+    "ASC_KEY_P8_B64=synthetic" \
+    "DEVELOPER_ID_APPLICATION=Developer ID Application: Other (0000000000)" \
+    /bin/bash "$RELEASE"
+
+printf 'release_guard_matrix=pass negatives=5\n'
diff --git a/.temp/TASK-260728-3iwief-review/run-upload-matrix.sh b/.temp/TASK-260728-3iwief-review/run-upload-matrix.sh
new file mode 100644
index 0000000000000000000000000000000000000000..cc34939ae96ca108e615b46d1af14d3a0924d63b
--- /dev/null
+++ b/.temp/TASK-260728-3iwief-review/run-upload-matrix.sh
@@ -0,0 +1,113 @@
+#!/bin/bash
+set -euo pipefail
+
+REVIEW_ROOT="$(cd "$(dirname "$0")" && pwd)"
+SNAPSHOT_ROOT="$REVIEW_ROOT/current-snapshot"
+UPLOAD="$SNAPSHOT_ROOT/scripts/upload-gitlab-release-assets.sh"
+DIST="$SNAPSHOT_ROOT/dist"
+COMMIT="$(git -C "$SNAPSHOT_ROOT" rev-parse HEAD)"
+VERSIONED="ReluxProxy-v0.2.0-universal.dmg"
+STABLE="ReluxProxy.dmg"
+
+chmod 0755 "$REVIEW_ROOT/fake-bin/curl"
+
+BASE_ENV=(
+    "PATH=$REVIEW_ROOT/fake-bin:$PATH"
+    "CI_SERVER_HOST=gitlab.relux.example"
+    "CI_SERVER_URL=https://gitlab.relux.example"
+    "CI_PROJECT_PATH=relux/relux-proxy"
+    "CI_PROJECT_ID=42"
+    "CI_PROJECT_URL=https://gitlab.relux.example/relux/relux-proxy"
+    "CI_API_V4_URL=https://gitlab.relux.example/api/v4"
+    "CI_COMMIT_TAG=v0.2.0"
+    "CI_COMMIT_SHA=$COMMIT"
+    "CI_COMMIT_REF_PROTECTED=true"
+    "CI_PIPELINE_SOURCE=push"
+    "CI_RUNNER_TAGS=[\"macos\", \"relux-release\"]"
+    "RELUX_GITLAB_HOST=gitlab.relux.example"
+    "RELUX_GITLAB_PROJECT_PATH=relux/relux-proxy"
+    "RELUX_GITLAB_PROJECT_ID=42"
+    "RELUX_ACCEPTED_RELEASE_SHA=$COMMIT"
+)
+
+prepare_identical() {
+    mkdir -p "$DIST"
+    printf 'synthetic notarized DMG bytes\n' >"$DIST/$VERSIONED"
+    cp "$DIST/$VERSIONED" "$DIST/$STABLE"
+    (
+        cd "$DIST"
+        shasum -a 256 "$VERSIONED" "$STABLE" >SHA256SUMS
+    )
+}
+
+prepare_divergent() {
+    mkdir -p "$DIST"
+    printf 'versioned bytes\n' >"$DIST/$VERSIONED"
+    printf 'stable bytes\n' >"$DIST/$STABLE"
+    (
+        cd "$DIST"
+        shasum -a 256 "$VERSIONED" "$STABLE" >SHA256SUMS
+    )
+}
+
+run_case() {
+    local label="$1"
+    local expected_status="$2"
+    local expected_text="$3"
+    shift 3
+
+    local output
+    local status
+    set +e
+    output="$(
+        env -i "${BASE_ENV[@]}" "$@" /bin/bash "$UPLOAD" 2>&1
+    )"
+    status=$?
+    set -e
+
+    if [[ "$status" -ne "$expected_status" ]]; then
+        printf 'FAIL case=%s status=%s expected=%s output=%s\n' \
+            "$label" "$status" "$expected_status" "$output" >&2
+        exit 1
+    fi
+    if [[ -n "$expected_text" && "$output" != *"$expected_text"* ]]; then
+        printf 'FAIL case=%s missing=%s output=%s\n' \
+            "$label" "$expected_text" "$output" >&2
+        exit 1
+    fi
+    printf 'PASS case=%s status=%s\n' "$label" "$status"
+}
+
+prepare_identical
+run_case positive 0 "Uploaded SHA256SUMS" \
+    "CI_JOB_TOKEN=synthetic-upload-token" \
+    "UPLOAD_SCENARIO=positive"
+
+prepare_identical
+run_case missing-token 1 "CI_JOB_TOKEN is required" \
+    "CI_JOB_TOKEN=" \
+    "UPLOAD_SCENARIO=positive"
+
+prepare_identical
+rm "$DIST/$STABLE"
+run_case missing-asset 1 "release asset 'ReluxProxy.dmg' is missing or empty" \
+    "CI_JOB_TOKEN=synthetic-upload-token" \
+    "UPLOAD_SCENARIO=positive"
+
+prepare_identical
+printf 'corrupted bytes\n' >"$DIST/$STABLE"
+run_case bad-checksum 1 "FAILED" \
+    "CI_JOB_TOKEN=synthetic-upload-token" \
+    "UPLOAD_SCENARIO=positive"
+
+prepare_divergent
+run_case divergent-aliases 1 "stable and versioned DMGs differ" \
+    "CI_JOB_TOKEN=synthetic-upload-token" \
+    "UPLOAD_SCENARIO=positive"
+
+prepare_identical
+run_case upload-redirect 1 "unexpected HTTP status '302'" \
+    "CI_JOB_TOKEN=synthetic-upload-token" \
+    "UPLOAD_SCENARIO=redirect"
+
+printf 'upload_matrix=pass positive=1 negatives=5\n'
