+enum ProcessStop: CaseIterable, CustomTestStringConvertible, Sendable {
+  case terminate
+  case forceTerminate
+
+  var testDescription: String {
+    switch self {
+    case .terminate: "terminate"
+    case .forceTerminate: "force terminate"
+    }
+  }
+}
