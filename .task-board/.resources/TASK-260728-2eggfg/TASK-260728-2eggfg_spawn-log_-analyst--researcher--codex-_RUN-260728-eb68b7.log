index 0000000000000000000000000000000000000000..80d62adbb6208c2de9179d11b27564e67a0cc0fd
--- /dev/null
+++ b/.temp/TASK-260728-2eggfg/fixture/socks_udp_probe.py
@@ -0,0 +1,15 @@
+import socket
+
+
+with socket.create_connection(("127.0.0.1", 40181), timeout=5) as sock:
+    sock.sendall(b"\x05\x01\x00")
+    if sock.recv(2) != b"\x05\x00":
+        raise SystemExit("SOCKS5 no-auth negotiation failed")
+
+    # RFC 1928 UDP ASSOCIATE with an all-zero IPv4 address and port.
+    sock.sendall(b"\x05\x03\x00\x01\x00\x00\x00\x00\x00\x00")
+    reply = sock.recv(10)
+    if reply:
+        raise SystemExit(f"unexpected UDP ASSOCIATE reply: {reply.hex()}")
+
+print("expected-red UDP ASSOCIATE: proxy closed without a success reply")
