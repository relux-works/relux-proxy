diff --git a/.temp/TASK-260728-2eggfg/fixture/fixture_server.py b/.temp/TASK-260728-2eggfg/fixture/fixture_server.py
new file mode 100644
index 0000000000000000000000000000000000000000..14b64ac9ca0c82b4fe7a9a961ddc9d2f7ec97dc1
--- /dev/null
+++ b/.temp/TASK-260728-2eggfg/fixture/fixture_server.py
@@ -0,0 +1,23 @@
+from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
+import time
+
+
+class FixtureHandler(BaseHTTPRequestHandler):
+    def do_GET(self):
+        time.sleep(2)
+        body = b"fixture-ok\n"
+        self.send_response(200)
+        self.send_header("Content-Type", "text/plain")
+        self.send_header("Content-Length", str(len(body)))
+        self.end_headers()
+        self.wfile.write(body)
+
+    def log_message(self, format, *args):
+        print(
+            f"peer={self.client_address[0]}:{self.client_address[1]} "
+            + format % args,
+            flush=True,
+        )
+
+
+ThreadingHTTPServer(("127.0.0.1", 40180), FixtureHandler).serve_forever()
