#!/bin/zsh
set -euo pipefail

fixture_dir=/Users/iv/Developer/relux-proxy/.temp/TASK-260728-2eggfg/fixture
http_pid=
sshd_pid=
ssh_pid=

cleanup() {
    if [[ -n "${ssh_pid}" ]]; then
        kill "${ssh_pid}" 2>/dev/null || true
        wait "${ssh_pid}" 2>/dev/null || true
    fi
    if [[ -n "${sshd_pid}" ]]; then
        kill "${sshd_pid}" 2>/dev/null || true
        wait "${sshd_pid}" 2>/dev/null || true
    fi
    if [[ -n "${http_pid}" ]]; then
        kill "${http_pid}" 2>/dev/null || true
        wait "${http_pid}" 2>/dev/null || true
    fi
}
trap cleanup EXIT INT TERM

if [[ ! -f "${fixture_dir}/host_key" ]]; then
    /usr/bin/ssh-keygen -q -t ed25519 -N "" -f "${fixture_dir}/host_key"
fi
if [[ ! -f "${fixture_dir}/client_key" ]]; then
    /usr/bin/ssh-keygen -q -t ed25519 -N "" -f "${fixture_dir}/client_key"
fi
/bin/cp "${fixture_dir}/client_key.pub" "${fixture_dir}/authorized_keys"
/bin/chmod 600 "${fixture_dir}/host_key" "${fixture_dir}/client_key" \
    "${fixture_dir}/authorized_keys"

/usr/bin/python3 "${fixture_dir}/fixture_server.py" \
    >"${fixture_dir}/http-server.log" 2>&1 &
http_pid=$!

/usr/sbin/sshd -D -e -f "${fixture_dir}/sshd_config" \
    >"${fixture_dir}/sshd.log" 2>&1 &
sshd_pid=$!

for attempt in {1..50}; do
    if /usr/bin/nc -z 127.0.0.1 40122 >/dev/null 2>&1; then
        break
    fi
    /bin/sleep 0.1
done
/usr/bin/nc -z 127.0.0.1 40122

/usr/bin/ssh -N -vvv \
    -D 127.0.0.1:40181 \
    -p 40122 \
    -l iv \
    -i "${fixture_dir}/client_key" \
    -o IdentitiesOnly=yes \
    -o BatchMode=yes \
    -o ExitOnForwardFailure=yes \
    -o StrictHostKeyChecking=accept-new \
    -o UserKnownHostsFile="${fixture_dir}/known_hosts" \
    -E "${fixture_dir}/ssh-client.log" \
    127.0.0.1 &
ssh_pid=$!

for attempt in {1..50}; do
    if /usr/bin/nc -z 127.0.0.1 40181 >/dev/null 2>&1; then
        break
    fi
    /bin/sleep 0.1
done
/usr/bin/nc -z 127.0.0.1 40181

/usr/bin/curl --silent --show-error \
    --connect-timeout 5 --max-time 10 \
    --socks5 127.0.0.1:40181 \
    http://127.0.0.1:40180/ip \
    >"${fixture_dir}/curl-ip.out" &
curl_pid=$!

for attempt in {1..30}; do
    if /usr/sbin/lsof -nP -iTCP:40180 -sTCP:ESTABLISHED \
        >"${fixture_dir}/lsof-established.out" 2>/dev/null; then
        break
    fi
    /bin/sleep 0.1
done
wait "${curl_pid}"

/usr/bin/curl --silent --show-error \
    --connect-timeout 5 --max-time 10 \
    --socks5-hostname 127.0.0.1:40181 \
    http://localhost:40180/hostname \
    >"${fixture_dir}/curl-hostname.out"

local_resolution_exit=0
/usr/bin/curl --silent --show-error \
    --connect-timeout 5 --max-time 10 \
    --socks5 127.0.0.1:40181 \
    http://localhost:40180/local-resolution \
    >"${fixture_dir}/curl-local-resolution.out" \
    || local_resolution_exit=$?
if [[ "${local_resolution_exit}" -ne 97 ]]; then
    print -u2 "expected local-resolution curl exit 97, got ${local_resolution_exit}"
    exit 1
fi
print "expected-red local-resolution curl exit: ${local_resolution_exit}"

/usr/bin/python3 "${fixture_dir}/socks_udp_probe.py" \
    >"${fixture_dir}/udp-associate.out"

/usr/bin/ssh-keygen -F "[127.0.0.1]:40122" \
    -f "${fixture_dir}/known_hosts" \
    >"${fixture_dir}/known-host-check.out"

print "fixture exit path: success"
