   429	static struct sshkey *
   430	get_hostkey_by_type(int type, int nid, int need_private, struct ssh *ssh)
   431	{
   432		u_int i;
   433		struct sshkey *key;
   434	
   435		for (i = 0; i < options.num_host_key_files; i++) {
   436			switch (type) {
   437			case KEY_RSA_CERT:
   438			case KEY_ECDSA_CERT:
   439			case KEY_ED25519_CERT:
   440			case KEY_ECDSA_SK_CERT:
   441			case KEY_ED25519_SK_CERT:
   442			case KEY_MLDSA44_ED25519_CERT:
   443				key = sensitive_data.host_certificates[i];
   444				break;
   445			default:
   446				key = sensitive_data.host_keys[i];
   447				if (key == NULL && !need_private)
   448					key = sensitive_data.host_pubkeys[i];
   449				break;
   450			}
   451			if (key == NULL || key->type != type)
   452				continue;
   453			switch (type) {
   454			case KEY_ECDSA:
   455			case KEY_ECDSA_SK:
   456			case KEY_ECDSA_CERT:
   457			case KEY_ECDSA_SK_CERT:
   458				if (key->ecdsa_nid != nid)
   459					continue;
   460				/* FALLTHROUGH */
   461			default:
   462				return need_private ?
   463				    sensitive_data.host_keys[i] : key;
   464			}
   465		}
